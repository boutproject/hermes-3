# Orthogonal slab with native initial profiles and finite-volume wall states.
NXPE = 1
MYG = 0
MXG = 2
periodicX = false
ZMAX = 10 / (2*pi)
restart = false
append = false
dump_on_restart = true

[mesh]
symmetricGlobalX = true
dy = 1
nx = 20
ny = 1
nz = 16
dx = 10 / (nx - 4)
dz = 10 / nz
hthe = 1
Bxy = 1
bxcvx = 0
bxcvy = 0
Rxy = 1.5
bxcvz = 0
# Explicit SI metric pairs avoid assumptions about B normalisation during
# metric recalculation; both formulations normalise these identically.
g11 = 1
g22 = 1/hthe^2
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1/g11
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
J = 1

[mesh:paralleltransform]
type = identity

[mesh:ddz]
first = FFT
fft_filter = 0

[solver]
type = cvode
adams_moulton = true
func_iter = true
nout = 0
output_step = 1
atol = 1e-10
rtol = 1e-7
max_timestep = 1
mxstep = 1e6

[hermes]
components = e, h+, evolve_vorticity_ion_energy, polarisation_drift
recalculate_metric = false
normalise_metric = false
Nnorm = 2e18
Bnorm = 1
Tnorm = 1

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
density_floor = 1e-7
low_p_diffuse_perp = false
low_T_diffuse_perp = false
damp_p_nt = false
p_div_v = false
numerical_viscous_heating = false
hyper_z = -1
evolve_log = false
diagnose = true

[h+]
type = evolve_density
charge = 1
AA = 1
bndry_flux = false
poloidal_flows = false
density_floor = 1e-7
low_n_diffuse = false
low_n_diffuse_perp = false
hyper_z = -1
evolve_log = false
diagnose = true


[Nh+]
function = 1
source = 0
bndry_all = neumann

[Pe]
function = 1
source = 0
bndry_all = neumann

[Vort]
# Vorticity and energy use the same discrete Phi and radial wall traces.
function = frozen:vorticity
bndry_all = neumann

[Eion]
function = 1.5*frozen:pressure + frozen:kinetic
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1
poloidal_flows = false
viscosity = 0
radial_boundary = fixed
diagnose = true
phi_rtol = 1e-12
phi_atol = 1e-3
vort_atol = 1e-12
phi_max_iterations = 200

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[input]
error_on_unused_options = false

[polarisation_drift]
implementation = conservative
diagnose = true
polarisation_corrections = 8

[frozen]
h = 1/(mesh:nx-4)
pressure = 1 + 0.05*cos(pi*x)*sin(z)
ac = 0.01*sin(pi*x)*cos(z)
dc = 0.01*sin(2*pi*x)
f = ac + dc + pressure
fxp = 0.01*sin(pi*(x+h))*cos(z) + 0.01*sin(2*pi*(x+h)) + 1 + 0.05*cos(pi*(x+h))*sin(z)
fxm = 0.01*sin(pi*(x-h))*cos(z) + 0.01*sin(2*pi*(x-h)) + 1 + 0.05*cos(pi*(x-h))*sin(z)
fzp = 0.01*sin(pi*x)*cos(z+2*pi/mesh:nz) + dc + 1 + 0.05*cos(pi*x)*sin(z+2*pi/mesh:nz)
fzm = 0.01*sin(pi*x)*cos(z-2*pi/mesh:nz) + dc + 1 + 0.05*cos(pi*x)*sin(z-2*pi/mesh:nz)
kinetic = ((fxp-f)^2+(f-fxm)^2)/(4*mesh:dx^2) + ((fzp-f)^2+(f-fzm)^2)/(4*mesh:dz^2)
vorticity = -4*sin(pi*h/2)^2*(ac+pressure-1)/mesh:dx^2 - 4*sin(pi/mesh:nz)^2*(ac+pressure-1)/mesh:dz^2 - 4*sin(pi*h)^2*dc/mesh:dx^2
