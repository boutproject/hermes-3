# Orthogonal slab with native initial profiles and finite-volume wall states.
NXPE = 1
MYG = 2
MXG = 2
periodicX = false
ZMAX = 10 / (2*pi)
restart = false
append = false
dump_on_restart = true

[mesh]
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dy = 1
nx = 20
ny = 8
nz = 16
dx = 10 / (nx - 4)
dz = 10 / nz
hthe = 1
Bxy = 1
bxcvx = 0
bxcvy = 0
Rxy = 1.5
bxcvz = 0
# Explicit SI metric pairs avoid assumptions about B normalisation during
# metric recalculation; both formulations normalise these identically.
g11 = 1
g22 = 1/hthe^2
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1/g11
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
J = 1

[mesh:paralleltransform]
type = identity

[mesh:ddz]
first = FFT
fft_filter = 0

[solver]
type = cvode
adams_moulton = true
func_iter = true
nout = 10
output_step = 0.01
atol = 1e-10
rtol = 1e-8
max_timestep = 1
mxstep = 1e6

[hermes]
components = e, d+, he++, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 2e18
Bnorm = 1
Tnorm = 1

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
density_floor = 1e-7
low_p_diffuse_perp = false
low_T_diffuse_perp = false
damp_p_nt = false
p_div_v = false
numerical_viscous_heating = false
hyper_z = -1
evolve_log = false
diagnose = true

[d+]
type = evolve_density, evolve_momentum
charge = 1
AA = 2
use_div_par_fvv = true
bndry_flux = false
poloidal_flows = false
density_floor = 1e-7
low_n_diffuse = false
low_n_diffuse_perp = false
hyper_z = -1
evolve_log = false
diagnose = true


[Nd+]
function = mixture:density_d
source = 0
bndry_all = neumann

[Pe]
function = 1
source = 0
bndry_all = neumann

[Vort]
# Vorticity and energy use the same discrete Phi and radial wall traces.
function = 2*frozen:vorticity
bndry_all = neumann

[Eion]
function = 1.5*frozen:pressure + 2*frozen:kinetic + mixture:parallel_energy
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
viscosity = 0
radial_boundary = fixed
diagnose = true
phi_rtol = 1e-12
phi_atol = 1e-3
vort_atol = 1e-12
phi_max_iterations = 200

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[input]
error_on_unused_options = false

[polarisation_drift]
implementation = conservative
diagnose = true
polarisation_corrections = 8

[frozen]
h = 1/(mesh:nx-4)
pressure = (0.75+0.05*sin(z))*(1+0.05*cos(pi*x)*sin(z))
f = (0.01*sin(pi*x)*cos(z)+0.01*sin(2*pi*x))+((0.75+0.05*sin(z))*(1+0.05*cos(pi*x)*sin(z)))
fxp = (0.01*sin(pi*(x+h))*cos(z)+0.01*sin(2*pi*(x+h)))+((0.75+0.05*sin(z))*(1+0.05*cos(pi*(x+h))*sin(z)))
fxm = (0.01*sin(pi*(x-h))*cos(z)+0.01*sin(2*pi*(x-h)))+((0.75+0.05*sin(z))*(1+0.05*cos(pi*(x-h))*sin(z)))
fzp = (0.01*sin(pi*x)*cos((z+2*pi/mesh:nz))+0.01*sin(2*pi*x))+((0.75+0.05*sin((z+2*pi/mesh:nz)))*(1+0.05*cos(pi*x)*sin((z+2*pi/mesh:nz))))
fzm = (0.01*sin(pi*x)*cos((z-2*pi/mesh:nz))+0.01*sin(2*pi*x))+((0.75+0.05*sin((z-2*pi/mesh:nz)))*(1+0.05*cos(pi*x)*sin((z-2*pi/mesh:nz))))
kinetic = ((fxp-f)^2+(f-fxm)^2)/(4*mesh:dx^2) + ((fzp-f)^2+(f-fzm)^2)/(4*mesh:dz^2)
vorticity = (fxp-2*f+fxm)/mesh:dx^2 + (fzp-2*f+fzm)/mesh:dz^2

[he++]
type = evolve_density, evolve_momentum
charge = 2
AA = 4
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-7
low_n_diffuse = false
low_n_diffuse_perp = false
hyper_z = -1
evolve_log = false
diagnose = true

[Nhe++]
function = mixture:density_he
source = 0
bndry_all = neumann

[NVd+]
function = 2*mixture:density_d*mixture:velocity_d
bndry_all = neumann

[NVhe++]
function = 4*mixture:density_he*mixture:velocity_he
bndry_all = neumann

[Vd+]
bndry_all = neumann

[Vhe++]
bndry_all = neumann

[sound_speed]
electron_dynamics = false
alfven_wave = false

[mixture]
density_d = 0.5 + 0.1*sin(z)
density_he = 0.25 - 0.05*sin(z)
velocity_d = 0.125 + 0.025*cos(z)
velocity_he = -0.25 + 0.05*sin(z)
pressure = (density_d+density_he)*(1+0.05*cos(pi*x)*sin(z))
parallel_energy = density_d*velocity_d^2 + 2*density_he*velocity_he^2
