nout = 50
timestep = 0.1


[mesh]

extrapolate_y = false

[mesh:paralleltransform]
type = fci


[solver]
mxstep = 10000
rtol = 1e-8
atol = 1e-12
mms = true  # Run with MMS sources and output diagnostics
mms_initialise = true
[hermes]
components = h+


Nnorm = 1e18
Bnorm = 1
Tnorm = 5

[h+]  # Ions
type = fixed_density, evolve_momentum, fixed_temperature
charge = 1.0
AA = 1.0


temperature = 5*(0.1*cos(3*y) + 1)/(0.1*sin(2*y) + 1)
density = 1.0e+17*sin(2.0*y) + 1.0e+18

[NVh+]
solution = 0.1*sin(y)

source = -6.85380741086311e-5*sin(3.0*y) + 4.56920494057541e-6*sin(y)*cos(y)/(0.1*sin(2.0*y) + 1) - 4.56920494057541e-7*sin(y)^2*cos(2.0*y)/(0.1*sin(2.0*y) + 1)^2
