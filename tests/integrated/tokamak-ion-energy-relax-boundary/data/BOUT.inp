# Axisymmetric COMPASS grid: closed core, SOL and private flux, two targets.
MZ = 1
NXPE = 1
nout = 20
timestep = 1

[mesh]
file = compass-36x48.grd.nc

[mesh:paralleltransform]
type = shifted

[solver]
atol = 1e-10
rtol = 1e-8
mxstep = 10000

[hermes]
components = e, d+, impurity, evolve_vorticity_ion_energy, sheath_boundary_simple
Nnorm = 2e18
Bnorm = 1
Tnorm = 5

[e]
type = quasineutral, evolve_pressure, zero_current
charge = -1
AA = 1/1836
poloidal_flows = false
bndry_flux = true
thermal_conduction = false
diagnose = false

[Pe]
function = 1 + 0.05 * cos(2*pi*x)
source = 0
bndry_all = neumann

[d+]
type = evolve_density, evolve_momentum
charge = 1
AA = 2
bndry_flux = true
poloidal_flows = false
diagnose = false

[Nd+]
function = 0.6 * Pe:function
source = 0
bndry_all = neumann

[NVd+]
function = 0
bndry_all = neumann

[Vd+]
bndry_all = neumann

[impurity]
type = evolve_density, evolve_momentum
charge = 2
AA = 3
bndry_flux = true
poloidal_flows = false
diagnose = false

[Nimpurity]
function = 0.2 * (1 - 0.03 * cos(2*pi*x))
source = 0
bndry_all = neumann

[NVimpurity]
function = 0
bndry_all = neumann

[Vimpurity]
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1.8
poloidal_flows = false
phi_boundary_relax = true
phi_boundary_timescale = 1e-6
phi_core_averagey = true
phi_rtol = 1e-10
vort_atol = 1e-13
phi_max_iterations = 200
diagnose = false

[Eion]
function = 1.2 * Pe:function

[Vort]
function = 0.001 * sin(2*pi*x)
bndry_all = neumann

[sheath_boundary_simple]
gamma_e = 3.5
gamma_i = 3.5
sheath_ion_polytropic = 1
density_boundary_mode = 1
temperature_boundary_mode = 1
pressure_boundary_mode = 1
diagnose = false
