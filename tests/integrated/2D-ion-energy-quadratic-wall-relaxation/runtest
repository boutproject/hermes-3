#!/usr/bin/env python3
"""Check resolution-independent quadratic wall drift with the time solver."""

import argparse
import json
import os
import subprocess
import tempfile
from pathlib import Path

import numpy as np
import xarray as xr
from boutdata.data import BoutOptionsFile

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
FIXTURE = HERE.parent / "2D-ion-energy-polarisation-boundary/data/BOUT.inp"
RELATIVE_TOLERANCE = 1e-6


def run_case(executable, output, nx, omega, timeout):
    """Run a uniform-vorticity slab and return its wall-rate and drift errors.

    Inputs specify the Hermes executable, output directory, interior X size,
    normalised vorticity and process timeout. The uniform orthogonal slab has
    zero curvature and initially zero midpoint states. Outputs include a case
    directory with dumps/logs and a dictionary of relative analytic errors.
    """
    folder = output / f"nx{nx}-{'positive' if omega > 0 else 'negative'}"
    folder.mkdir()
    options = BoutOptionsFile(str(FIXTURE))
    for key, value in {
        "restart": "false",
        "mesh:nx": nx + 4,
        "mesh:nz": 4,
        "mesh:bxcvz": 0,
        "solver:nout": 4,
        "solver:output_step": 1,
        "solver:atol": 1e-13,
        "Pe:function": "1",
        "Eion:function": "3",
        "Vort:function": str(omega),
        "evolve_vorticity_ion_energy:radial_boundary": "no_slip",
        "evolve_vorticity_ion_energy:phi_boundary_velocity": 1000,
        # A tighter potential tolerance reaches pressure-subtraction roundoff
        # during CVODE probes; the FV residual remains independently constrained.
        "evolve_vorticity_ion_energy:phi_rtol": 1e-10,
        "evolve_vorticity_ion_energy:vort_atol": 1e-15,
    }.items():
        options[key] = value
    options.write(str(folder / "BOUT.inp"), overwrite=True)
    with (folder / "run.log").open("w") as log:
        subprocess.run(
            [str(executable), "-d", str(folder)],
            stdout=log,
            stderr=subprocess.STDOUT,
            env={
                **os.environ,
                "FI_SOCKETS_IFACE": os.environ.get("FI_SOCKETS_IFACE", "en0"),
            },
            timeout=timeout,
            check=True,
        )
    with xr.open_dataset(folder / "BOUT.dmp.0.nc") as dataset:
        ds = dataset.load()
    scalar = lambda name: float(ds[name].values.flat[0])
    kappa = 1000 / (scalar("rho_s0") * scalar("Omega_ci"))
    g11 = scalar("g11")
    coefficient = 1 / scalar("Bxy") ** 2
    expected = (
        -kappa * np.sqrt(g11) * omega * nx * scalar("dx") / (2 * coefficient * g11)
    )
    times = ds.t_array.values
    errors = []
    for interior, guard in ((2, 1), (-3, -2)):
        midpoint = (
            ds.phi.isel(x=interior, drop=True) + ds.phi.isel(x=guard, drop=True)
        ) / 2
        rates = ds.phi_wall_rate.isel(x=guard).values
        drift = (
            np.diff(midpoint.transpose("t", "y", "z").values, axis=0)
            / np.diff(times)[:, None, None]
        )
        np.testing.assert_allclose(rates, expected, rtol=RELATIVE_TOLERANCE, atol=0)
        np.testing.assert_allclose(drift, expected, rtol=RELATIVE_TOLERANCE, atol=0)
        errors.append(
            {
                "rate": float(np.max(abs(rates / expected - 1))),
                "drift": float(np.max(abs(drift / expected - 1))),
            }
        )
    chi_error = float(
        np.max(abs(ds.ion_chi.isel(x=slice(2, -2)).values / expected - 1))
    )
    np.testing.assert_allclose(
        ds.ion_chi.isel(x=slice(2, -2)), expected, rtol=RELATIVE_TOLERANCE, atol=0
    )
    np.testing.assert_allclose(
        ds.Vort.isel(x=slice(2, -2)), omega, rtol=RELATIVE_TOLERANCE, atol=0
    )
    return {
        "nx": nx,
        "omega": omega,
        "maximum_rate_relative_error": max(e["rate"] for e in errors),
        "maximum_drift_relative_error": max(e["drift"] for e in errors),
        "maximum_chi_relative_error": chi_error,
    }


def main():
    """Run both vorticity signs at three resolutions; write a JSON result report."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--exe", type=Path, default=ROOT / "build/hermes-3")
    parser.add_argument("--output-root", type=Path)
    parser.add_argument("--timeout", type=float, default=60)
    args = parser.parse_args()
    if args.output_root is not None:
        args.output_root.mkdir(parents=True, exist_ok=True)
    output = Path(tempfile.mkdtemp(prefix="quadratic-wall-", dir=args.output_root))
    print(f"Results: {output}", flush=True)
    results = []
    for nx in (16, 32, 64):
        for omega in (1e-10, -1e-10):
            result = run_case(args.exe.resolve(), output, nx, omega, args.timeout)
            results.append(result)
            print(result, flush=True)
    (output / "result.json").write_text(
        json.dumps({"passed": True, "cases": results}, indent=2) + "\n"
    )
    print(
        "PASS quadratic wall rates, integrated drift and chi at all resolutions",
        flush=True,
    )


if __name__ == "__main__":
    main()
