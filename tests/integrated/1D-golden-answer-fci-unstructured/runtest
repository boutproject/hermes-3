#!/usr/bin/env python3

# Python script to run and analyse MMS test
#
# Unstructured-mesh counterpart of ../1D-golden-answer-fci: same input
# (generated from ../1D-golden-answer-fci/data/BOUT.inp by
# unstructured_utils.py), same golden values and tolerance. There is no
# perpendicular transport, so every node must reproduce the 1D profile with
# sheath boundaries at both y ends.

import sys
from pathlib import Path

import numpy as np
from boutdata.collect import collect
from boututils.run_wrapper import launch_safe, shell
from numpy import abs

this_dir = Path(__file__).resolve().parent
sys.path.append(str(this_dir.parent))
from unstructured_utils import make_unstructured_input

make_unstructured_input(
    "1D-golden-answer-fci",
    xu="gridvar:R - 1.5",
    zu="6.28318530717959*(gridvar:Z + 0.5)",
    here=this_dir,
)

gridfile = (
    "../../../grids/fci_unstructured/US_slab_with_BC/US_slab_with_BC_256.fci.grid.nc"
)


nout = 10
timestep = 1e4 / nout

nproc = 1


args = f"mesh:file={gridfile} nout={nout} timestep={timestep}"

print("Running with " + args)

# Delete old data
shell("rm data/BOUT.dmp.*.nc")

# Command to run
cmd = "../../../hermes-3 " + args
# Launch using MPI
_, out = launch_safe(cmd, nproc=nproc, pipe=True)


success = True


# Average over the interior nodes (x guard cells are padding)
Pi = np.mean(
    collect("Ph+", tind=[nout, nout], path="data", info=False)[-1][1:-1], axis=(0, 2)
)
Pe = np.mean(
    collect("Pe", tind=[nout, nout], path="data", info=False)[-1][1:-1], axis=(0, 2)
)
Ni = np.mean(
    collect("Nh+", tind=[nout, nout], path="data", info=False)[-1][1:-1], axis=(0, 2)
)

tol = 1e-4

for var, lab in zip([Pe, Pi, Ni], ["Pe", "Pi", "Ni"]):
    if abs(var[0] - var[-1]) > tol:
        print(f"Asymmetry in {lab}!", var[0], var[-1])
        success = False

    print(f"{lab}: ", var[0])


Nival = 0.35237138276962
if abs(Ni[0] - Nival) > tol:
    print("Density mismatch. ", abs(Ni[0] - Nival))
    success = False

Pival = 0.2515733527238645
if abs(Pi[0] - Pival) > tol:
    print("Pi mismatch. ", abs(Pi[0] - Pival))
    success = False

Peval = 0.2795029870898116
if abs(Pe[0] - Peval) > tol:
    print("Pe mismatch. ", abs(Pe[0] - Peval))
    success = False


if success:
    print(" => Test passed")
    sys.exit(0)
else:
    print(" => Test failed")
    sys.exit(1)
