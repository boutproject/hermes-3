#!/usr/bin/env python3
"""Run the skew-metric MMS using the shared continuum generator and analysis."""

import runpy
import sys
from pathlib import Path

shared = Path(__file__).resolve().parents[1] / "3D-ion-energy-mms"
sys.path.insert(0, str(shared))
sys.argv[1:1] = ["--variant", "skew"]
runpy.run_path(str(shared / "runtest"), run_name="__main__")
