# Low-density band at an X wall, prescribed entirely by input expressions.
# zero_current has no electron momentum balance: all fields must be Y invariant
# for this configuration to be a strict closed-energy benchmark.
periodicX = false
NXPE = 1
MYG = 2
nout = 20
timestep = 0.005

[mesh]
nx = 20
ny = 4
nz = 8
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
sinty = 0
Bxy = Bpxy
Btxy = 0
bxcvx = 0
bxcvy = 0
bxcvz = 100 / Rxy^2

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
atol = 1e-12
rtol = 1e-8
mxstep = 10000

[hermes]
components = e, d+, impurity, evolve_vorticity_ion_energy, polarisation_drift
recalculate_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[e]
type = quasineutral, evolve_pressure, zero_current
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
diagnose = true

[Pe]
function = 1 + 0.001 * cos(z)
source = 0
bndry_all = neumann

[d+]
type = evolve_density, evolve_momentum
charge = 1
AA = 2
bndry_flux = false
poloidal_flows = false
diagnose = true

[Nd+]
function = initial:nd
source = 0
bndry_all = neumann

[NVd+]
function = initial:nvd

[Vd+]
bndry_all = neumann

[impurity]
type = evolve_density, evolve_momentum
charge = 2
AA = 3
bndry_flux = false
poloidal_flows = false
diagnose = true

[Nimpurity]
function = initial:nj
source = 0
bndry_all = neumann

[NVimpurity]
function = initial:nvj

[Vimpurity]
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1.75
poloidal_flows = false
viscosity = 0
radial_boundary = fixed
phi_rtol = 1e-12
vort_atol = 1e-13
phi_max_iterations = 200
diagnose = true

[Eion]
# Include the prescribed parallel kinetic energy so the X-Z flows
# start with positive thermal energy everywhere.
function = 1.8 + 0.01 * cos(z)

[Vort]
function = 0.001 * sin(z) * sin(pi*x)^2

[initial]
nd = 0.0005 + 0.5 * x^4
nj = 0.5 * initial:nd
nvd = 0
nvj = 0

[polarisation_drift]
implementation = conservative
