# All-open rectangular Y; prescribed ion velocity transports energy.
periodicX = true
MYG = 2
nout = 40
timestep = 0.05

[mesh]
nx = 12
ny = 16
ixseps1 = 0
ixseps2 = 0
nz = 1
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
sinty = 0
Bxy = Bpxy
Btxy = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
atol = 1e-12
rtol = 1e-9
mxstep = 10000

[hermes]
components = e, d+, evolve_vorticity_ion_energy
recalculate_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
numerical_viscous_heating = false
diagnose = false

[Pe]
function = 1
source = 0
bndry_all = neumann

[d+]
type = evolve_density, fixed_velocity
velocity = 1000
poloidal_flows = false
charge = 1
AA = 2
bndry_flux = false

[Nd+]
function = 1
source = 0
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
phi_rtol = 1e-10
vort_atol = 1e-13
phi_max_iterations = 200
diagnose = false

[Eion]
function = 1.2 * (1 + 0.1 * y/(2*pi))
bndry_all = neumann
