#!/usr/bin/env python3

# Python script to run and analyse MMS test
#
# Unstructured-mesh counterpart of ../1D-electronviscosity-fci: same input (generated from
# ../1D-electronviscosity-fci/data/BOUT.inp by unstructured_utils.py), same thresholds,
# grids from grids/fci_unstructured/create_unstructured_grids.py

import sys
from pathlib import Path

from boutdata.collect import collect
from boututils.run_wrapper import launch_safe, shell
from numpy import abs, array, log, max, mean, sqrt

this_dir = Path(__file__).resolve().parent
sys.path.append(str(this_dir.parent))
from unstructured_utils import make_unstructured_input

# BOUT++ index coordinates x, z of the structured grid (R in [1.5, 2.5],
# Z periodic with period 1) in terms of the unstructured grid geometry
make_unstructured_input(
    "1D-electronviscosity-fci",
    xu="gridvar:R - 1.5",
    zu="6.28318530717959*(gridvar:Z + 0.5)",
    here=this_dir,
)

gridpath = "../../../grids/fci_unstructured/US_slab_y/"


def gridname(ny):
    return gridpath + f"US_slab_y_{ny}.fci.grid.nc"


# List of NY values to use
nylist = [32, 64]

nout = 10
timestep = 50 / nout

nproc = 1

varnames = ["NVe"]

results = {}
for var in varnames:
    results[var] = {"l2": [], "inf": []}

for ny in nylist:
    args = f"mesh:file={gridname(ny)} nout={nout} timestep={timestep}"

    print("Running with " + args)

    # Delete old data
    shell("rm data/BOUT.dmp.*.nc")

    # Command to run
    cmd = "../../../hermes-3 " + args
    # Launch using MPI
    _, out = launch_safe(cmd, nproc=nproc, pipe=True)
    Path(f"run.log.{ny}").write_text(out)

    # Collect data
    for var in varnames:
        E = collect("E_" + var, tind=[nout, nout], path="data", info=False)
        E = E[:, 1:-1, :, :]  # MXG = 1 padding cells

        l2 = sqrt(mean(E**2))
        linf = max(abs(E))
        results[var]["l2"].append(l2)
        results[var]["inf"].append(linf)

        print(f"Error norm {var}: l-2 {l2:f} l-inf {linf:f}")

# Calculate grid spacing
dy = 1.0 / array(nylist)

success = True

for var in varnames:
    l2 = results[var]["l2"]
    order = log(l2[-1] / l2[-2]) / log(dy[-1] / dy[-2])
    print(f"Convergence order {var} = {order:f}")

    if order < 1.8:
        success = False

if success:
    print(" => Test passed")
    sys.exit(0)
else:
    print(" => Test failed")
    sys.exit(1)
