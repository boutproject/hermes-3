solution = -5.51241475426879e-5*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 2.20496590170751e-6*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 2.91829333850097e-7*sin(6.28318530717959*x)*sin(2.0*z + 1.321312) + 8.81986360683006e-6*sin(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 2.20496590170751e-6*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^2
source = -1.13585503441056e-8*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 6.36078819269916e-10*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)^2*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 1.45389444404552e-9*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 + 2.72605208258535e-10*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^4 + 1.09042083303414e-11*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^4/(0.1*sin(6.28318530717959*x) + 1.0)^5 - 6.01325975672676e-11*sin(6.28318530717959*x)*sin(2.0*z + 1.321312) - 5.36123576241786e-9*sin(6.28318530717959*x)^2*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 7.26947222022761e-9*sin(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 1.64857263679067e-7*sin(6.28318530717959*x)*cos(6.28318530717959*x)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 1.8173680550569e-9*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 1.45389444404552e-9*cos(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 7.26947222022761e-11*sin(6.28318530717959*x)^3*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 4.36168333213657e-10*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 + 4.36168333213657e-10*sin(6.28318530717959*x)*cos(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 2.18084166606828e-11*sin(6.28318530717959