"""Run closed curvature/two-ion balances, diagnostics pairs and cadence refinement."""

import argparse
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
from itertools import pairwise
from pathlib import Path

import numpy as np
import xarray as xr
from boutdata.data import BoutOptionsFile

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "tools"))

from energy_analysis import (
    AuditError,
    cadence_comparison,
    electron_curvature_work,
    energy_balance,
    energy_inventory,
    integrated_power,
    open_run,
    polarisation_energy_coefficient,
)
from energy_analysis.report import inventory_report


def require(condition, message):
    if not condition:
        raise AuditError(message)


def write_json(path, value):
    path.write_text(json.dumps(value, indent=2, allow_nan=False) + "\n")


def validate_input(path, case):
    """Establish zero external sources from controlled inputs, not missing dumps."""
    options = BoutOptionsFile(str(path))
    expected = {
        "curvature": {"e": "evolve_density, evolve_pressure", "h+": "quasineutral"},
        "two-ion": {
            "e": "quasineutral, evolve_pressure, zero_current",
            "d+": "evolve_density, evolve_momentum",
            "impurity": "evolve_density, evolve_momentum",
        },
    }[case["name"]]
    components = [c.strip() for c in options["hermes:components"].split(",")]
    require(
        set(components) == {*expected, "evolve_vorticity_ion_energy"},
        "Unaccounted component in source/boundary coverage",
    )
    require(options.get_bool("periodicX"), "Closed cases require periodic X")
    require("file" not in options["mesh"], "Closed fixtures must use analytic geometry")
    for name, types in expected.items():
        require(options[name]["type"] == types, f"Unaccounted physics for {name}")
        for component, prefix in (("evolve_density", "N"), ("evolve_pressure", "P")):
            if component in types.split(", "):
                require(
                    options[prefix + name].evaluate_scalar("source") == 0,
                    f"Expected explicit zero {prefix + name} source",
                )


def histories(budget):
    # The first interval has no predecessor and is represented as null in JSON.
    return {
        **budget.attrs,
        **{
            name: [float(v) if np.isfinite(v) else None for v in budget[name].values]
            for name in budget
        },
    }


def audit(run, manifest, case, diagnose):
    tol = manifest["tolerances"]
    options = run.data.options
    require(options.get_bool("periodicX"), "Saved options must have periodic X")
    meta = run.data.metadata
    require(
        meta["ixseps1"] == meta["nx"]
        and meta["jyseps1_1"] == -1
        and meta["jyseps2_2"] == meta["ny"] - 1,
        "Expected closed periodic Y core topology",
    )
    # Reject unaccounted dissipation/heating even if a fixture was edited.
    for species in run.species:
        section = options[species.name]
        for name in (
            "thermal_conduction",
            "poloidal_flows",
            "low_n_diffuse_perp",
            "low_p_diffuse_perp",
            "low_T_diffuse_perp",
            "damp_p_nt",
            "evolve_log",
        ):
            if name in section:
                require(
                    not section.get_bool(name), f"Unaccounted {species.name}:{name}"
                )
        for name in ("hyper_z", "hyper_z_T"):
            if name in section:
                require(
                    section.evaluate_scalar(name) <= 0,
                    f"Unaccounted {species.name}:{name}",
                )
    for name in ("viscosity", "hyper_z"):
        require(run.scalar_option(name, 0) <= 0, f"Unaccounted model {name}")
    require(
        not options[run.model].get_bool("phi_boundary_relax"),
        "Potential relaxation is outside coverage",
    )
    for name in (
        "Pe",
        "Eion",
        "Tion",
        "phi",
        "Vort",
        *["N" + s.name for s in run.species],
        *["NV" + s.name for s in run.species if "evolve_momentum" in s.components],
    ):
        field = run.data[name]
        require(
            float(abs(field - field.isel(y=run.myg)).max())
            < tol["history_absolute_normalised"],
            f"Y-uniform assumption failed for {name}",
        )
        # Saved periodic radial halos must match the corresponding physical cells.
        for guard, physical in (
            (slice(0, run.mxg), slice(-2 * run.mxg, -run.mxg)),
            (slice(-run.mxg, None), slice(run.mxg, 2 * run.mxg)),
        ):
            require(
                np.allclose(
                    field.isel(x=guard),
                    field.isel(x=physical),
                    rtol=tol["history_relative"],
                    atol=tol["history_absolute_normalised"],
                ),
                f"Periodic radial halo mismatch for {name}",
            )
    report, inventory = inventory_report(run)
    scale = float(abs(inventory.plasma_saved).max())
    work = electron_curvature_work(run)
    power = integrated_power(run, work).compute()
    zero = xr.zeros_like(inventory.t).assign_attrs(
        units="W",
        provenance="prescribed zero sources; validated input component whitelist",
    )
    outward = zero.assign_attrs(
        units="W",
        provenance="analytic closed periodic topology; verified Y uniformity and X halos",
    )
    plasma = energy_balance(inventory, source_power=zero, outward_power=outward)
    electron = energy_balance(
        inventory,
        source_power=power,
        outward_power=outward,
        reservoir="electron_thermal",
    )
    exchange = (
        float(
            abs(inventory.electron_thermal - inventory.electron_thermal.isel(t=0)).max()
        )
        / scale
    )
    eadv = polarisation_energy_coefficient(run)
    metrics = {
        "plasma_max_relative_residual": float(abs(plasma.relative_residual).max()),
        "plasma_max_interval_relative_residual": float(
            abs(plasma.interval_relative_residual).max()
        ),
        "electron_max_residual_over_plasma_energy": float(abs(electron.residual).max())
        / scale,
        "electron_max_interval_residual_over_plasma_energy": float(
            abs(electron.interval_residual).max()
        )
        / scale,
        "exchange_over_plasma_energy": exchange,
        "perpendicular_over_plasma_energy": float(
            abs(inventory.ion_perpendicular).max()
        )
        / scale,
        "parallel_over_plasma_energy": float(abs(inventory.ion_parallel).max()) / scale,
        "E_adv_kinetic_max_normalised": float(
            abs(run.interior(eadv.parallel_kinetic)).max()
        ),
        "composition_range": 0.0,
    }
    ions = [s for s in run.species if s.name != "e"]
    if len(ions) > 1:
        fraction = run.interior(
            run.data["N" + ions[0].name] / sum(run.data["N" + s.name] for s in ions)
        )
        initial = fraction.isel(t=0)
        metrics["composition_range"] = float(initial.max() - initial.min())
        rho = run.interior(sum(s.mass * run.data["N" + s.name] for s in ions)).isel(t=0)
        metrics["initial_mass_density_range_normalised"] = float(rho.max() - rho.min())
    checks = {
        "complete_source_and_boundary_coverage": plasma.attrs["complete"],
        "species_manifest": {s.name for s in run.species} == set(case["species"]),
        "ion_partition": report["partition_max_absolute_error_normalised"]
        < tol["partition_absolute_normalised"],
        "forward_operator": report["forward_max_absolute_error_normalised"]
        < tol["forward_absolute_normalised"],
        "plasma_balance": metrics["plasma_max_relative_residual"]
        < tol["plasma_relative_residual"],
        "plasma_interval_balance": metrics["plasma_max_interval_relative_residual"]
        < tol["plasma_relative_residual"],
        "electron_exchange_balance": metrics["electron_max_residual_over_plasma_energy"]
        < tol["electron_relative_residual"],
        "electron_interval_balance": metrics[
            "electron_max_interval_residual_over_plasma_energy"
        ]
        < tol["electron_relative_residual"],
        "nonzero_exchange": exchange > tol["minimum_exchange_relative"],
        "nonzero_perpendicular_energy": metrics["perpendicular_over_plasma_energy"]
        > tol["minimum_perpendicular_relative"],
        "parallel_energy": metrics["parallel_over_plasma_energy"]
        >= case["minimum_parallel_relative"],
    }
    if len(ions) > 1:
        checks["unequal_mass_to_charge"] = len({s.mass / s.charge for s in ions}) > 1
        checks["varying_composition"] = metrics["composition_range"] > 0.01
        checks["varying_actual_mass_density"] = (
            metrics["initial_mass_density_range_normalised"] > 0.01
        )
        checks["nonzero_E_adv_kinetic"] = metrics["E_adv_kinetic_max_normalised"] > 1e-3
    for name, comparison in report["diagnostics"].items():
        checks["availability_" + name] = comparison["available"] == diagnose
        if diagnose:
            checks["agreement_" + name] = (
                comparison["max_absolute_error_normalised"]
                < tol["diagnostic_absolute_normalised"]
            )
    transfer_diagnostics = {}
    for name in ("electron_exb_work", "phi_Div_Je"):
        checks["availability_" + name] = (name in run.data) == diagnose
        if diagnose:
            diagnostic = run.data[name]
            field_error = float(abs(run.interior(work - diagnostic)).max())
            power_error = float(abs(power - integrated_power(run, diagnostic)).max())
            transfer_diagnostics[name] = {
                "max_field_error_normalised": field_error,
                "max_power_error_W": power_error,
            }
            # phi*Div(Je) agrees after volume integration, not pointwise.
            checks["agreement_" + name] = (
                power_error / (scale * run.frequency)
                < tol["diagnostic_absolute_normalised"]
            )
            if name == "electron_exb_work":
                checks["field_agreement_" + name] = (
                    field_error < tol["diagnostic_absolute_normalised"]
                )
    if diagnose:
        for name in (
            "Pe_src",
            "Eion_src",
            *[
                "S" + s.name + "_src"
                for s in run.species
                if "evolve_density" in s.components
            ],
        ):
            require(name in run.data, f"Missing source cross-check {name}")
            checks["zero_external_" + name] = (
                float(abs(run.interior(run.data[name])).max())
                < tol["diagnostic_absolute_normalised"]
            )
        report["integrated_flux_divergence_max_W"] = {}
        for name in (
            "DivEExB",
            "DivEReynolds",
            "DivEelectric",
            "DivEparallel",
            "DivEpol",
        ):
            require(name in run.data, f"Missing flux cross-check {name}")
            maximum = float(abs(integrated_power(run, run.data[name])).max())
            report["integrated_flux_divergence_max_W"][name] = maximum
            checks["closed_integral_" + name] = (
                maximum / (scale * run.frequency)
                < tol["diagnostic_absolute_normalised"]
            )
    report.update(
        coverage=manifest["coverage"],
        metrics=metrics,
        assertions=checks,
        passed=all(checks.values()),
        balance=histories(plasma),
        electron_balance=histories(electron),
        electron_exchange_power_W=power.values.tolist(),
        transfer_diagnostics=transfer_diagnostics,
    )
    return report, inventory, electron


def execute(executable, folder, fixture, case, cadence, duration, diagnose, timeout):
    folder.mkdir()
    shutil.copyfile(fixture, folder / "BOUT.inp")
    count = round(duration / cadence)
    require(
        np.isclose(count * cadence, duration),
        "Duration must be divisible by each cadence",
    )
    command = [
        str(executable),
        "-d",
        str(folder),
        f"nout={count}",
        f"timestep={cadence}",
        *[
            f"{s}:diagnose={str(diagnose).lower()}"
            for s in case["diagnostic_components"]
        ],
    ]
    execution = {
        "command": command,
        "input_sha256": hashlib.sha256(fixture.read_bytes()).hexdigest(),
    }
    with (folder / "run.log").open("w") as log:
        try:
            process = subprocess.run(
                command,
                stdout=log,
                stderr=subprocess.STDOUT,
                timeout=timeout,
                check=False,
            )
            execution["returncode"] = process.returncode
        except subprocess.TimeoutExpired:
            execution["timeout_s"] = timeout
            write_json(folder / "execution.json", execution)
            raise AuditError(f"Simulation timed out: {folder / 'run.log'}") from None
    write_json(folder / "execution.json", execution)
    require(process.returncode == 0, f"Simulation failed: {folder / 'run.log'}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--exe", type=Path)
    parser.add_argument("--output-root", type=Path)
    parser.add_argument("--timeout", type=int, default=120)
    parser.add_argument("--profile", choices=("smoke", "ci"), default="ci")
    args = parser.parse_args()
    candidates = [ROOT / "hermes-3", ROOT / "build/hermes-3"]
    executable = args.exe or next((p for p in candidates if p.is_file()), None)
    require(executable is not None, "Specify the built Hermes executable with --exe")
    executable = executable.resolve()
    output = Path(tempfile.mkdtemp(prefix="ion-energy-balance-", dir=args.output_root))
    print(f"Results: {output}", flush=True)
    inputs = Path(__file__).parent
    manifest = json.loads((inputs / "balance-cases.json").read_text())
    tol = manifest["tolerances"]
    summary = {
        "profile": args.profile,
        "manifest": manifest,
        "cases": {},
        "passed": False,
    }
    write_json(output / "result.json", summary)
    for case in manifest["cases"]:
        fixture = inputs / ("balance-" + case["name"]) / "BOUT.inp"
        validate_input(fixture, case)
        cadences = manifest["cadences_normalised"]
        if args.profile == "smoke":
            cadences = cadences[-2:]
        runs, budgets, reports, inventories = {}, {}, {}, {}
        for cadence, diagnose in [
            *((c, True) for c in cadences),
            (cadences[-1], False),
        ]:
            label = f"{case['name']}-dt{cadence}-diagnose-{'on' if diagnose else 'off'}"
            folder = output / label
            print(f"Running {label}", flush=True)
            execute(
                executable,
                folder,
                fixture,
                case,
                cadence,
                manifest["duration_normalised"],
                diagnose,
                args.timeout,
            )
            run = open_run(folder)
            # These bounded fixtures fit in memory; reusable operators stay lazy.
            run.data = run.data.load()
            report, inventory, budget = audit(run, manifest, case, diagnose)
            write_json(folder / "energy-report.json", report)
            require(
                report["passed"],
                f"Failed assertions {[k for k, v in report['assertions'].items() if not v]}: {folder / 'energy-report.json'}",
            )
            runs[cadence, diagnose], reports[cadence, diagnose] = run, report
            inventories[cadence, diagnose], budgets[cadence, diagnose] = (
                inventory,
                budget,
            )
        fine = cadences[-1]
        enabled, disabled = runs[fine, True], runs[fine, False]
        for name in (
            "Pe",
            "Eion",
            "Tion",
            "phi",
            "Vort",
            *["N" + s.name for s in enabled.species],
            *[
                "NV" + s.name
                for s in enabled.species
                if "evolve_momentum" in s.components
            ],
        ):
            xr.testing.assert_allclose(
                enabled.data[name],
                disabled.data[name],
                rtol=tol["history_relative"],
                atol=tol["history_absolute_normalised"],
            )
        xr.testing.assert_allclose(
            inventories[fine, True],
            inventories[fine, False],
            rtol=tol["history_relative"],
            atol=1e-14,
        )
        essential = {
            "Eion",
            "Pe",
            "Tion",
            "phi",
            "Vort",
            *["N" + s.name for s in enabled.species],
            *[
                "NV" + s.name
                for s in enabled.species
                if "evolve_momentum" in s.components
            ],
        }
        stripped = enabled.data.drop_vars(
            [
                name
                for name in enabled.data.data_vars
                if "t" in enabled.data[name].dims and name not in essential
            ]
        )
        stripped_run = open_run(stripped)
        xr.testing.assert_allclose(
            energy_inventory(stripped_run), inventories[fine, True]
        )
        xr.testing.assert_allclose(
            integrated_power(stripped_run, electron_curvature_work(stripped_run)),
            integrated_power(enabled, electron_curvature_work(enabled)),
        )
        refinement = [
            cadence_comparison(budgets[c, True], budgets[f, True])
            for c, f in pairwise(cadences)
        ]
        checks = {"diagnostics_independent": True, "optional_fields_stripped": True}
        for c, f, comparison in zip(
            cadences[:-1], cadences[1:], refinement, strict=True
        ):
            coarse, finer = reports[c, True]["metrics"], reports[f, True]["metrics"]
            # Independent runs must match physical histories at shared times.
            stride = comparison["refinement_ratio"]
            xr.testing.assert_allclose(
                inventories[c, True],
                inventories[f, True].isel(t=slice(None, None, stride)),
                rtol=1e-7,
                atol=1e-12,
            )
            checks[f"cadence_convergence_{c}_to_{f}"] = (
                finer["electron_max_residual_over_plasma_energy"]
                < tol["maximum_refinement_error_ratio"]
                * coarse["electron_max_residual_over_plasma_energy"]
            )
        summary["cases"][case["name"]] = {
            "assertions": checks,
            "cadence_refinement": refinement,
            "runs": [
                str(output / f"{case['name']}-dt{c}-diagnose-{'on' if d else 'off'}")
                for c, d in reports
            ],
            "metrics": {
                f"dt{c}-{'on' if d else 'off'}": r["metrics"]
                for (c, d), r in reports.items()
            },
        }
        write_json(output / "result.json", summary)
        require(
            all(checks.values()), f"Cadence comparison failed: {output / 'result.json'}"
        )
    summary["passed"] = True
    write_json(output / "result.json", summary)
    print(
        "Closed energy balances passed (curvature, two ions, diagnostics pairs and cadence refinement)"
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (AuditError, AssertionError) as error:
        print(f"Energy integration test failed: {error}", file=sys.stderr)
        raise SystemExit(1)
