#!/usr/bin/env python3
"""Physical heating, moving-ion particle sources and internal heat exchange."""

import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools"))
from energy_analysis import cadence_comparison, source_balance, summary
from energy_analysis.testing import Study, parser, state_difference

HERE = Path(__file__).resolve().parent


def main():
    args = parser(__doc__).parse_args()
    with Study(HERE, args) as study:
        runs, balances = [], []
        for label, diagnose, outputs in (
            ("diagnostics", True, 80),
            ("plain", False, 80),
            ("coarse", False, 40),
        ):
            run = study.run(
                label,
                [
                    "restart=false",
                    f"solver:nout={outputs}",
                    f"solver:output_step={10 / outputs}",
                    f"evolve_vorticity_ion_energy:diagnose={str(diagnose).lower()}",
                    f"braginskii_heat_exchange:diagnose={str(diagnose).lower()}",
                ],
            )
            runs.append(run)
            balances.append(source_balance(run))
            report = summary(run)
            study.result["cases"][label]["summary"] = report
            if balances[-1].attrs["coverage"] != "complete":
                raise ValueError(balances[-1].attrs["missing_terms"])
            study.check("recovery/" + label, report["recovery_error"], "recovery")
            for name, value in report["source_balance"]["maxima"].items():
                if name.startswith("particles_"):
                    study.check(name + "/" + label, value, "particles")
        sampling = cadence_comparison(balances[-1], balances[1])
        study.result["cadence_comparison"] = sampling
        for label, balance, run in zip(
            ("diagnostics", "plain"), balances[:2], runs[:2]
        ):
            energy = max(float(abs(balance.source_energy).max()), np.finfo(float).tiny)
            error = max(
                0,
                float(abs(balance.residual).max())
                - sampling["estimated_fine_sampling_error_J"],
            )
            study.check("source_balance/" + label, error / energy, "energy", run=run)
        study.check("diagnostics_state", state_difference(*runs[:2]), "diagnostics")


if __name__ == "__main__":
    main()
