# Template; regenerate data/BOUT.inp using .venv/bin/python mms.py.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-10
rtol = 1e-08
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = baseline
c10 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c18 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c23 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c24 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c27 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80
c29 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c31 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c32 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c40 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c48 = 44*pi^2*cos(2*pi*x)/287 - 4*pi^2*cos(4*pi*x)/25
c51 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c59 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c61 = pi*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)
c68 = 220*pi*sin(2*pi*x)/287 - 2*pi*sin(4*pi*x)/5
c70 = -mms:c68*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z) + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c71 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)
c75 = (-2*mms:c71 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c51 + 19/8)
c87 = pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c89 = (-3*mms:c87/400 + pi*sin(2*pi*x)*cos(t/5 - y)/50)/(mms:c24 - mms:c27 + 11/4)^2
c97 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c105 = -pi^2*mms:c97*((-84*pi*sin(pi*x)/5 + 378*pi*sin(3*pi*x)/5 - 42*pi*sin(5*pi*x))*sin(t/5 - z)^2/41 - 256*pi*sin(pi*x)/1435 + 1188*pi*sin(3*pi*x)/1435 - 20*pi*sin(5*pi*x)/41)/50 + pi^3*(mms:c97*((2200*sin(2*pi*x)/287 - 4*sin(4*pi*x))*cos(pi*x) + (-4400*cos(2*pi*x)/287 + 4*cos(4*pi*x) + 3252/287)*sin(pi*x)*cos(t/5 - z)^2 + (13200*cos(2*pi*x)/287 - 36*cos(4*pi*x) - 3252/287)*sin(pi*x)*sin(t/5 - z)^2) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500
c109 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c112 = (-pi*mms:c109 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2
c115 = 168*cos(pi*x) - 252*cos(3*pi*x) + 84*cos(5*pi*x)
c116 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(t/5 - z)
c117 = pi^3*mms:c115*mms:c116/5125 + pi^3*(-mms:c116*((3300*sin(2*pi*x)/287 - 6*sin(4*pi*x))*sin(pi*x) + (8800*cos(2*pi*x)/287 - 14*cos(4*pi*x) - 4878/287)*cos(pi*x)) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500
c123 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c125 = pi*mms:c123*(mms:c10 + 1) + pi*mms:c23*sin(t/5 - y)*cos(2*pi*x)/100
c126 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40 + cos(2*pi*x)*cos(t/5 - y)/5 + 3*cos(t/5 + z)/25 + 11/2
c128 = -3*mms:c87/200 + pi*sin(2*pi*x)*cos(t/5 - y)/25
c133 = pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c137 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c139 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c142 = mms:c137 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c145 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c146 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c148 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c149 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c153 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c155 = (pi*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c24 - mms:c51 + 19/8)
c157 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c160 = (-2*mms:c71 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c51 + 19/8)^2
c161 = mms:c160*(-pi*mms:c157 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c164 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c166 = pi*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c168 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c169 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000
c170 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c178 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c179 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c180 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100
c186 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c188 = 2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c193 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c194 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500
c198 = (-mms:c188*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287) + (-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c24 - mms:c51 + 19/8)
c203 = -pi*mms:c68*mms:c97*sin(pi*x)*sin(t/5 - z)^2/5 - pi^2*mms:c97*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(pi*x)*cos(t/5 - z)^2/50
c221 = -3*mms:c87/800 + pi*sin(2*pi*x)*cos(t/5 - y)/50
c223 = 3*mms:c68*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c230 = 5*mms:c68*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
total_pressure = mms:c18*mms:c75 + mms:c75*(mms:c10 + 1)
pressure_i = mms:c75*(mms:c10 + 1)
pressure_j = mms:c18*mms:c75
ion_temperature = mms:c75
potential = mms:c40
pressure_potential = -mms:c71 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c97*(mms:c115*sin(t/5 - z)^2/41 + 512*cos(pi*x)/287 - 792*cos(3*pi*x)/287 + 40*cos(5*pi*x)/41)/100

[Ni]
solution = mms:c10 + 1
source = mms:c105*(mms:c89*(2*mms:c10 + 2) - pi*sin(2*pi*x)*cos(t/5 - y)/(50*(mms:c24 - mms:c27 + 11/4))) + mms:c117*(mms:c112*(2*mms:c10 + 2) - 3*pi*sin(t/5 + z)/(250*(mms:c24 - mms:c27 + 11/4))) + mms:c125 - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/500 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c18
source = mms:c105*(3*mms:c87/(400*mms:c126) + 3*mms:c128*mms:c18/mms:c126^2) + mms:c117*(pi*mms:c109/mms:c126 + 3*mms:c18*(-3*mms:c133/200 + 3*pi*sin(t/5 + z)/125)/mms:c126^2) + pi*mms:c137*mms:c29 + pi*mms:c139*mms:c18 + mms:c142 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2*cos(t/5 + y)/2000 - pi^2*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c23*(mms:c24 + 2)
source = mms:c105*(mms:c166*(mms:c24 + 2)/(125*(mms:c24 - mms:c27 + 11/4)) + 2*mms:c23*mms:c89*(mms:c24 + 2) - pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/(25*(mms:c24 - mms:c27 + 11/4))) + mms:c117*(-pi*mms:c164*(mms:c24 + 2)/(mms:c24 - mms:c27 + 11/4) + 2*mms:c23*(mms:c24 + 2)*(-pi*mms:c109 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2 - 3*pi*mms:c23*sin(t/5 + z)/(125*(mms:c24 - mms:c27 + 11/4))) + mms:c145*(mms:c10 + 1) - mms:c146*mms:c23 + pi*mms:c149*mms:c23*(mms:c24 + 2) - mms:c153*(-pi*mms:c148*(mms:c24 + 2) - 3*pi*mms:c23*sin(t/5 + z)/250) + mms:c155*(mms:c10 + 1) + mms:c161*(mms:c10 + 1) + pi*mms:c23^2*sin(t/5 - y)*cos(2*pi*x)/50 + mms:c59*(-pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/50 + pi*(mms:c24 + 2)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/250) + pi*mms:c75*sin(t/5 - y)*cos(2*pi*x)/100 + (-mms:c123 + mms:c148)*(mms:c24 + 2)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c29*(3/4 - mms:c27)
source = mms:c105*(9*mms:c29*mms:c87/(400*mms:c126) + 9*mms:c87*(3/4 - mms:c27)/(1000*mms:c126) + 3*mms:c128*mms:c29*(3/4 - mms:c27)/mms:c126^2) + mms:c117*(9*mms:c133*mms:c29/(400*mms:c126) + 9*mms:c133*(3/4 - mms:c27)/(1000*mms:c126) + 3*mms:c29*(3/4 - mms:c27)*(-3*mms:c133/200 + 3*pi*sin(t/5 + z)/125)/mms:c126^2) + pi*mms:c137*mms:c75 - mms:c145*(mms:c32 - 1/2) - mms:c153*(pi*mms:c109*mms:c29 + pi*mms:c169*(3/4 - mms:c27)) + mms:c155*mms:c18 + mms:c161*mms:c18 + pi*mms:c168*mms:c29^2 + pi*mms:c170*mms:c29*(3/4 - mms:c27) + mms:c29*(-mms:c109 + mms:c168) + mms:c59*(3*mms:c29*mms:c87/400 + 3*mms:c87*(3/4 - mms:c27)/1000) + (3/4 - mms:c27)*(mms:c139 - mms:c169)
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c31*(mms:c10 - mms:c32 + 3/2)
source = -mms:c153*(pi*mms:c180*(mms:c10 - mms:c32 + 3/2) + mms:c31*(-3*pi*sin(t/5 + z)/500 + pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)) - pi*mms:c179*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32)) + 2*mms:c31*((-mms:c186 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32))/(mms:c10 - mms:c32 + 3/2)^2 + (mms:c125 + pi*mms:c139*(1/2 - mms:c32) + mms:c186*mms:c29)/(mms:c10 - mms:c32 + 3/2))*(mms:c10 - mms:c32 + 3/2)/3 + mms:c31*(mms:c125 + pi*mms:c139*(1/2 - mms:c32) + mms:c186*mms:c29) + mms:c31*(-mms:c178 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + mms:c59*(mms:c31*(mms:c87/200 - pi*sin(2*pi*x)*cos(t/5 - y)/100) + pi*(mms:c10 - mms:c32 + 3/2)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/100) + (mms:c179 - mms:c180)*(mms:c10 - mms:c32 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -pi^2*mms:c40/10 - 2*mms:c48*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z) + 2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)/25
source = -pi^4*mms:c115*mms:c97*cos(t/5 - z)^2/25625 + pi^4*mms:c115*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)^2/25625 - mms:c188*mms:c48 + mms:c48*sin(t/5 + y)*sin(t/5 - z)/2500 - pi^2*mms:c97*((-42*pi^2*cos(pi*x)/25 + 567*pi^2*cos(3*pi*x)/25 - 21*pi^2*cos(5*pi*x))*sin(t/5 - z)^2/41 - 128*pi^2*cos(pi*x)/7175 + 1782*pi^2*cos(3*pi*x)/7175 - 10*pi^2*cos(5*pi*x)/41)/50 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/50 + 2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)/125 - pi^2*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/62500 - pi^2*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/2500

[Eion]
solution = 3*mms:c18*mms:c75/2 + mms:c23^2*(mms:c10 + 1) + mms:c29^2*(3/8 - mms:c51) + mms:c70^2 + 3*mms:c75*(mms:c10 + 1)/2 + (mms:c59 + mms:c61/5)^2
source = mms:c105*(mms:c153 + mms:c89*(15*mms:c18*mms:c75/4 + 3*mms:c29^2*(3/8 - mms:c51)/2) + mms:c89*(2*mms:c23^2*(mms:c10 + 1) + 5*mms:c75*(mms:c10 + 1)) + 3*(5*mms:c160*mms:c18*mms:c221/2 - mms:c18*mms:c230/(mms:c24 - mms:c51 + 19/8) + 3*mms:c29^2*mms:c87/800 + 3*mms:c29*mms:c87*(3/8 - mms:c51)/500 + mms:c75*mms:c87/160)/(2*(mms:c24 - mms:c27 + 11/4)) + 2*(5*mms:c221*(mms:c10 + 1)*(-2*mms:c71 + 2*cos(t/5 - y)/25 + 12/5)/(2*(mms:c24 - mms:c51 + 19/8)^2) - pi*mms:c23^2*sin(2*pi*x)*cos(t/5 - y)/100 + pi*mms:c23*(mms:c10 + 1)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/125 - mms:c230*(mms:c10 + 1)/(mms:c24 - mms:c51 + 19/8) - pi*mms:c75*sin(2*pi*x)*cos(t/5 - y)/40)/(mms:c24 - mms:c27 + 11/4)) + mms:c117*(mms:c112*(15*mms:c18*mms:c75/4 + 3*mms:c29^2*(3/8 - mms:c51)/2) + mms:c112*(2*mms:c23^2*(mms:c10 + 1) + 5*mms:c75*(mms:c10 + 1)) + mms:c59 + 3*(mms:c133*mms:c75/160 + 5*mms:c160*mms:c18*(-pi*mms:c193 + 3*pi*sin(t/5 + z)/250)/2 + mms:c18*mms:c61/(mms:c24 - mms:c51 + 19/8) + pi*mms:c193*mms:c29^2 + pi*mms:c194*mms:c29*(3/8 - mms:c51))/(2*(mms:c24 - mms:c27 + 11/4)) + 2*(-pi*mms:c164*mms:c23*(mms:c10 + 1) - 3*pi*mms:c23^2*sin(t/5 + z)/500 - 3*pi*mms:c75*sin(t/5 + z)/200 + 5*(mms:c10 + 1)*(-pi*mms:c193 + 3*pi*sin(t/5 + z)/250)*(-2*mms:c71 + 2*cos(t/5 - y)/25 + 12/5)/(2*(mms:c24 - mms:c51 + 19/8)^2) + pi*(mms:c10 + 1)*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)/(mms:c24 - mms:c51 + 19/8))/(mms:c24 - mms:c27 + 11/4)) + pi*mms:c123*(mms:c23^2*(mms:c10 + 1) + 5*mms:c75*(mms:c10 + 1)/2) + pi*mms:c139*(5*mms:c18*mms:c75/2 + mms:c29^2*(3/8 - mms:c51)) + 3*mms:c142*mms:c75/2 + mms:c145*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32)) - mms:c153*(3*mms:c160*mms:c18*(-pi*mms:c193 + 3*pi*sin(t/5 + z)/250)/2 + mms:c160*(3*mms:c10/2 + 3/2)*(-pi*mms:c193 + 3*pi*sin(t/5 + z)/250) - pi*mms:c164*mms:c23*(mms:c10 + 1) + 3*mms:c18*mms:c61/(5*(mms:c24 - mms:c51 + 19/8)) + pi*mms:c193*mms:c29^2 + pi*mms:c193*mms:c75 + pi*mms:c194*mms:c29*(3/8 - mms:c51