#!/usr/bin/env python3

"""Run isolated diagnostics on/off equilibrium cases and audit inventories."""

import argparse
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import xarray as xr

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "tools"))

from energy_analysis import (
    AuditError,
    energy_balance,
    energy_densities,
    energy_inventory,
    open_run,
)
from energy_analysis.report import inventory_report


def require(condition, message):
    if not condition:
        raise AuditError(message)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--exe", type=Path)
    parser.add_argument("--output-root", type=Path)
    parser.add_argument("--timeout", type=int, default=120)
    args = parser.parse_args()
    candidates = [ROOT / "hermes-3", ROOT / "build/hermes-3"]
    executable = args.exe or next((p for p in candidates if p.is_file()), None)
    require(executable is not None, "Specify the built Hermes executable with --exe")
    executable = executable.resolve()
    output = Path(
        tempfile.mkdtemp(prefix="ion-energy-inventory-", dir=args.output_root)
    )
    print(f"Results: {output}", flush=True)
    reports, runs, inventories = {}, {}, {}
    for diagnose in (False, True):
        label = "diagnose-on" if diagnose else "diagnose-off"
        folder = output / label
        folder.mkdir()
        shutil.copyfile(
            Path(__file__).parent / "data/BOUT.inp",
            folder / "BOUT.inp",
        )
        value = str(diagnose).lower()
        command = [
            str(executable),
            "-d",
            str(folder),
            *[
                f"{component}:diagnose={value}"
                for component in ("e", "d+", "impurity", "evolve_vorticity_ion_energy")
            ],
        ]
        with (folder / "run.log").open("w") as log:
            try:
                result = subprocess.run(
                    command,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                    timeout=args.timeout,
                    check=False,
                )
            except subprocess.TimeoutExpired:
                (folder / "execution.json").write_text(
                    json.dumps({"command": command, "timeout": args.timeout})
                )
                raise AuditError(f"Simulation timed out: {folder / 'run.log'}")
        (folder / "execution.json").write_text(
            json.dumps({"command": command, "returncode": result.returncode}, indent=2)
            + "\n"
        )
        require(
            result.returncode == 0,
            f"Simulation failed ({result.returncode}): {folder / 'run.log'}",
        )
        run = open_run(folder)
        report, inventory = inventory_report(run)
        # Zero powers are an analytic property of this uniform, source-free
        # input, verified below. The general analysis does not assume them.
        for name in ("Nd+", "Nimpurity", "Pe", "Tion", "phi"):
            field = run.interior(run.data[name])
            require(
                float((field.max() - field.min()).compute()) < 1e-10,
                f"Nonuniform equilibrium {name}",
            )
        densities = energy_densities(run)
        for name in ("ion_parallel", "ion_perpendicular", "electron_parallel"):
            require(
                float(abs(run.interior(densities[name])).max().compute()) < 1e-12,
                f"Unexpected {name}",
            )
        zero = xr.zeros_like(inventory.t)
        zero.attrs = {
            "units": "W",
            "provenance": "analytic uniform source-free equilibrium",
        }
        budget = energy_balance(inventory, source_power=zero, outward_power=zero)
        drift = float(abs(budget.relative_residual).max())
        report["balance"] = {
            **budget.attrs,
            "max_relative_residual": drift,
            "source_provenance": zero.attrs["provenance"],
            "boundary_provenance": zero.attrs["provenance"],
        }
        (folder / "energy-report.json").write_text(
            json.dumps(report, indent=2, allow_nan=False) + "\n"
        )
        require(drift < 1e-10, f"Equilibrium energy drift: {drift}")
        require(
            report["partition_max_absolute_error_normalised"] < 1e-10,
            "Ion partition mismatch",
        )
        require(
            report["forward_max_absolute_error_normalised"] < 1e-10,
            "Forward vorticity mismatch",
        )
        require(
            {s.name for s in run.species} == {"e", "d+", "impurity"},
            "Incomplete species manifest",
        )
        for diagnostic, comparison in report["diagnostics"].items():
            require(
                comparison["available"] == diagnose,
                f"Diagnostic availability mismatch: {diagnostic}",
            )
            if diagnose:
                require(
                    comparison["max_absolute_error_normalised"] < 1e-10,
                    f"Diagnostic mismatch: {diagnostic}",
                )
        reports[label], runs[label], inventories[label] = report, run, inventory
    xr.testing.assert_allclose(
        inventories["diagnose-on"], inventories["diagnose-off"], rtol=1e-10, atol=1e-14
    )
    for name in ("Nd+", "Nimpurity", "Ne", "Pe", "Tion", "Eion", "phi", "Vort"):
        xr.testing.assert_allclose(
            runs["diagnose-on"].data[name],
            runs["diagnose-off"].data[name],
            rtol=1e-10,
            atol=1e-12,
        )
    enabled = runs["diagnose-on"].data
    # Remove all optional evolving fields, not just the kinetic diagnostics.
    essential = {"Eion", "Pe", "Tion", "phi", "Vort", "Nd+", "Nimpurity", "Ne"}
    stripped = enabled.drop_vars(
        [
            name
            for name in enabled.data_vars
            if "t" in enabled[name].dims and name not in essential
        ]
    )
    xr.testing.assert_allclose(
        energy_inventory(open_run(stripped)), inventories["diagnose-on"]
    )
    (output / "result.json").write_text(
        json.dumps(
            {"passed": True, "cases": list(reports), "diagnostics_independent": True},
            indent=2,
        )
        + "\n"
    )
    print("Equilibrium inventory test passed (diagnostics on/off and stripped outputs)")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (AuditError, AssertionError) as error:
        print(f"Energy integration test failed: {error}", file=sys.stderr)
        raise SystemExit(1)
