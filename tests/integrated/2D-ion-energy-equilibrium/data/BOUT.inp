# Uniform two-ion equilibrium: no gradients, sources, curvature or flows.
# Expected global source and outward powers are both zero.
nout = 4
timestep = 10
MYG = 0

[mesh]
nx = 20
ny = 1
nz = 16
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
sinty = 0
Bxy = Bpxy
Btxy = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0

[solver]
atol = 1e-12
rtol = 1e-9
mxstep = 10000

[hermes]
components = e, d+, impurity, evolve_vorticity_ion_energy
recalculate_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
thermal_conduction = false
poloidal_flows = false
diagnose = false

[Pe]
function = 1
bndry_all = neumann

[d+]
type = evolve_density
charge = 1
AA = 2
poloidal_flows = false
diagnose = false

[Nd+]
function = 0.5
bndry_all = neumann

[impurity]
type = evolve_density
charge = 2
AA = 3
poloidal_flows = false
diagnose = false

[Nimpurity]
function = 0.25
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1.75
poloidal_flows = false
phi_boundary_relax = false
phi_rtol = 1e-8
vort_atol = 1e-12
diagnose = false

[Eion]
# 3/2 * (0.5 + 0.25) at common Tion = 1.
function = 1.125
