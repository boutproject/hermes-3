# Closed source-free slab; output cadence is overridden by runtest.
periodicX = true
MYG = 0
nout = 40
timestep = 3

[mesh]
nx = 20
ny = 1
nz = 16
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
sinty = 0
Bxy = Bpxy
Btxy = 0
bxcvx = 0
bxcvy = 0
bxcvz = 1 / Rxy^2

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
atol = 1e-11
rtol = 1e-8
mxstep = 10000

[hermes]
components = e, h+, evolve_vorticity_ion_energy
recalculate_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[e]
type = evolve_density, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
diagnose = false

[Ne]
function = 1
source = 0
bndry_all = neumann

[Pe]
function = 1 + 0.1 * sin(2*pi*x - z)
source = 0
bndry_all = neumann

[h+]
type = quasineutral
charge = 1
AA = 1

[evolve_vorticity_ion_energy]
average_atomic_mass = 1
poloidal_flows = false
phi_boundary_relax = false
phi_rtol = 1e-8
vort_atol = 1e-12
phi_max_iterations = 200
diagnose = false

[Eion]
function = (3/2) * Pe:function
