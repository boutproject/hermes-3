nout = 50
timestep = 0.1


[mesh]

extrapolate_y = false

[mesh:paralleltransform]
type = fci


[solver]
mxstep = 10000
rtol = 1e-6
atol = 1e-12
mms = true  # Run with MMS sources and output diagnostics
mms_initialise = true
[hermes]
components = h+, relax_potential


Nnorm = 1e18
Bnorm = 1
Tnorm = 5

[relax_potential]
exb_advection = false
diamagnetic = false
vort_dissipation = false
phi_dissipation = false
viscosity = 1.0
boussinesq = false
diamagnetic_polarisation = false

[h+]  # Ions
type = fixed_density, fixed_temperature
charge = 1.0
AA = 1.0

density = 2.0e+17*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0e+18
temperature = 5.0000000000000

[Vort]
solution = -3.60625264297958e-6*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 1.44250105719183e-7*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 1.90916386630904e-8*sin(6.28318530717959*x)*sin(2.0*z + 1.321312) + 5.77000422876733e-7*sin(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 1.44250105719183e-7*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^2
source = -7.43082732791958e-12*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 4.16126330363496e-13*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)^2*sin(2.0*z + 1.321312)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 9.51145897973706e-13*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 + 1.7833985587007e-13*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^4 + 7.1335942348028e-15*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)^4/(0.1*sin(6.28318530717959*x) + 1.0)^5 - 3.93390825206424e-14*sin(6.28318530717959*x)*sin(2.0*z + 1.321312) - 3.50735049877804e-12*sin(6.28318530717959*x)^2*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 4.75572948986853e-12*sin(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 + 1.18893237246713e-12*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 9.51145897973706e-13*cos(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^2 - 4.75572948986853e-14*sin(6.28318530717959*x)^3*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 2.85343769392112e-13*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.1*sin(6.28318530717959*x) + 1.0)^3 + 2.85343769392112e-13*sin(6.28318530717959*x)*cos(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^3 - 1.42671884696056e-14*sin(6.28318530717959*x)^2*cos(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.1*sin(6.28318530717959*x) + 1.0)^4 - 1.07003913522042e-14*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^4/(0.1*sin(6.28318530717959*x) + 1.0)^4
bndry_all = dirichlet(Vort:solution)
[phi1]
solution = 0.35*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)
source = 0
bndry_all = dirichlet(phi1:solution)
