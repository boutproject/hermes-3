nout = 50
timestep = 0.1


[mesh]

extrapolate_y = false

[mesh:paralleltransform]
type = fci


[solver]
mxstep = 10000
rtol = 1e-6
atol = 1e-12
mms = true  # Run with MMS sources and output diagnostics
mms_initialise = true
[hermes]
components = h+, relax_potential


Nnorm = 1e18
Bnorm = 1
Tnorm = 5

[relax_potential]
exb_advection = false
diamagnetic = false
vort_dissipation = false
phi_dissipation = false
viscosity = 1.0
boussinesq = false
diamagnetic_polarisation = false

[h+]  # Ions
type = fixed_density, fixed_temperature
charge = 1.0
AA = 1.0

density = 2.0e+17*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0e+18
temperature = 5.0000000000000


[Vort]
solution = 0.01*sin(6.28318530717959*x)*sin(2.0*z - 2.521312)
source = 2.06053986328036e-8*sin(6.28318530717959*x)*sin(2.0*z - 2.521312)
bndry_all = dirichlet(Vort:solution)
[phi1]
solution = 0.35*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)
source = 0.001003489708392*sin(6.28318530717959*x)*sin(2.0*z - 2.521312) + 1.915826291475e-9*sin(6.28318530717959*x)*sin(2.0*z + 1.321312) + 3.65529902082418e-7*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(6.28318530717959*x)*sin(2.0*z + 1.321312)/(0.0100502512562814*x + 1)^2 - 5.84847843331869e-8*sin(6.28318530717959*x)^2*cos(2.0*z + 1.321312)*cos(2.0*z + 4.7)/(0.0100502512562814*x + 1)^2 - 1.46211960832967e-8*sin(2.0*z + 1.321312)*sin(2.0*z + 4.7)*cos(6.28318530717959*x)^2/(0.0100502512562814*x + 1)^2 + 2.33872927695732e-10*(0.2*sin(6.28318530717959*x)*sin(2.0*z + 4.7) + 1.0)*sin(2.0*z + 1.321312)*cos(6.28318530717959*x)/(0.0100502512562814*x + 1)^3
bndry_all = dirichlet(phi1:solution)
