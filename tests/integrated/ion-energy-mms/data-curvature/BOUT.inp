# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = (1/10)*1.602176634e-19/(2*1.672621898e-27)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[polarisation_drift]
implementation = conservative

[mms]
variant = curvature
c9 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c17 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c22 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c23 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c26 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80
c28 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c35 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)
c37 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c40 = (-2*mms:c35 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c23 - mms:c37 + 19/8)
c44 = -mms:c17*mms:c40 - mms:c40*(mms:c9 + 1) - sin(t/5 - z)*cos(2*pi*x)/50 + 4
c50 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c52 = -2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)/25
c54 = 44*pi^2*cos(2*pi*x)/287 - 4*pi^2*cos(4*pi*x)/25
c56 = 2*mms:c54*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c62 = 220*pi*sin(2*pi*x)/287 - 2*pi*sin(4*pi*x)/5
c64 = -mms:c62*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z) + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c67 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)
c70 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)
c87 = (sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)
c91 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)
c95 = -pi^2*mms:c50/25 + pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)/25
c97 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c100 = mms:c67*(pi^2*mms:c62*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/25 - pi^3*mms:c87/250)/5
c101 = pi*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c108 = -pi^2*mms:c50/100 - mms:c54*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c117 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c119 = pi^2*mms:c117*((-42*pi^2*cos(pi*x)/25 + 567*pi^2*cos(3*pi*x)/25 - 21*pi^2*cos(5*pi*x))*sin(t/5 - z)^2/41 - 128*pi^2*cos(pi*x)/7175 + 1782*pi^2*cos(3*pi*x)/7175 - 10*pi^2*cos(5*pi*x)/41)/50
c123 = 2*pi*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(t/5 - z)
c128 = -4400*cos(2*pi*x)/287 + 4*cos(4*pi*x) + 3252/287
c130 = 13200*cos(2*pi*x)/287 - 36*cos(4*pi*x) - 3252/287
c131 = mms:c100 + mms:c108*mms:c97/50 - mms:c119 - pi^2*mms:c50*(mms:c101*mms:c62 + mms:c97/50)/20 - pi^3*mms:c64*mms:c91/500 - pi^3*mms:c87*(mms:c67/5 + pi*mms:c70/5)/250 + pi*mms:c87*(mms:c101*mms:c54 - pi^3*mms:c91/500)/10 + mms:c95*mms:c97/50 + pi^3*(mms:c117*(pi*mms:c128*cos(pi*x)*cos(t/5 - z)^2/10 + pi*mms:c130*sin(t/5 - z)^2*cos(pi*x)/10 + (-2640*pi*sin(2*pi*x)/287 + 72*pi*sin(4*pi*x)/5)*sin(pi*x)*sin(t/5 - z)^2 + (880*pi*sin(2*pi*x)/287 - 8*pi*sin(4*pi*x)/5)*sin(pi*x)*cos(t/5 - z)^2 + (440*pi*cos(2*pi*x)/287 - 8*pi*cos(4*pi*x)/5)*cos(pi*x) - pi*(2200*sin(2*pi*x)/287 - 4*sin(4*pi*x))*sin(pi*x)/10) + mms:c123)/500 - pi*cos(2*pi*x)*cos(t/5 - z)/5000
c136 = (3300*sin(2*pi*x)/287 - 6*sin(4*pi*x))*sin(pi*x) + (8800*cos(2*pi*x)/287 - 14*cos(4*pi*x) - 4878/287)*cos(pi*x)
c138 = 168*cos(pi*x) - 252*cos(3*pi*x) + 84*cos(5*pi*x)
c139 = pi^4*mms:c117*mms:c138*cos(t/5 - z)^2/25625 - pi^4*mms:c138*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)^2/25625
c140 = -mms:c100 - mms:c108*mms:c97/50 - mms:c139 + pi^2*mms:c50*(mms:c101*mms:c62 + mms:c97/50)/20 + pi^3*mms:c64*mms:c91/500 + pi^3*mms:c87*(mms:c67/5 + pi*mms:c70/5)/250 - pi*mms:c87*(mms:c101*mms:c54 - pi^3*mms:c91/500)/10 - mms:c95*mms:c97/50 + pi^3*(-pi*mms:c117*mms:c136*sin(t/5 - z)^2/5 - mms:c123 + pi*mms:c136*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)^2/5)/500 - pi*cos(2*pi*x)*cos(t/5 - z)/5000
c142 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(t/5 - z)
c143 = -pi*mms:c108*mms:c87/10 + pi^3*mms:c138*mms:c142/5125 + pi^2*mms:c50*mms:c64/100 - mms:c67*(mms:c101*mms:c62 + mms:c97/50)/5 - mms:c97*(mms:c67/5 + pi*mms:c70/5)/50 + pi^3*(-mms:c136*mms:c142 - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500 + sin(t/5 - z)*cos(2*pi*x)/1000
c148 = 3*pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c149 = (-mms:c148 + 3*pi*sin(t/5 + z)/250)/(mms:c23 - mms:c26 + 11/4)^2
c153 = -pi^2*mms:c117*((-84*pi*sin(pi*x)/5 + 378*pi*sin(3*pi*x)/5 - 42*pi*sin(5*pi*x))*sin(t/5 - z)^2/41 - 256*pi*sin(pi*x)/1435 + 1188*pi*sin(3*pi*x)/1435 - 20*pi*sin(5*pi*x)/41)/50 - pi^2*mms:c50*(mms:c67/5 + pi*mms:c70/5)/25 + mms:c64*mms:c97/50 + mms:c67*mms:c95/5 + pi*mms:c87*(mms:c101*mms:c62 + mms:c97/50)/10 + pi^3*(mms:c117*(mms:c128*sin(pi*x)*cos(t/5 - z)^2 + mms:c130*sin(pi*x)*sin(t/5 - z)^2 + (2200*sin(2*pi*x)/287 - 4*sin(4*pi*x))*cos(pi*x)) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500 - sin(2*pi*x)*cos(t/5 - z)/1000
c156 = 3*pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/400
c157 = (-mms:c156 + pi*sin(2*pi*x)*cos(t/5 - y)/50)/(mms:c23 - mms:c26 + 11/4)^2
c166 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c168 = pi*mms:c166*(mms:c9 + 1) + pi*mms:c22*sin(t/5 - y)*cos(2*pi*x)/100
c169 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40 + cos(2*pi*x)*cos(t/5 - y)/5 + 3*cos(t/5 + z)/25 + 11/2
c178 = mms:c143*(3*pi*sin(t/5 + z)/125 - 3*pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)
c179 = mms:c153*(-3*pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/200 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c181 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c183 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c190 = mms:c181 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c191 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c193 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c199 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c201 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c203 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c204 = pi*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c206 = (-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)
c207 = (pi*mms:c206*sin(t/5 - z)/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c23 - mms:c37 + 19/8)
c209 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c212 = (-2*mms:c35 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c23 - mms:c37 + 19/8)^2
c213 = mms:c212*(-pi*mms:c209 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c215 = mms:c207*(mms:c9 + 1) + mms:c213*(mms:c9 + 1) + pi*mms:c40*sin(t/5 - y)*cos(2*pi*x)/100
c216 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c220 = pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c222 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c224 = pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c225 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c234 = -sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
c237 = 2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c238 = mms:c237*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)
c239 = (-mms:c238 + (-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c23 - mms:c37 + 19/8)
c242 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c246 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c248 = -mms:c246/200 - pi*sin(t/5 - y)*cos(2*pi*x)/100
c261 = 3*pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c266 = mms:c17*mms:c212*(-mms:c261 + 3*pi*sin(t/5 + z)/250) + pi*mms:c17*mms:c238/(mms:c23 - mms:c37 + 19/8) + mms:c212*(-mms:c261 + 3*pi*sin(t/5 + z)/250)*(mms:c9 + 1) + mms:c220*mms:c40/400 + pi*mms:c238*(mms:c9 + 1)/(mms:c23 - mms:c37 + 19/8) - 3*pi*mms:c40*sin(t/5 + z)/500
c267 = mms:c62*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/(mms:c23 - mms:c37 + 19/8)
c269 = 3*pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/800
c272 = mms:c17*mms:c212*(-mms:c269 + pi*sin(2*pi*x)*cos(t/5 - y)/50)
c273 = mms:c212*(-mms:c269 + pi*sin(2*pi*x)*cos(t/5 - y)/50)*(mms:c9 + 1)
c285 = 3*mms:c17*mms:c212*(-mms:c261 + 3*pi*sin(t/5 + z)/250)/2 + 3*pi*mms:c17*mms:c70/(5*(mms:c23 - mms:c37 + 19/8)) + 3*mms:c220*mms:c28*(3/8 - mms:c37)/500 + mms:c261*mms:c28^2 + mms:c261*mms:c40
c289 = -3*mms:c17*mms:c267 + 3*mms:c224*mms:c28*(3/8 - mms:c37)/500 + mms:c269*mms:c28^2 + mms:c269*mms:c40 + 3*mms:c272/2
c292 = -mms:c35 + mms:c50 + 3*(3*mms:c17*mms:c40/2 + mms:c28^2*(3/8 - mms:c37))/(2*(mms:c23 - mms:c26 + 11/4)) + 2*(mms:c22^2*(mms:c9 + 1) + 3*mms:c40*(mms:c9 + 1)/2)/(mms:c23 - mms:c26 + 11/4) + cos(t/5 - y)/25 + 6/5
total_pressure = mms:c17*mms:c40 + mms:c40*(mms:c9 + 1)
pressure_i = mms:c40*(mms:c9 + 1)
pressure_j = mms:c17*mms:c40
ion_temperature = mms:c40
potential = mms:c50
pressure_potential = -mms:c35 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c117*(mms:c138*sin(t/5 - z)^2/41 + 512*cos(pi*x)/287 - 792*cos(3*pi*x)/287 + 40*cos(5*pi*x)/41)/100 - cos(2*pi*x)*cos(t/5 - z)/(400*pi)

[Ni]
solution = mms:c9 + 1
source = 2*mms:c131*(mms:c9 + 1)/(mms:c23 - mms:c26 + 11/4) + 2*mms:c140*(mms:c9 + 1)/(mms:c23 - mms:c26 + 11/4) + mms:c143*mms:c149*(2*mms:c9 + 2) - 3*pi*mms:c143*sin(t/5 + z)/(250*(mms:c23 - mms:c26 + 11/4)) + mms:c153*mms:c157*(2*mms:c9 + 2) - pi*mms:c153*sin(2*pi*x)*cos(t/5 - y)/(50*(mms:c23 - mms:c26 + 11/4)) + mms:c168 - pi^2*mms:c91*sin(2*pi*x)*cos(t/5 - y)/500 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c17
source = 3*mms:c131*mms:c17/mms:c169 + 3*mms:c140*mms:c17/mms:c169 + mms:c143*mms:c148/mms:c169 + mms:c153*mms:c156/mms:c169 + pi*mms:c17*mms:c183 + pi*mms:c181*mms:c28 + mms:c190 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2*cos(t/5 + y)/2000 - pi^2*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000 + 3*mms:c17*mms:c178/mms:c169^2 + 3*mms:c17*mms:c179/mms:c169^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c22*(mms:c23 + 2)
source = 2*mms:c131*mms:c22*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) + 2*mms:c140*mms:c22*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) + 2*mms:c143*mms:c149*mms:c22*(mms:c23 + 2) - pi*mms:c143*mms:c203*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) - 3*pi*mms:c143*mms:c22*sin(t/5 + z)/(125*(mms:c23 - mms:c26 + 11/4)) + 2*mms:c153*mms:c157*mms:c22*(mms:c23 + 2) + mms:c153*mms:c204*(mms:c23 + 2)/(125*(mms:c23 - mms:c26 + 11/4)) - pi*mms:c153*mms:c22*sin(2*pi*x)*cos(t/5 - y)/(25*(mms:c23 - mms:c26 + 11/4)) - mms:c191*mms:c22 + mms:c199*(mms:c9 + 1) + pi*mms:c201*mms:c22*(mms:c23 + 2) + mms:c215 + pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/50 + mms:c67*(-pi*mms:c22*sin(2*pi*x)*cos(t/5 - y)/50 + pi*(mms:c23 + 2)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/250)/5 - pi*mms:c87*(-pi*mms:c193*(mms:c23 + 2) - 3*pi*mms:c22*sin(t/5 + z)/250)/10 + (-mms:c166 + mms:c193)*(mms:c23 + 2)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c28*(3/4 - mms:c26)
source = 3*mms:c131*mms:c28*(3/4 - mms:c26)/mms:c169 + 3*mms:c140*mms:c28*(3/4 - mms:c26)/mms:c169 + 9*mms:c143*mms:c220*mms:c28/(400*mms:c169) + mms:c143*mms:c220*(27/4000 - 9*mms:c26/1000)/mms:c169 + 9*mms:c153*mms:c224*mms:c28/(400*mms:c169) + mms:c153*mms:c224*(27/4000 - 9*mms:c26/1000)/mms:c169 + mms:c17*mms:c207 + mms:c17*mms:c213 + pi*mms:c181*mms:c40 - mms:c199*(mms:c222 - 1/2) + pi*mms:c216*mms:c28^2 + pi*mms:c225*mms:c28*(3/4 - mms:c26) + mms:c28*(mms:c216 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400) + mms:c67*(mms:c156*mms:c28 + mms:c224*(9/4000 - 3*mms:c26/1000))/5 - pi*mms:c87*(mms:c148*mms:c28 + mms:c220*(9/4000 - 3*mms:c26/1000))/10 + (3/4 - mms:c26)*(mms:c183 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000) + 3*mms:c178*mms:c28*(3/4 - mms:c26)/mms:c169^2 + 3*mms:c179*mms:c28*(3/4 - mms:c26)/mms:c169^2
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c44
