# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = baseline
c10 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c18 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c23 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c24 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c27 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80
c29 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c31 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c32 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c40 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c46 = -2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)/25
c48 = 44*pi^2*cos(2*pi*x)/287 - 4*pi^2*cos(4*pi*x)/25
c51 = 2*mms:c48*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c57 = 220*pi*sin(2*pi*x)/287 - 2*pi*sin(4*pi*x)/5
c59 = -mms:c57*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z) + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c62 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c64 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)
c69 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)
c71 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c74 = (-2*mms:c69 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c71 + 19/8)
c90 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c93 = (-pi*mms:c90 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2
c100 = 168*cos(pi*x) - 252*cos(3*pi*x) + 84*cos(5*pi*x)
c101 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(t/5 - z)
c103 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)/50
c106 = mms:c103 + pi*mms:c57*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c108 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c113 = pi^3*mms:c100*mms:c101/5125 - mms:c103*(mms:c62 + pi*mms:c64/5) - mms:c106*mms:c62 - mms:c108*(-pi^2*mms:c40/100 - mms:c48*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)) + pi^2*mms:c40*mms:c59/100 + pi^3*(-mms:c101*((3300*sin(2*pi*x)/287 - 6*sin(4*pi*x))*sin(pi*x) + (8800*cos(2*pi*x)/287 - 14*cos(4*pi*x) - 4878/287)*cos(pi*x)) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500
c118 = pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c120 = (-3*mms:c118/400 + pi*sin(2*pi*x)*cos(t/5 - y)/50)/(mms:c24 - mms:c27 + 11/4)^2
c125 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c130 = mms:c103*mms:c59 + mms:c106*mms:c108 - pi^2*mms:c125*((-84*pi*sin(pi*x)/5 + 378*pi*sin(3*pi*x)/5 - 42*pi*sin(5*pi*x))*sin(t/5 - z)^2/41 - 256*pi*sin(pi*x)/1435 + 1188*pi*sin(3*pi*x)/1435 - 20*pi*sin(5*pi*x)/41)/50 - pi^2*mms:c40*(mms:c62 + pi*mms:c64/5)/25 + mms:c62*(-pi^2*mms:c40/25 + pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 - z)/25) + pi^3*(mms:c125*((2200*sin(2*pi*x)/287 - 4*sin(4*pi*x))*cos(pi*x) + (-4400*cos(2*pi*x)/287 + 4*cos(4*pi*x) + 3252/287)*sin(pi*x)*cos(t/5 - z)^2 + (13200*cos(2*pi*x)/287 - 36*cos(4*pi*x) - 3252/287)*sin(pi*x)*sin(t/5 - z)^2) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500
c135 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c137 = pi*mms:c135*(mms:c10 + 1) + pi*mms:c23*sin(t/5 - y)*cos(2*pi*x)/100
c138 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40 + cos(2*pi*x)*cos(t/5 - y)/5 + 3*cos(t/5 + z)/25 + 11/2
c142 = pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c146 = -3*mms:c118/200 + pi*sin(2*pi*x)*cos(t/5 - y)/25
c149 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c151 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c154 = mms:c149 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c157 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c158 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c160 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c161 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c165 = (pi*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c24 - mms:c71 + 19/8)
c167 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c170 = (-2*mms:c69 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c71 + 19/8)^2
c171 = mms:c170*(-pi*mms:c167 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c174 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c176 = pi*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c178 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c179 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000
c180 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c188 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c189 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c190 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100
c196 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c198 = 2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c202 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c203 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500
c207 = (-mms:c198*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287) + (-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c24 - mms:c71 + 19/8)
c211 = 2*pi*mms:c57*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)/25
c222 = 3*mms:c170*mms:c18*(-pi*mms:c202 + 3*pi*sin(t/5 + z)/250)/2 + 3*pi*mms:c18*mms:c64/(5*(mms:c24 - mms:c71 + 19/8)) + pi*mms:c202*mms:c29^2 + pi*mms:c202*mms:c74 + pi*mms:c203*mms:c29*(3/8 - mms:c71)
c225 = -3*mms:c118/800 + pi*sin(2*pi*x)*cos(t/5 - y)/50
c227 = 3*mms:c57*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c230 = 3*mms:c118*mms:c29^2/800 + 3*mms:c118*mms:c29*(3/8 - mms:c71)/500 + 3*mms:c118*mms:c74/800 + 3*mms:c170*mms:c18*mms:c225/2 - mms:c18*mms:c227/(mms:c24 - mms:c71 + 19/8)
total_pressure = mms:c18*mms:c74 + mms:c74*(mms:c10 + 1)
pressure_i = mms:c74*(mms:c10 + 1)
pressure_j = mms:c18*mms:c74
ion_temperature = mms:c74
potential = mms:c40
pressure_potential = -mms:c69 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c125*(mms:c100*sin(t/5 - z)^2/41 + 512*cos(pi*x)/287 - 792*cos(3*pi*x)/287 + 40*cos(5*pi*x)/41)/100

[Ni]
solution = mms:c10 + 1
source = mms:c113*(mms:c93*(2*mms:c10 + 2) - 3*pi*sin(t/5 + z)/(250*(mms:c24 - mms:c27 + 11/4))) + mms:c130*(mms:c120*(2*mms:c10 + 2) - pi*sin(2*pi*x)*cos(t/5 - y)/(50*(mms:c24 - mms:c27 + 11/4))) + mms:c137 - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/500 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c18
source = mms:c113*(pi*mms:c90/mms:c138 + 3*mms:c18*(-3*mms:c142/200 + 3*pi*sin(t/5 + z)/125)/mms:c138^2) + mms:c130*(3*mms:c118/(400*mms:c138) + 3*mms:c146*mms:c18/mms:c138^2) + pi*mms:c149*mms:c29 + pi*mms:c151*mms:c18 + mms:c154 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2*cos(t/5 + y)/2000 - pi^2*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c23*(mms:c24 + 2)
source = -mms:c108*(-pi*mms:c160*(mms:c24 + 2) - 3*pi*mms:c23*sin(t/5 + z)/250) + mms:c113*(-pi*mms:c174*(mms:c24 + 2)/(mms:c24 - mms:c27 + 11/4) + 2*mms:c23*(mms:c24 + 2)*(-pi*mms:c90 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2 - 3*pi*mms:c23*sin(t/5 + z)/(125*(mms:c24 - mms:c27 + 11/4))) + mms:c130*(2*mms:c120*mms:c23*(mms:c24 + 2) + mms:c176*(mms:c24 + 2)/(125*(mms:c24 - mms:c27 + 11/4)) - pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/(25*(mms:c24 - mms:c27 + 11/4))) + mms:c157*(mms:c10 + 1) - mms:c158*mms:c23 + pi*mms:c161*mms:c23*(mms:c24 + 2) + mms:c165*(mms:c10 + 1) + mms:c171*(mms:c10 + 1) + pi*mms:c23^2*sin(t/5 - y)*cos(2*pi*x)/50 + mms:c62*(-pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/50 + pi*(mms:c24 + 2)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/250) + pi*mms:c74*sin(t/5 - y)*cos(2*pi*x)/100 + (-mms:c135 + mms:c160)*(mms:c24 + 2)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c29*(3/4 - mms:c27)
source = -mms:c108*(pi*mms:c179*(3/4 - mms:c27) + pi*mms:c29*mms:c90) + mms:c113*(9*mms:c142*mms:c29/(400*mms:c138) + 9*mms:c142*(3/4 - mms:c27)/(1000*mms:c138) + 3*mms:c29*(3/4 - mms:c27)*(-3*mms:c142/200 + 3*pi*sin(t/5 + z)/125)/mms:c138^2) + mms:c130*(9*mms:c118*mms:c29/(400*mms:c138) + 9*mms:c118*(3/4 - mms:c27)/(1000*mms:c138) + 3*mms:c146*mms:c29*(3/4 - mms:c27)/mms:c138^2) + pi*mms:c149*mms:c74 - mms:c157*(mms:c32 - 1/2) + mms:c165*mms:c18 + mms:c171*mms:c18 + pi*mms:c178*mms:c29^2 + pi*mms:c180*mms:c29*(3/4 - mms:c27) + mms:c29*(mms:c178 - mms:c90) + mms:c62*(3*mms:c118*mms:c29/400 + 3*mms:c118*(3/4 - mms:c27)/1000) + (3/4 - mms:c27)*(mms:c151 - mms:c179)
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c31*(mms:c10 - mms:c32 + 3/2)
source = -mms:c108*(pi*mms:c190*(mms:c10 - mms:c32 + 3/2) + mms:c31*(-3*pi*sin(t/5 + z)/500 + pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)) - pi*mms:c189*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32)) + 2*mms:c31*((-mms:c196 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32))/(mms:c10 - mms:c32 + 3/2)^2 + (mms:c137 + pi*mms:c151*(1/2 - mms:c32) + mms:c196*mms:c29)/(mms:c10 - mms:c32 + 3/2))*(mms:c10 - mms:c32 + 3/2)/3 + mms:c31*(mms:c137 + pi*mms:c151*(1/2 - mms:c32) + mms:c196*mms:c29) + mms:c31*(-mms:c188 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + mms:c62*(mms:c31*(mms:c118/200 - pi*sin(2*pi*x)*cos(t/5 - y)/100) + pi*(mms:c10 - mms:c32 + 3/2)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/100) + (mms:c189 - mms:c190)*(mms:c10 - mms:c32 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -pi^2*mms:c40/10 - mms:c46 - mms:c51
source = where(x*(1-x),-pi^4*mms:c100*mms:c125*cos(t/5 - z)^2/25625 + pi^4*mms:c100*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)^2/25625 - pi^2*mms:c125*((-42*pi^2*cos(pi*x)/25 + 567*pi^2*cos(3*pi*x)/25 - 21*pi^2*cos(5*pi*x))*sin(t/5 - z)^2/41 - 128*pi^2*cos(pi*x)/7175 + 1782*pi^2*cos(3*pi*x)/7175 - 10*pi^2*cos(5*pi*x)/41)/50 - mms:c198*mms:c48 + mms:c48*sin(t/5 + y)*sin(t/5 - z)/2500 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/50 + 2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*cos(t/5 - z)/125 - pi^2*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 813/287)*sin(t/5 + y)*sin(t/5 - z)/62500 - pi^2*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/2500,0)

[Eion]
solution = 3*mms:c18*mms:c74/2 + mms:c23^2*(mms:c10 + 1) + mms:c29^2*(3/8 - mms:c71) + mms:c59^2 + 3*mms:c74*(mms:c10 + 1)/2 + (mms:c62 + pi*mms:c64/5)^2
