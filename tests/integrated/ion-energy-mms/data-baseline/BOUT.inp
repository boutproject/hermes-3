# Template; regenerate committed variants using python mms.py --all.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[polarisation_drift]
implementation = conservative

[mms]
variant = baseline
c10 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c18 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c23 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c24 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c27 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80
c29 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c31 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c32 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c40 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c46 = -2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 - z)/25
c48 = 44*pi^2*cos(2*pi*x)/287 - 4*pi^2*cos(4*pi*x)/25
c51 = 2*mms:c48*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c57 = 220*pi*sin(2*pi*x)/287 - 2*pi*sin(4*pi*x)/5
c59 = -mms:c57*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z) + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c62 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c64 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*cos(t/5 - z)
c69 = (cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 - z)
c71 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c74 = (-2*mms:c69 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c71 + 19/8)
c90 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c93 = (-pi*mms:c90 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2
c100 = 168*cos(pi*x) - 252*cos(3*pi*x) + 84*cos(5*pi*x)
c102 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c105 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c108 = mms:c105/50 + pi*mms:c57*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c110 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c115 = -pi^2*mms:c102*(-2*pi*mms:c100*sin(t/5 - z)*cos(t/5 - z)/205 + 16*pi*sin(2*t/5 - 2*z)*cos(pi*x)/85)/50 - mms:c105*(mms:c62 + pi*mms:c64/5)/50 - mms:c108*mms:c62 - mms:c110*(-pi^2*mms:c40/100 - mms:c48*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)) + pi^2*mms:c59*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)/100 + pi^3*(-((3300*sin(2*pi*x)/287 - 6*sin(4*pi*x))*sin(pi*x) + (8800*cos(2*pi*x)/287 - 14*cos(4*pi*x) - 6600/287)*cos(pi*x))*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(t/5 - z) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500
c120 = pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c122 = (-3*mms:c120/400 + pi*sin(2*pi*x)*cos(t/5 - y)/50)/(mms:c24 - mms:c27 + 11/4)^2
c129 = -pi^2*mms:c102*((-84*pi*sin(pi*x)/5 + 378*pi*sin(3*pi*x)/5 - 42*pi*sin(5*pi*x))*sin(t/5 - z)^2/41 - 4*pi*sin(pi*x)*cos(2*t/5 - 2*z)/85 - 256*pi*sin(pi*x)/1435 + 1188*pi*sin(3*pi*x)/1435 - 20*pi*sin(5*pi*x)/41)/50 + mms:c105*mms:c59/50 + mms:c108*mms:c110 - pi^2*mms:c40*(mms:c62 + pi*mms:c64/5)/25 + mms:c62*(-pi^2*mms:c40/25 + pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 - z)/25) + pi^3*(mms:c102*((2200*sin(2*pi*x)/287 - 4*sin(4*pi*x))*cos(pi*x) + (-4400*cos(2*pi*x)/287 + 4*cos(4*pi*x) + 4400/287)*sin(pi*x)*cos(t/5 - z)^2 + (13200*cos(2*pi*x)/287 - 36*cos(4*pi*x) - 4400/287)*sin(pi*x)*sin(t/5 - z)^2) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500
c134 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c136 = pi*mms:c134*(mms:c10 + 1) + pi*mms:c23*sin(t/5 - y)*cos(2*pi*x)/100
c137 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40 + cos(2*pi*x)*cos(t/5 - y)/5 + 3*cos(t/5 + z)/25 + 11/2
c141 = pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c145 = -3*mms:c120/200 + pi*sin(2*pi*x)*cos(t/5 - y)/25
c148 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c150 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c153 = mms:c148 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c156 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c157 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c159 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c160 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c164 = (pi*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 + y)*sin(t/5 - z)/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c24 - mms:c71 + 19/8)
c166 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c169 = (-2*mms:c69 + 2*cos(t/5 - y)/25 + 12/5)/(mms:c24 - mms:c71 + 19/8)^2
c170 = mms:c169*(-pi*mms:c166 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c173 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c175 = pi*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c177 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c178 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000
c179 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c187 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c188 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c189 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100
c195 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c197 = 2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c201 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c202 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500
c206 = (-mms:c197*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287) + (-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c24 - mms:c71 + 19/8)
c209 = mms:c105/25 + 2*pi*mms:c57*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/5
c220 = 3*mms:c169*mms:c18*(-pi*mms:c201 + 3*pi*sin(t/5 + z)/250)/2 + 3*pi*mms:c18*mms:c64/(5*(mms:c24 - mms:c71 + 19/8)) + pi*mms:c201*mms:c29^2 + pi*mms:c201*mms:c74 + pi*mms:c202*mms:c29*(3/8 - mms:c71)
c223 = -3*mms:c120/800 + pi*sin(2*pi*x)*cos(t/5 - y)/50
c225 = 3*mms:c57*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c228 = 3*mms:c120*mms:c29^2/800 + 3*mms:c120*mms:c29*(3/8 - mms:c71)/500 + 3*mms:c120*mms:c74/800 + 3*mms:c169*mms:c18*mms:c223/2 - mms:c18*mms:c225/(mms:c24 - mms:c71 + 19/8)
total_pressure = mms:c18*mms:c74 + mms:c74*(mms:c10 + 1)
pressure_i = mms:c74*(mms:c10 + 1)
pressure_j = mms:c18*mms:c74
ion_temperature = mms:c74
potential = mms:c40
pressure_potential = -mms:c69 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c102*(mms:c100*sin(t/5 - z)^2/41 + 8*cos(pi*x)*cos(2*t/5 - 2*z)/17 + 512*cos(pi*x)/287 - 792*cos(3*pi*x)/287 + 40*cos(5*pi*x)/41)/100

[Ni]
solution = mms:c10 + 1
source = mms:c115*(mms:c93*(2*mms:c10 + 2) - 3*pi*sin(t/5 + z)/(250*(mms:c24 - mms:c27 + 11/4))) + mms:c129*(mms:c122*(2*mms:c10 + 2) - pi*sin(2*pi*x)*cos(t/5 - y)/(50*(mms:c24 - mms:c27 + 11/4))) + mms:c136 - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/500 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c18
source = mms:c115*(pi*mms:c90/mms:c137 + 3*mms:c18*(-3*mms:c141/200 + 3*pi*sin(t/5 + z)/125)/mms:c137^2) + mms:c129*(3*mms:c120/(400*mms:c137) + 3*mms:c145*mms:c18/mms:c137^2) + pi*mms:c148*mms:c29 + pi*mms:c150*mms:c18 + mms:c153 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2*cos(t/5 + y)/2000 - pi^2*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c23*(mms:c24 + 2)
source = -mms:c110*(-pi*mms:c159*(mms:c24 + 2) - 3*pi*mms:c23*sin(t/5 + z)/250) + mms:c115*(-pi*mms:c173*(mms:c24 + 2)/(mms:c24 - mms:c27 + 11/4) + 2*mms:c23*(mms:c24 + 2)*(-pi*mms:c90 + 3*pi*sin(t/5 + z)/250)/(mms:c24 - mms:c27 + 11/4)^2 - 3*pi*mms:c23*sin(t/5 + z)/(125*(mms:c24 - mms:c27 + 11/4))) + mms:c129*(2*mms:c122*mms:c23*(mms:c24 + 2) + mms:c175*(mms:c24 + 2)/(125*(mms:c24 - mms:c27 + 11/4)) - pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/(25*(mms:c24 - mms:c27 + 11/4))) + mms:c156*(mms:c10 + 1) - mms:c157*mms:c23 + pi*mms:c160*mms:c23*(mms:c24 + 2) + mms:c164*(mms:c10 + 1) + mms:c170*(mms:c10 + 1) + pi*mms:c23^2*sin(t/5 - y)*cos(2*pi*x)/50 + mms:c62*(-pi*mms:c23*sin(2*pi*x)*cos(t/5 - y)/50 + pi*(mms:c24 + 2)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/250) + pi*mms:c74*sin(t/5 - y)*cos(2*pi*x)/100 + (-mms:c134 + mms:c159)*(mms:c24 + 2)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c29*(3/4 - mms:c27)
source = -mms:c110*(pi*mms:c178*(3/4 - mms:c27) + pi*mms:c29*mms:c90) + mms:c115*(9*mms:c141*mms:c29/(400*mms:c137) + 9*mms:c141*(3/4 - mms:c27)/(1000*mms:c137) + 3*mms:c29*(3/4 - mms:c27)*(-3*mms:c141/200 + 3*pi*sin(t/5 + z)/125)/mms:c137^2) + mms:c129*(9*mms:c120*mms:c29/(400*mms:c137) + 9*mms:c120*(3/4 - mms:c27)/(1000*mms:c137) + 3*mms:c145*mms:c29*(3/4 - mms:c27)/mms:c137^2) + pi*mms:c148*mms:c74 - mms:c156*(mms:c32 - 1/2) + mms:c164*mms:c18 + mms:c170*mms:c18 + pi*mms:c177*mms:c29^2 + pi*mms:c179*mms:c29*(3/4 - mms:c27) + mms:c29*(mms:c177 - mms:c90) + mms:c62*(3*mms:c120*mms:c29/400 + 3*mms:c120*(3/4 - mms:c27)/1000) + (3/4 - mms:c27)*(mms:c150 - mms:c178)
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c31*(mms:c10 - mms:c32 + 3/2)
source = -mms:c110*(pi*mms:c189*(mms:c10 - mms:c32 + 3/2) + mms:c31*(-3*pi*sin(t/5 + z)/500 + pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)) - pi*mms:c188*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32)) + 2*mms:c31*((-mms:c195 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c23*(mms:c10 + 1) + mms:c29*(1/2 - mms:c32))/(mms:c10 - mms:c32 + 3/2)^2 + (mms:c136 + pi*mms:c150*(1/2 - mms:c32) + mms:c195*mms:c29)/(mms:c10 - mms:c32 + 3/2))*(mms:c10 - mms:c32 + 3/2)/3 + mms:c31*(mms:c136 + pi*mms:c150*(1/2 - mms:c32) + mms:c195*mms:c29) + mms:c31*(-mms:c187 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + mms:c62*(mms:c31*(mms:c120/200 - pi*sin(2*pi*x)*cos(t/5 - y)/100) + pi*(mms:c10 - mms:c32 + 3/2)*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/100) + (mms:c188 - mms:c189)*(mms:c10 - mms:c32 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -pi^2*mms:c40/10 - mms:c46 - mms:c51
source = where(x*(1-x),-pi^2*mms:c102*(-2*pi^2*mms:c100*sin(t/5 - z)^2/1025 + 2*pi^2*mms:c100*cos(t/5 - z)^2/1025 - 32*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425)/50 - pi^2*mms:c102*((-42*pi^2*cos(pi*x)/25 + 567*pi^2*cos(3*pi*x)/25 - 21*pi^2*cos(5*pi*x))*sin(t/5 - z)^2/41 - 2*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425 - 128*pi^2*cos(pi*x)/7175 + 1782*pi^2*cos(3*pi*x)/7175 - 10*pi^2*cos(5*pi*x)/41)/50 - mms:c197*mms:c48 + mms:c48*sin(t/5 + y)*sin(t/5 - z)/2500 + pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/50 + 2*pi^2*(cos(t/5 + y)/1000 + 1/50)*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*cos(t/5 - z)/125 - pi^2*(-1100*cos(2*pi*x)/287 + cos(4*pi*x) + 1100/287)*sin(t/5 + y)*sin(t/5 - z)/62500 - pi^2*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/2500,0)

[Eion]
solution = 3*mms:c18*mms:c74/2 + mms:c23^2*(mms:c10 + 1) + mms:c29^2*(3/8 - mms:c71) + mms:c59^2 + 3*mms:c74*(mms:c10 + 1)/2 + (mms:c62 + pi*mms:c64/5)^2
