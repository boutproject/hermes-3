# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0.1/(2*units:meters^2)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = baseline
c9 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/400 + cos(2*pi*x)/20 + 1
c10 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + cos(2*pi*x)/80 + 1/4
c16 = -sin(t/5 - y)/1000 - sin(3*t/5 - 3*y)/9000
c17 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/200 + cos(2*pi*x)/10 + 2
c22 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 3*cos(2*pi*x)/80 + 3/4
c23 = mms:c22*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c31 = -pi^2*(1 - cos(2*pi*x))^2/25 + 2*pi^2*(-(cos(2*pi*x) - 1)*cos(2*pi*x) + sin(2*pi*x)^2)/25
c33 = -mms:c31*sin(t/5 - z)/pi + 2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/95 + 4
c41 = (cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)^2
c42 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 3*cos(2*pi*x)/160 + 3/8
c46 = 57*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 19*cos(2*pi*x)/160 + 19/8
c49 = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/25 + cos(t/5 - y)/125 + 12/5
c57 = pi*cos(t/5 - y)/5000 + pi*cos(3*t/5 - 3*y)/15000
c58 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 11*cos(2*pi*x)/80 + 11/4
c60 = pi^2*(1 - cos(2*pi*x))^4*sin(t/5 - z)^2
c65 = pi^2*(1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)
c68 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(t/5 - z)
c73 = 2*mms:c68*(-33*mms:c68/4000 + 11*pi*sin(2*pi*x)/400)/(125*mms:c58^2)
c77 = -pi*sin(t/5 + y)/5000 + pi*sin(3*t/5 + 3*y)/15000
c78 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 11*cos(2*pi*x)/40 + 11/2
c86 = 3*mms:c68*(-33*mms:c68/2000 + 11*pi*sin(2*pi*x)/200)/125
c89 = pi*cos(t/5 - y)/2500 + pi*cos(3*t/5 - 3*y)/7500
c92 = -pi*sin(t/5 + y)/2500 + pi*sin(3*t/5 + 3*y)/7500
c94 = (mms:c57*mms:c9 + mms:c77*(3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + cos(2*pi*x)/40 + 1/2))/(9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 3*cos(2*pi*x)/40 + 3/2)
c96 = 9*mms:c41*(1 - cos(2*pi*x))^2*sin(t/5 - z)/16000
c97 = 3*mms:c16^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000
c98 = mms:c42*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c101 = -3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/250 - 3*sin(t/5 - y)/1250
c114 = 2*(mms:c16^2*mms:c9 + 5*mms:c49*mms:c9/(2*mms:c46))/mms:c58 + 3*(5*mms:c10*mms:c49/(2*mms:c46) + mms:c41*mms:c42)/(2*mms:c58)
c116 = pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c58^2
c118 = pi*mms:c49*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c46
c119 = 57*pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/6400
c120 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*sin(t/5 - z)/25
total_pressure = mms:c10*mms:c49/mms:c46 + mms:c49*mms:c9/mms:c46
pressure_i = mms:c49*mms:c9/mms:c46
pressure_j = mms:c10*mms:c49/mms:c46
ion_temperature = mms:c49/mms:c46
potential = 0
pressure_potential = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/50 + cos(t/5 - y)/250 + 6/5
current_potential = (1 - cos(2*pi*x))^2*cos(t/5 - z)/100

[Ni]
solution = mms:c9
source = mms:c57*mms:c9 - mms:c73*mms:c9 - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000 - 3*mms:c60/(250000*mms:c58) - 2*mms:c65*mms:c9/(625*mms:c58) - 2*mms:c68*(3*mms:c68/1000 - pi*sin(2*pi*x)/100)/(125*mms:c58) + pi^2*mms:c9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(625*mms:c58) - 2*pi^2*mms:c9*sin(2*pi*x)^2*cos(t/5 - z)/(625*mms:c58) + 33*pi^2*mms:c9*(1 - cos(2*pi*x))^4*sin(t/5 - z)^2/(1000000*mms:c58^2)
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c10
source = -3*mms:c10*mms:c65/(625*mms:c78) + mms:c10*mms:c77 + 3*pi^2*mms:c10*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(1250*mms:c78) - 3*pi^2*mms:c10*sin(2*pi*x)^2*cos(t/5 - z)/(625*mms:c78) - mms:c10*mms:c86/mms:c78^2 + 99*pi^2*mms:c10*(1 - cos(2*pi*x))^4*sin(t/5 - z)^2/(1000000*mms:c78^2) - 9*mms:c60/(2000000*mms:c78) - 3*mms:c68*(3*mms:c68/4000 - pi*sin(2*pi*x)/400)/(125*mms:c78) - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/8000
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c16*mms:c17
source = -mms:c16*mms:c17*mms:c73 + mms:c16*mms:c17*mms:c89 - 2*mms:c16*mms:c17*mms:c65/(625*mms:c58) + pi^2*mms:c16*mms:c17*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(625*mms:c58) - 2*pi^2*mms:c16*mms:c17*sin(2*pi*x)^2*cos(t/5 - z)/(625*mms:c58) + 33*pi^2*mms:c16*mms:c17*(1 - cos(2*pi*x))^4*sin(t/5 - z)^2/(1000000*mms:c58^2) - 3*mms:c16*(1 - cos(2*pi*x))^2*sin(t/5 - z)/1000 - 3*mms:c16*mms:c60/(125000*mms:c58) - 2*mms:c16*mms:c68*(3*mms:c68/500 - pi*sin(2*pi*x)/50)/(125*mms:c58) + mms:c17*(-cos(t/5 - y)/5000 - cos(3*t/5 - 3*y)/15000) + pi*mms:c9*sin(t/5 - y)/(625*mms:c46)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c23
source = pi*mms:c10*sin(t/5 - y)/(625*mms:c46) + mms:c22*mms:c92*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000) + mms:c22*(-sin(t/5 + y)/5000 + sin(3*t/5 + 3*y)/15000) + 3*pi^2*mms:c22*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*cos(t/5 - z)/(1250*mms:c78) + 99*pi^2*mms:c22*(1 - cos(2*pi*x))^4*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*sin(t/5 - z)^2/(1000000*mms:c78^2) - 3*mms:c23*mms:c65/(625*mms:c78) - 3*pi^2*mms:c23*sin(2*pi*x)^2*cos(t/5 - z)/(625*mms:c78) - mms:c23*mms:c86/mms:c78^2 - 27*mms:c60*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)/(2000000*mms:c78) - 3*mms:c68*(9*mms:c68/4000 - 3*pi*sin(2*pi*x)/400)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)/(125*mms:c78) - 9*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*sin(t/5 - z)/8000
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c33
source = -mms:c31*cos(t/5 - z)/(5*pi) + mms:c33*mms:c94 - mms:c94*(2*mms:c31*sin(t/5 - z)/(3*pi) - 4*(1 - cos(2*pi*x))^2*sin(t/5 - z)/285 - 8/3) + 2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/475
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = pi^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/625 - 2*pi^2*(1 - cos(2*pi*x))*sin(t/5 - z)*cos(2*pi*x)/625 - 2*pi^2*sin(2*pi*x)^2*sin(t/5 - z)/625
source = where(x*(1-x),7*pi^2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/6250 - 7*pi^2*(1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)/3125 - 7*pi^2*sin(2*pi*x)^2*cos(t/5 - z)/3125,0)

[Eion]
solution = 3*mms:c10*mms:c49/(2*mms:c46) + mms:c16^2*mms:c9 + mms:c41*mms:c42 + pi^2*(1 - cos(2*pi*x))^4*cos(t/5 - z)^2/62500 + pi^2*(1 - cos(2*pi*x))^2*sin(2*pi*x)^2*sin(t/5 - z)^2/15625 + 3*mms:c49*mms:c9/(2*mms:c46)
source = mms:c10*mms:c101/mms:c46 + 171*mms:c10*mms:c49*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c46^2) + mms:c101*mms:c9/mms:c46 + pi^2*mms:c114*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1250 - pi^2*mms:c114*(1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)/625 - pi^2*mms:c114*sin(2*pi*x)^2*cos(t/5 - z)/625 + mms:c16*mms:c9*(-cos(t/5 - y)/2500 - cos(3*t/5 - 3*y)/7500) + mms:c16*(mms:c16*mms:c89*mms:c9 + pi*mms:c9*sin(t/5 - y)/(250*mms:c46)) + mms:c57*(mms:c16^2*mms:c9 + 5*mms:c49*mms:c9/(2*mms:c46)) - mms:c68*(3*(-mms:c10*mms:c120/mms:c46 + mms:c10*mms:c49*(-57*mms:c68/3200 + 19*pi*sin(2*pi*x)/320)/mms:c46^2 + mms:c41*(9*mms:c68/8000 - 3*pi*sin(2*pi*x)/800) + 5*mms:c49*(3*mms:c68/4000 - pi*sin(2*pi*x)/400)/(2*mms:c46))/(2*mms:c58) + 2*(-mms:c120*mms:c9/mms:c46 + mms:c16^2*(3*mms:c68/1000 - pi*sin(2*pi*x)/100) + 5*mms:c49*(3*mms:c68/1000 - pi*sin(2*pi*x)/100)/(2*mms:c46) + mms:c49*mms:c9*(-57*mms:c68/3200 + 19*pi*sin(2*pi*x)/320)/mms:c46^2)/mms:c58 + 2*(-33*mms:c68/4000 + 11*pi*sin(2*pi*x)/400)*(mms:c16^2*mms:c9 + 5*mms:c49*mms:c9/(2*mms:c46))/mms:c58^2 + 3*(-33*mms:c68/4000 + 11*pi*sin(2*pi*x)/400)*(5*mms:c10*mms:c49/(2*mms:c46) + mms:c41*mms:c42)/(2*mms:c58^2))/125 + mms:c77*(5*mms:c10*mms:c49/(2*mms:c46) + mms:c41*mms:c42) - mms:c96 - mms:c97 + mms:c98*(-sin(t/5 + y)/2500 + sin(3*t/5 + 3*y)/7500) - pi^2*(1 - cos(2*pi*x))^4*sin(t/5 - z)*cos(t/5 - z)/156250 - pi*(1 - cos(2*pi*x))^2*(-33*mms:c116*(mms:c16^2*mms:c9 + 5*mms:c49*mms:c9/(2*mms:c46))/4000 - 99*mms:c116*(5*mms:c10*mms:c49/(2*mms:c46) + mms:c41*mms:c42)/16000 + 2*(3*mms:c118/800 - mms:c119*mms:c49*mms:c9/mms:c46^2 + pi*mms:c97 + pi*mms:c9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c46))/mms:c58 + 3*(-mms:c10*mms:c119*mms:c49/mms:c46^2 + pi*mms:c10*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c46) + 3*mms:c118/3200 + pi*mms:c96)/(2*mms:c58))*sin(t/5 - z)/250 + 2*pi^2*(1 - cos(2*pi*x))^2*sin(2*pi*x)^2*sin(t/5 - z)*cos(t/5 - z)/78125 + (pi*mms:c10*sin(t/5 - y)/(250*mms:c46) + mms:c92*mms:c98)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000) - 9*mms:c49*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(3200*mms:c46) + 171*mms:c49*mms:c9*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c46^2)
bndry_xin = dirichlet_o2(Eion:solution)
bndry_xout = dirichlet_o2(Eion:solution)
