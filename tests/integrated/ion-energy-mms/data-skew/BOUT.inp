# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 17/16
g12 = 0
g13 = 1/4
g23 = 0
g_11 = 17/16
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = -1/4
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0.1/(2*units:meters^2)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false
polarisation_ac_boundary = dirichlet

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = skew
c9 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/400 + cos(2*pi*x)/20 + 1
c10 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + cos(2*pi*x)/80 + 1/4
c16 = -sin(t/5 - y)/1000 - sin(3*t/5 - 3*y)/9000
c17 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/200 + cos(2*pi*x)/10 + 2
c22 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 3*cos(2*pi*x)/80 + 3/4
c23 = mms:c22*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c29 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(t/5 - z)
c33 = -17*pi^2*(1 - cos(2*pi*x))^2/400 + 2*pi^2*(-(cos(2*pi*x) - 1)*cos(2*pi*x) + sin(2*pi*x)^2)/25
c35 = mms:c29/25 - mms:c33*sin(t/5 - z)/pi + 2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/95 + 4
c41 = (cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)^2
c42 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 3*cos(2*pi*x)/160 + 3/8
c47 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*sin(t/5 - z)
c48 = -mms:c47/500 + 17*pi*(1 - cos(2*pi*x))^2*cos(t/5 - z)/4000
c51 = -mms:c47/125 + pi*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1000
c52 = 57*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 19*cos(2*pi*x)/160 + 19/8
c55 = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/25 + cos(t/5 - y)/125 + 12/5
c63 = pi*cos(t/5 - y)/5000 + pi*cos(3*t/5 - 3*y)/15000
c65 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 11*cos(2*pi*x)/80 + 11/4
c68 = -mms:c29/500 - 17*pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/4000
c70 = pi*mms:c68*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c65
c72 = -mms:c29/125 - pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/1000
c75 = pi^2*(1 - cos(2*pi*x))*sin(2*pi*x)*sin(t/5 - z)
c77 = -mms:c75/2500 + 17*pi^2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/20000
c80 = 33*pi*mms:c68*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(4000*mms:c65^2)
c82 = -mms:c75/2500 - pi^2*(1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)/625 - pi^2*sin(2*pi*x)^2*cos(t/5 - z)/625
c85 = 2*mms:c72*(-33*mms:c29/4000 + 11*pi*sin(2*pi*x)/400)/mms:c65^2
c89 = -pi*sin(t/5 + y)/5000 + pi*sin(3*t/5 + 3*y)/15000
c90 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 11*cos(2*pi*x)/40 + 11/2
c92 = pi*mms:c68*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c90
c99 = 99*pi*mms:c68*(1 - cos(2*pi*x))^2*sin(t/5 - z)/4000
c106 = pi*cos(t/5 - y)/2500 + pi*cos(3*t/5 - 3*y)/7500
c109 = -pi*sin(t/5 + y)/2500 + pi*sin(3*t/5 + 3*y)/7500
c113 = 1/(9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 3*cos(2*pi*x)/40 + 3/2)
c114 = mms:c63*mms:c9 + mms:c89*(3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + cos(2*pi*x)/40 + 1/2)
c116 = 3*mms:c16^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000
c117 = mms:c42*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c120 = -3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/250 - 3*sin(t/5 - y)/1250
c129 = 2*(mms:c16^2*mms:c9 + 5*mms:c55*mms:c9/(2*mms:c52))/mms:c65 + 3*(5*mms:c10*mms:c55/(2*mms:c52) + mms:c41*mms:c42)/(2*mms:c65)
c130 = pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c65^2
c132 = pi*mms:c55*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c52
c133 = 57*pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/6400
total_pressure = mms:c10*mms:c55/mms:c52 + mms:c55*mms:c9/mms:c52
pressure_i = mms:c55*mms:c9/mms:c52
pressure_j = mms:c10*mms:c55/mms:c52
ion_temperature = mms:c55/mms:c52
potential = 0
pressure_potential = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/50 + cos(t/5 - y)/250 + 6/5
current_potential = (1 - cos(2*pi*x))^2*cos(t/5 - z)/100

[Ni]
solution = mms:c9
source = mms:c63*mms:c9 + 3*mms:c70/1000 - mms:c80*mms:c9 + mms:c85*mms:c9 - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000 + 2*mms:c72*(3*mms:c29/1000 - pi*sin(2*pi*x)/100)/mms:c65 + 2*mms:c77*mms:c9/mms:c65 + 2*mms:c82*mms:c9/mms:c65
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c10
source = 3*mms:c10*mms:c72*(-33*mms:c29/2000 + 11*pi*sin(2*pi*x)/200)/mms:c90^2 + 3*mms:c10*mms:c77/mms:c90 + 3*mms:c10*mms:c82/mms:c90 + mms:c10*mms:c89 - mms:c10*mms:c99/mms:c90^2 + 3*mms:c72*(3*mms:c29/4000 - pi*sin(2*pi*x)/400)/mms:c90 + 9*mms:c92/8000 - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/8000
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c16*mms:c17
source = mms:c106*mms:c16*mms:c17 - mms:c16*mms:c17*mms:c80 + mms:c16*mms:c17*mms:c85 + 2*mms:c16*mms:c17*mms:c77/mms:c65 + 2*mms:c16*mms:c17*mms:c82/mms:c65 + 3*mms:c16*mms:c70/500 - 3*mms:c16*(1 - cos(2*pi*x))^2*sin(t/5 - z)/1000 + 2*mms:c16*mms:c72*(3*mms:c29/500 - pi*sin(2*pi*x)/50)/mms:c65 + mms:c17*(-cos(t/5 - y)/5000 - cos(3*t/5 - 3*y)/15000) + pi*mms:c9*sin(t/5 - y)/(625*mms:c52)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c23
source = pi*mms:c10*sin(t/5 - y)/(625*mms:c52) + mms:c109*mms:c23 + mms:c22*(-sin(t/5 + y)/5000 + sin(3*t/5 + 3*y)/15000) + 3*mms:c23*mms:c72*(-33*mms:c29/2000 + 11*pi*sin(2*pi*x)/200)/mms:c90^2 + 3*mms:c23*mms:c77/mms:c90 + 3*mms:c23*mms:c82/mms:c90 - mms:c23*mms:c99/mms:c90^2 + 3*mms:c72*(9*mms:c29/4000 - 3*pi*sin(2*pi*x)/400)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)/mms:c90 + 27*mms:c92*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)/8000 - 9*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*sin(t/5 - z)/8000
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c35
source = mms:c113*mms:c114*mms:c35 - mms:c113*mms:c114*(-2*mms:c29/75 + 2*mms:c33*sin(t/5 - z)/(3*pi) - 4*(1 - cos(2*pi*x))^2*sin(t/5 - z)/285 - 8/3) - mms:c33*cos(t/5 - z)/(5*pi) - mms:c47/125 + 2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/475
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = 17*pi^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/10000 + pi^2*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(t/5 - z)/625 - 2*pi^2*(1 - cos(2*pi*x))*sin(t/5 - z)*cos(2*pi*x)/625 - 2*pi^2*sin(2*pi*x)^2*sin(t/5 - z)/625
source = where(x*(1-x),-7*mms:c75/6250 + 119*pi^2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/100000 - 7*pi^2*(1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)/3125 - 7*pi^2*sin(2*pi*x)^2*cos(t/5 - z)/3125,0)

[Eion]
solution = 3*mms:c10*mms:c55/(2*mms:c52) + mms:c16^2*mms:c9 + mms:c41*mms:c42 - mms:c47*mms:c51/125 + pi*mms:c48*(1 - cos(2*pi*x))^2*cos(t/5 - z)/250 + 3*mms:c55*mms:c9/(2*mms:c52)
source = mms:c10*mms:c120/mms:c52 + 171*mms:c10*mms:c55*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c52^2) - mms:c116 + mms:c117*(-sin(t/5 + y)/2500 + sin(3*t/5 + 3*y)/7500) + mms:c120*mms:c9/mms:c52 + mms:c129*mms:c77 + mms:c129*mms:c82 + mms:c16*mms:c9*(-cos(t/5 - y)/2500 - cos(3*t/5 - 3*y)/7500) + mms:c16*(mms:c106*mms:c16*mms:c9 + pi*mms:c9*sin(t/5 - y)/(250*mms:c52)) - mms:c29*mms:c51/625 - 9*mms:c41*(1 - cos(2*pi*x))^2*sin(t/5 - z)/16000 - mms:c47*(-mms:c29/625 - pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/5000)/125 - pi*mms:c48*(1 - cos(2*pi*x))^2*sin(t/5 - z)/1250 + mms:c63*(mms:c16^2*mms:c9 + 5*mms:c55*mms:c9/(2*mms:c52)) + mms:c68*(-33*mms:c130*(mms:c16^2*mms:c9 + 5*mms:c55*mms:c9/(2*mms:c52))/4000 - 99*mms:c130*(5*mms:c10*mms:c55/(2*mms:c52) + mms:c41*mms:c42)/16000 + 2*(pi*mms:c116 + 3*mms:c132/800 - mms:c133*mms:c55*mms:c9/mms:c52^2 + pi*mms:c9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c52))/mms:c65 + 3*(-mms:c10*mms:c133*mms:c55/mms:c52^2 + pi*mms:c10*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c52) + 3*mms:c132/3200 + 9*pi*mms:c41*(1 - cos(2*pi*x))^2*sin(t/5 - z)/16000)/(2*mms:c65)) + mms:c72*(2*(mms:c16^2*(3*mms:c29/1000 - pi*sin(2*pi*x)/100) - mms:c47*mms:c9/(25*mms:c52) + 5*mms:c55*(3*mms:c29/1000 - pi*sin(2*pi*x)/100)/(2*mms:c52) + mms:c55*mms:c9*(-57*mms:c29/3200 + 19*pi*sin(2*pi*x)/320)/mms:c52^2)/mms:c65 + 3*(-mms:c10*mms:c47/(25*mms:c52) + mms:c10*mms:c55*(-57*mms:c29/3200 + 19*pi*sin(2*pi*x)/320)/mms:c52^2 + mms:c41*(9*mms:c29/8000 - 3*pi*sin(2*pi*x)/800) + 5*mms:c55*(3*mms:c29/4000 - pi*sin(2*pi*x)/400)/(2*mms:c52))/(2*mms:c65) + 2*(-33*mms:c29/4000 + 11*pi*sin(2*pi*x)/400)*(mms:c16^2*mms:c9 + 5*mms:c55*mms:c9/(2*mms:c52))/mms:c65^2 + 3*(-33*mms:c29/4000 + 11*pi*sin(2*pi*x)/400)*(5*mms:c10*mms:c55/(2*mms:c52) + mms:c41*mms:c42)/(2*mms:c65^2)) + mms:c89*(5*mms:c10*mms:c55/(2*mms:c52) + mms:c41*mms:c42) + pi*(1 - cos(2*pi*x))^2*(-mms:c29/2500 - 17*pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/20000)*cos(t/5 - z)/250 + (pi*mms:c10*sin(t/5 - y)/(250*mms:c52) + mms:c109*mms:c117)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000) - 9*mms:c55*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(3200*mms:c52) + 171*mms:c55*mms:c9*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c52^2)
bndry_xin = dirichlet_o2(Eion:solution)
bndry_xout = dirichlet_o2(Eion:solution)
