# Template; regenerate committed variants using python mms.py --all.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 17/16
g12 = 0
g13 = 1/4
g23 = 0
g_11 = 17/16
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = -1/4
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[polarisation_drift]
implementation = conservative
polarisation_ac_boundary = dirichlet

[mms]
variant = skew
c9 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c17 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c22 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c23 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c26 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 3/4
c27 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c29 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c30 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c37 = ((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)
c40 = pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c44 = pi^2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)
c49 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c56 = pi*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)
c58 = -3*mms:c56*sin(t/5 - z)/20 + 17*pi*((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/80
c62 = -3*mms:c56*sin(t/5 - z)/5 + pi*((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/20
c63 = -2*mms:c37*sin(t/5 - z) + 2*cos(t/5 - y)/25 + 12/5
c74 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c76 = pi*mms:c22*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c74*(mms:c9 + 1)
c80 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c82 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c85 = mms:c80 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c87 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c89 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c92 = ((1 - cos(2*pi*x))^3 + 1)*sin(t/5 + y)*sin(t/5 - z)
c93 = (pi*mms:c92/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c23 - mms:c49 + 19/8)
c95 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c98 = mms:c63*(-pi*mms:c95 - pi*sin(t/5 - y)*cos(2*pi*x)/50)/(mms:c23 - mms:c49 + 19/8)^2
c100 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c101 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c105 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c106 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c110 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c114 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c116 = pi*((1 - cos(2*pi*x))^3 + 1)*sin(t/5 + y)*cos(t/5 - z)
c118 = 3*pi*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*cos(t/5 - z)/25
c121 = (-2*mms:c37*cos(t/5 - z)/5 + ((1 - cos(2*pi*x))^3 + 1)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c23 - mms:c49 + 19/8)
total_pressure = mms:c17*mms:c63/(mms:c23 - mms:c49 + 19/8) + mms:c63*(mms:c9 + 1)/(mms:c23 - mms:c49 + 19/8)
pressure_i = mms:c63*(mms:c9 + 1)/(mms:c23 - mms:c49 + 19/8)
pressure_j = mms:c17*mms:c63/(mms:c23 - mms:c49 + 19/8)
ion_temperature = mms:c63/(mms:c23 - mms:c49 + 19/8)
potential = 0
pressure_potential = -mms:c37*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5
current_potential = 0

[Ni]
solution = mms:c9 + 1
source = mms:c76 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c17
source = pi*mms:c17*mms:c82 + pi*mms:c27*mms:c80 + mms:c85
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c22*(mms:c23 + 2)
source = pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/50 - mms:c22*mms:c87 + pi*mms:c22*mms:c89*(mms:c23 + 2) + pi*mms:c63*sin(t/5 - y)*cos(2*pi*x)/(100*(mms:c23 - mms:c49 + 19/8)) + mms:c93*(mms:c9 + 1) + mms:c98*(mms:c9 + 1) + (mms:c23 + 2)*(-mms:c74 + sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c26*mms:c27
source = pi*mms:c100*mms:c27^2 + pi*mms:c101*mms:c26*mms:c27 + mms:c17*mms:c93 + mms:c17*mms:c98 + mms:c26*(mms:c82 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000) + mms:c27*(mms:c100 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400) + pi*mms:c63*mms:c80/(mms:c23 - mms:c49 + 19/8)
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c29*(-mms:c30 + mms:c9 + 3/2)
source = -pi*mms:c106*(mms:c22*(mms:c9 + 1) + mms:c27*(1/2 - mms:c30)) + 2*mms:c29*((-mms:c110 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c22*(mms:c9 + 1) + mms:c27*(1/2 - mms:c30))/(-mms:c30 + mms:c9 + 3/2)^2 + (mms:c110*mms:c27 + mms:c76 + pi*mms:c82*(1/2 - mms:c30))/(-mms:c30 + mms:c9 + 3/2))*(-mms:c30 + mms:c9 + 3/2)/3 + mms:c29*(-mms:c105 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + mms:c29*(mms:c110*mms:c27 + mms:c76 + pi*mms:c82*(1/2 - mms:c30)) + (mms:c106 - cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100)*(-mms:c30 + mms:c9 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = 17*pi^2*mms:c37*sin(t/5 - z)/200 - 6*mms:c40*(1 - cos(2*pi*x))^2*cos(2*pi*x)/25 - 12*mms:c40*(1 - cos(2*pi*x))*sin(2*pi*x)^2/25 + 3*mms:c44*(1 - cos(2*pi*x))^2*sin(2*pi*x)/25
source = where(x*(1-x),-3*mms:c40*(1 - cos(2*pi*x))^2*sin(2*pi*x)/125 - 6*mms:c44*(1 - cos(2*pi*x))^2*cos(2*pi*x)/125 - 12*mms:c44*(1 - cos(2*pi*x))*sin(2*pi*x)^2/125 - 17*pi^2*mms:c92/1000000 - 3*pi^2*(1 - cos(2*pi*x))^2*sin(2*pi*x)*sin(t/5 + y)*cos(t/5 - z)/125000 + 3*pi^2*(1 - cos(2*pi*x))^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/62500 + 3*pi^2*(1 - cos(2*pi*x))*sin(2*pi*x)^2*sin(t/5 + y)*sin(t/5 - z)/31250 + 17*pi^2*((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/1000,0)

[Eion]
solution = 3*mms:c17*mms:c63/(2*(mms:c23 - mms:c49 + 19/8)) + mms:c22^2*(mms:c9 + 1) + mms:c27^2*(3/8 - mms:c49) + pi*mms:c37*mms:c58*cos(t/5 - z)/5 - 3*mms:c56*mms:c62*sin(t/5 - z)/5 + 3*mms:c63*(mms:c9 + 1)/(2*(mms:c23 - mms:c49 + 19/8))
source = -mms:c105*mms:c22^2 - 3*mms:c105*mms:c63/(2*(mms:c23 - mms:c49 + 19/8)) - mms:c116*mms:c58/25000 - mms:c118*mms:c62 + 3*mms:c121*mms:c17/2 + mms:c121*(3*mms:c9/2 + 3/2) + 3*mms:c17*mms:c63*(mms:c114 + mms:c87 - mms:c95)/(2*(mms:c23 - mms:c49 + 19/8)^2) + mms:c22*(-mms:c89 + sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125)*(mms:c9 + 1) + mms:c22*(pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c22*mms:c89*(mms:c9 + 1) + pi*mms:c63*sin(t/5 - y)*cos(2*pi*x)/(40*(mms:c23 - mms:c49 + 19/8)) + 5*mms:c93*(mms:c9 + 1)/2 + 5*mms:c98*(mms:c9 + 1)/2) + mms:c27^2*(-mms:c114 + mms:c95) + mms:c27*(3/8 - mms:c49)*(mms:c101 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500) + mms:c27*(pi*mms:c101*mms:c27*(3/8 - mms:c49) + 5*mms:c17*mms:c93/2 + 5*mms:c17*mms:c98/2 + pi*mms:c27^2*mms:c95 + pi*mms:c63*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/(160*(mms:c23 - mms:c49 + 19/8))) - pi*mms:c37*mms:c58*sin(t/5 - z)/25 + pi*mms:c37*(-17*mms:c116/400000 - 17*pi*mms:c37*sin(t/5 - z)/400 - 3*mms:c56*cos(t/5 - z)/100 + 3*pi*(1 - cos(2*pi*x))^2*sin(2*pi*x)*sin(t/5 + y)*sin(t/5 - z)/100000)*cos(t/5 - z)/5 - 3*mms:c56*(-mms:c116/100000 - mms:c118 - pi*mms:c37*sin(t/5 - z)/100 + 3*pi*(1 - cos(2*pi*x))^2*sin(2*pi*x)*sin(t/5 + y)*sin(t/5 - z)/25000)*sin(t/5 - z)/5 + 3*pi*mms:c62*(1 - cos(2*pi*x))^2*sin(2*pi*x)*sin(t/5 + y)*sin(t/5 - z)/25000 + 3*mms:c63*mms:c85/(2*(mms:c23 - mms:c49 + 19/8)) + mms:c63*(3*mms:c9/2 + 3/2)*(mms:c114 + mms:c87 - mms:c95)/(mms:c23 - mms:c49 + 19/8)^2 + pi*mms:c74*(mms:c22^2*(mms:c9 + 1) + 5*mms:c63*(mms:c9 + 1)/(2*(mms:c23 - mms:c49 + 19/8))) + pi*mms:c82*(5*mms:c17*mms:c63/(2*(mms:c23 - mms:c49 + 19/8)) + mms:c27^2*(3/8 - mms:c49))
bndry_xin = dirichlet_o2(Eion:solution)
bndry_xout = dirichlet_o2(Eion:solution)
