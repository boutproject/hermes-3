#!/usr/bin/env python3
"""Optional 3D continuum MMS spatial, temporal and MPI convergence study."""

import sys
from pathlib import Path

import numpy as np
import xhermes

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(Path(__file__).resolve().parent))
from analyse import check_recovery, errors, fields, norms, save_convergence
from ion_energy_test import launch, parser
from mms import generate

cli = parser(__doc__)
cli.add_argument("--levels", type=int, default=2)
cli.add_argument("--verify", action="store_true")
args = cli.parse_args()
if args.levels < 2:
    cli.error("At least two refinement levels are required")
template = args.output_root / "generated/BOUT.inp"
generate(template)
sizes = [8 * 2**level for level in range(args.levels)]
reports, runs, failures = {}, {}, []


def run(size, suffix="", *, tight=False, nproc=None):
    path = launch(
        args,
        f"{size}{suffix}",
        template,
        [
            f"mesh:nx={size + 4}",
            f"mesh:ny={2 * size}",
            f"mesh:nz={size}",
            "solver:atol=" + ("1e-14" if tight else "1e-12"),
            "solver:rtol=" + ("1e-12" if tight else "1e-10"),
            "solver:max_timestep=" + ("0.0005" if tight else "0.002"),
        ],
        nproc=nproc,
    )
    with xhermes.open(
        path, unnormalise=False, keep_xboundaries=False, keep_yboundaries=False
    ) as ds:
        ds = ds.load(scheduler="synchronous")
    check_recovery(ds)
    return ds


for index, size in enumerate(sizes):
    runs[size] = run(size)
    reports[size] = errors(runs[size])
    if index:
        for name, fine in reports[size].items():
            coarse = reports[sizes[index - 1]][name]
            for norm, minimum in (("l2_interior", 1.4), ("linf_interior", 0.9)):
                order = np.log2(coarse[norm] / fine[norm])
                print(f"{size} {name} {norm}: order {order:.3f}")
                if not np.isfinite(order) or order < minimum:
                    failures.append(f"{size}/{name}/{norm}: order {order:.3f}")
save_convergence(args.output_root, reports)
assert not failures, "Spatial convergence failed: " + ", ".join(failures)
if args.verify:
    size = sizes[1]
    tight = run(size, "-tight", tight=True)
    for name, field in fields(runs[size]).items():
        error = (field - fields(tight)[name]).isel(t=-1, drop=True)
        for norm, value in norms(runs[size].isel(t=-1, drop=True), error).items():
            assert value < max(1e-11, 0.05 * reports[size][name][norm]), (
                name,
                norm,
                "temporal",
            )
    size = sizes[0]
    other = run(size, "-decomposition", nproc=1 if args.nproc > 1 else 2)
    for name, field in fields(runs[size]).items():
        np.testing.assert_allclose(field, fields(other)[name], rtol=0, atol=1e-10)
print("Continuum MMS convergence passed")
