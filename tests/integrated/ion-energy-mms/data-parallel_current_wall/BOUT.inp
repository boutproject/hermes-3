# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true
use_div_par_fvv = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true
phi_dissipation = true

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
implementation = conservative
diagnose = true

[mms]
variant = parallel_current_wall
c13 = 3*sin(pi*x)^2*cos(t/5 + z)/100 + cos(2*pi*x)*cos(t/5 - y)/20
c21 = sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)
c28 = -sin(pi*x)^2*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c29 = 3*sin(pi*x)^2*cos(t/5 + z)/50 + cos(2*pi*x)*cos(t/5 - y)/10
c36 = -3*sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c38 = -sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c46 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c51 = (cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(2*pi*x)
c57 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c60 = mms:c57 - pi*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/5
c63 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c65 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)
c70 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c75 = (-2*mms:c70 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c21/160 + mms:c29 + 19/8)
c82 = mms:c36^2*(3/8 - 3*mms:c21/160) + 3*mms:c75*(1/4 - mms:c21/80)/2
c88 = mms:c28*(mms:c13 + 1)/1836 + mms:c36*(1/2 - mms:c21/40)/1836 + sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/61200
c97 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/500 - pi*sin(2*pi*x)*cos(t/5 - y)/100
c102 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c105 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c109 = (cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*cos(t/5 - z)
c122 = -pi^2*mms:c102*((-7*pi*sin(pi*x)/85 + 21*pi*sin(3*pi*x)/125)*sin(t/5 - z)^2 - pi*sin(pi*x)/17 + 27*pi*sin(3*pi*x)/125)/50 + mms:c105*mms:c60/50 - pi^2*mms:c46*(mms:c63 + pi*mms:c65/5)/25 + mms:c57*(mms:c105/50 + pi^2*mms:c109/25) + mms:c63*(-pi^2*mms:c46/25 + pi^2*mms:c70/25) + pi^3*(mms:c102*((4 - 4*cos(2*pi*x))*sin(pi*x)*cos(t/5 - z)^2 + (12*cos(2*pi*x) - 4)*sin(pi*x)*sin(t/5 - z)^2 + 2*sin(2*pi*x)*cos(pi*x)) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500 - 3*sin(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/200
c128 = pi*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c131 = pi^2*mms:c102*((-7*pi^2*cos(pi*x)/850 + 63*pi^2*cos(3*pi*x)/1250)*sin(t/5 - z)^2 - pi^2*cos(pi*x)/170 + 81*pi^2*cos(3*pi*x)/1250)/50
c132 = pi^3*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/500
c134 = mms:c57*(-mms:c132 + pi^3*(cos(t/5 + y)/1000 + 1/50)*cos(2*pi*x)*cos(t/5 - z)/125)
c135 = pi^3*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/250
c136 = mms:c63*(-mms:c135 + pi^3*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125)
c143 = 2*pi*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(t/5 - z)
c145 = mms:c105*(-pi^2*mms:c46/25 + pi^2*mms:c70/25)/50 + mms:c105*(-pi^2*mms:c46/100 - pi^2*mms:c51/25)/50 - 3*mms:c128/1000 - mms:c131 - mms:c132*mms:c60 + mms:c134 - mms:c135*(mms:c63 + pi*mms:c65/5) + mms:c136 - pi^2*mms:c46*(mms:c105/50 + pi^2*mms:c109/25)/20 + pi^3*(mms:c102*(pi*(4 - 4*cos(2*pi*x))*cos(pi*x)*cos(t/5 - z)^2/10 + pi*(12*cos(2*pi*x) - 4)*sin(t/5 - z)^2*cos(pi*x)/10 - 12*pi*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2/5 + 4*pi*sin(pi*x)*sin(2*pi*x)*cos(t/5 - z)^2/5 - pi*sin(pi*x)*sin(2*pi*x)/5 + 2*pi*cos(pi*x)*cos(2*pi*x)/5) + mms:c143)/500
c147 = (8*cos(2*pi*x) - 6)*cos(pi*x) + 3*sin(pi*x)*sin(2*pi*x)
c152 = pi^4*mms:c102*(14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*cos(t/5 - z)^2/625 - pi^4*(sin(t/5 + y)/50 + 1/5)*(14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)^2/625
c153 = -mms:c105*(-pi^2*mms:c46/25 + pi^2*mms:c70/25)/50 - mms:c105*(-pi^2*mms:c46/100 - pi^2*mms:c51/25)/50 - 3*mms:c128/1000 + mms:c132*mms:c60 - mms:c134 + mms:c135*(mms:c63 + pi*mms:c65/5) - mms:c136 - mms:c152 + pi^2*mms:c46*(mms:c105/50 + pi^2*mms:c109/25)/20 + pi^3*(-pi*mms:c102*mms:c147*sin(t/5 - z)^2/5 - mms:c143 + pi*mms:c147*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)^2/5)/500
c156 = pi^3*mms:c102*(14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*sin(t/5 - z)*cos(t/5 - z)/125 - mms:c105*(mms:c63 + pi*mms:c65/5)/50 + pi^2*mms:c46*mms:c60/100 - mms:c57*(-pi^2*mms:c46/100 - pi^2*mms:c51/25) - mms:c63*(mms:c105/50 + pi^2*mms:c109/25) + pi^3*(-mms:c102*mms:c147*sin(t/5 - z)*cos(t/5 - z) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500 + 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/200
c160 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c163 = (-3*pi*mms:c160/400 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c165 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/250 - pi*sin(2*pi*x)*cos(t/5 - y)/50
c167 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c168 = pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)
c170 = (-mms:c165 - 3*mms:c167/400 + 3*mms:c168/400)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c176 = mms:c128*(mms:c13 + 1)*sin(pi*x)^2/250 + pi*mms:c28*sin(t/5 - y)*cos(2*pi*x)/100
c177 = -3*mms:c21/40 + 3*sin(pi*x)^2*cos(t/5 + z)/25 + cos(2*pi*x)*cos(t/5 - y)/5 + 11/2
c187 = mms:c156*(3*pi*sin(pi*x)^2*sin(t/5 + z)/125 - 3*pi*sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)
c188 = mms:c122*(-3*pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/200 + 3*pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)/200 - 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/125 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c190 = sin(pi*x)^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c199 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c200 = 3*sin(pi*x)^2*sin(t/5 + z)/250 + sin(t/5 - y)*cos(2*pi*x)/50
c202 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c203 = mms:c202 - sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c207 = (1 - cos(2*pi*x))*sin(t/5 + y)*sin(t/5 - z)
c208 = (pi*mms:c207/2500 + 2*pi*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c214 = (-2*mms:c70 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c215 = mms:c214*(-3*pi*mms:c190/800 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c219 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c220 = pi*sin(pi*x)*sin(t/5 - y)*cos(pi*x)*cos(2*pi*x)*cos(t/5 - z)
c223 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)
c242 = 3*sin(pi*x)^2*sin(t/5 + z)/500 + sin(t/5 - y)*cos(2*pi*x)/100
c243 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c244 = 3*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/100
c247 = pi*sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c253 = mms:c176 + pi*mms:c190*mms:c36/200 + 3*pi*mms:c190*(1/2 - mms:c21/40)/1000
c255 = pi*mms:c190/200 + pi*sin(t/5 - y)*cos(2*pi*x)/100
c256 = -mms:c255*(mms:c244 + mms:c28*(mms:c13 + 1) + mms:c36*(1/2 - mms:c21/40))/(mms:c13 - mms:c21/40 + 3/2)^2
c265 = (-2*mms:c65/5 + (1 - cos(2*pi*x))*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c271 = 3*pi*mms:c28^2*sin(pi*x)^2*sin(t/5 + z)/500
c273 = -3*pi*mms:c160/800 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250
c281 = 3*pi*mms:c160*mms:c36^2/800 + 3*pi*mms:c160*mms:c36*(3/8 - 3*mms:c21/160)/500 + 3*pi*mms:c160*mms:c75/800 + mms:c214*mms:c273*(3/8 - 3*mms:c21/160) + 3*pi*mms:c65*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c282 = pi*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)
c285 = mms:c214*(3*mms:c13/2 + 3/2)*(-mms:c165 - 3*mms:c167/800 + 3*mms:c168/800) + mms:c28^2*mms:c97 + mms:c28*(mms:c13 + 1)*(mms:c219/125 - mms:c220/125) - 3*mms:c282*(mms:c13 + 1)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + 3*mms:c75*mms:c97/2
c286 = mms:c214*(3/8 - 3*mms:c21/160)*(-mms:c165 - 3*mms:c167/800 + 3*mms:c168/800) - 3*mms:c282*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c36^2*(3*mms:c167/800 - 3*mms:c168/800) + mms:c36*(3/8 - 3*mms:c21/160)*(3*mms:c167/500 - 3*mms:c168/500) + 3*mms:c75*(mms:c167/400 - mms:c168/400)/2
c289 = mms:c46 - mms:c70 + 3*mms:c82/(2*(-3*mms:c21/80 + mms:c29 + 11/4)) + 2*(mms:c28^2*(mms:c13 + 1) + 3*mms:c75*(mms:c13 + 1)/2)/(-3*mms:c21/80 + mms:c29 + 11/4) + cos(t/5 - y)/25 + 6/5
c292 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/306000
c293 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/306000
total_pressure = mms:c75*(1/4 - mms:c21/80) + mms:c75*(mms:c13 + 1)
pressure_i = mms:c75*(mms:c13 + 1)
pressure_j = mms:c75*(1/4 - mms:c21/80)
ion_temperature = mms:c75
potential = mms:c46
pressure_potential = -mms:c70 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c102*((14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*sin(t/5 - z)^2 + 10*cos(pi*x)/17 - 18*cos(3*pi*x)/25)/100 - 3*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/(80*pi)
electron_temperature = mms:c38
parallel_current = -mms:c244
parallel_current_divergence = 3*mms:c128/500

[Ve]
bndry_xin = neumann
bndry_xout = neumann

[Ni]
solution = mms:c13 + 1
source = mms:c122*mms:c170*(2*mms:c13 + 2) + 2*mms:c122*mms:c97/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c145*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c153*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c156*mms:c163*(2*mms:c13 + 2) - 3*pi*mms:c156*sin(pi*x)^2*sin(t/5 + z)/(250*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c176 + mms:c63*mms:c97 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - 3*sin(pi*x)^2*sin(t/5 + z)/500 - sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = 1/4 - mms:c21/80
source = 3*mms:c122*(mms:c167/400 - mms:c168/400)/mms:c177 + 3*mms:c145*(1/4 - mms:c21/80)/mms:c177 + 3*mms:c153*(1/4 - mms:c21/80)/mms:c177 + 3*pi*mms:c156*mms:c160/(400*mms:c177) - mms:c160/400 + pi*mms:c190*mms:c36/400 + 3*pi*mms:c190*(1/4 - mms:c21/80)/1000 + mms:c190/400 + mms:c63*(mms:c167/400 - mms:c168/400) - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000 + 3*mms:c187*(1/4 - mms:c21/80)/mms:c177^2 + 3*mms:c188*(1/4 - mms:c21/80)/mms:c177^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c28*(mms:c29 + 2)
source = 2*mms:c122*mms:c165*mms:c28/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c122*mms:c170*mms:c28*(mms:c29 + 2) + 2*mms:c122*(mms:c219/250 - mms:c220/250)*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c128*mms:c28*(mms:c29 + 2)*sin(pi*x)^2/125 + 2*mms:c145*mms:c28*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c153*mms:c28*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c156*mms:c163*mms:c28*(mms:c29 + 2) - pi*mms:c156*mms:c223*(mms:c29 + 2)/(125*(-3*mms:c21/80 + mms:c29 + 11/4)) - 3*pi*mms:c156*mms:c28*sin(pi*x)^2*sin(t/5 + z)/(125*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c199*(mms:c13 + 1) - mms:c200*mms:c28 + mms:c203*(mms:c29 + 2) + mms:c208*(mms:c13 + 1) + mms:c215*(mms:c13 + 1) + pi*mms:c28^2*sin(t/5 - y)*cos(2*pi*x)/50 - mms:c57*(-pi*mms:c202*(mms:c29 + 2) - 3*pi*mms:c28*sin(pi*x)^2*sin(t/5 + z)/250) + mms:c63*(mms:c165*mms:c28 + (mms:c219/250 - mms:c220/250)*(mms:c29 + 2)) + pi*mms:c75*sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c36*(3/4 - 3*mms:c21/80)
source = 3*mms:c122*mms:c36*(3*mms:c167/400 - 3*mms:c168/400)/mms:c177 + 3*mms:c122*(3/4 - 3*mms:c21/80)*(3*mms:c167/1000 - 3*mms:c168/1000)/mms:c177 + 3*mms:c145*mms:c36*(3/4 - 3*mms:c21/80)/mms:c177 + 3*mms:c153*mms:c36*(3/4 - 3*mms:c21/80)/mms:c177 + 9*pi*mms:c156*mms:c160*mms:c36/(400*mms:c177) + 9*pi*mms:c156*mms:c160*(3/4 - 3*mms:c21/80)/(1000*mms:c177) + 3*pi*mms:c190*mms:c36^2/400 + 3*pi*mms:c190*mms:c36*(3/4 - 3*mms:c21/80)/500 + pi*mms:c190*mms:c75/400 - mms:c199*(mms:c21/40 - 1/2) + mms:c208*(1/4 - mms:c21/80) + mms:c215*(1/4 - mms:c21/80) + mms:c36*(-3*mms:c160/400 + 3*mms:c190/400) - mms:c57*(3*pi*mms:c160*mms:c36/400 + 3*pi*mms:c160*(3/4 - 3*mms:c21/80)/1000) + mms:c63*(mms:c36*(3*mms:c167/400 - 3*mms:c168/400) + (3/4 - 3*mms:c21/80)*(3*mms:c167/1000 - 3*mms:c168/1000)) + (3/4 - 3*mms:c21/80)*(-3*mms:c160/1000 + 3*mms:c190/1000) + 3*mms:c187*mms:c36*(3/4 - 3*mms:c21/80)/mms:c177^2 + 3*mms:c188*mms:c36*(3/4 - 3*mms:c21/80)/mms:c177^2
bndry_xin = neumann
