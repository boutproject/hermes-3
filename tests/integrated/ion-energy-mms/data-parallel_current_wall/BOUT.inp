# Template; regenerate committed variants using python mms.py --all.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true
use_div_par_fvv = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true
phi_dissipation = true

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
implementation = conservative
diagnose = true

[mms]
variant = parallel_current_wall
c13 = 3*sin(pi*x)^2*cos(t/5 + z)/100 + cos(2*pi*x)*cos(t/5 - y)/20
c21 = sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)
c28 = -sin(pi*x)^2*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c29 = 3*sin(pi*x)^2*cos(t/5 + z)/50 + cos(2*pi*x)*cos(t/5 - y)/10
c36 = -3*sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c38 = -sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c46 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c51 = (cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(2*pi*x)
c57 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c60 = mms:c57 - pi*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/5
c63 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c65 = (2 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)
c70 = (2 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c75 = (-2*mms:c70 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c21/160 + mms:c29 + 19/8)
c82 = mms:c36^2*(3/8 - 3*mms:c21/160) + 3*mms:c75*(1/4 - mms:c21/80)/2
c88 = mms:c28*(mms:c13 + 1)/1836 + mms:c36*(1/2 - mms:c21/40)/1836 + sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/61200
c97 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/500 - pi*sin(2*pi*x)*cos(t/5 - y)/100
c100 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c104 = (cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*cos(t/5 - z)
c111 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c124 = mms:c100*mms:c60/50 - pi^2*mms:c111*((-7*pi*sin(pi*x)/85 + 21*pi*sin(3*pi*x)/125)*sin(t/5 - z)^2 - 4*pi*sin(pi*x)*cos(2*t/5 - 2*z)/85 - pi*sin(pi*x)/17 + 27*pi*sin(3*pi*x)/125)/50 - pi^2*mms:c46*(mms:c63 + pi*mms:c65/5)/25 + mms:c57*(mms:c100/50 + pi^2*mms:c104/25) + mms:c63*(-pi^2*mms:c46/25 + pi^2*mms:c70/25) + pi^3*(mms:c111*((8 - 4*cos(2*pi*x))*sin(pi*x)*cos(t/5 - z)^2 + (12*cos(2*pi*x) - 8)*sin(pi*x)*sin(t/5 - z)^2 + 2*sin(2*pi*x)*cos(pi*x)) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500 - 3*sin(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/200
c130 = pi*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c132 = pi^3*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/500
c134 = mms:c57*(-mms:c132 + pi^3*(cos(t/5 + y)/1000 + 1/50)*cos(2*pi*x)*cos(t/5 - z)/125)
c135 = pi^3*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/250
c136 = mms:c63*(-mms:c135 + pi^3*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125)
c144 = pi^2*mms:c111*((-7*pi^2*cos(pi*x)/850 + 63*pi^2*cos(3*pi*x)/1250)*sin(t/5 - z)^2 - 2*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425 - pi^2*cos(pi*x)/170 + 81*pi^2*cos(3*pi*x)/1250)/50
c145 = 2*pi*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(t/5 - z)
c147 = mms:c100*(-pi^2*mms:c46/25 + pi^2*mms:c70/25)/50 + mms:c100*(-pi^2*mms:c46/100 - pi^2*mms:c51/25)/50 - 3*mms:c130/1000 - mms:c132*mms:c60 + mms:c134 - mms:c135*(mms:c63 + pi*mms:c65/5) + mms:c136 - mms:c144 - pi^2*mms:c46*(mms:c100/50 + pi^2*mms:c104/25)/20 + pi^3*(mms:c111*(pi*(8 - 4*cos(2*pi*x))*cos(pi*x)*cos(t/5 - z)^2/10 + pi*(12*cos(2*pi*x) - 8)*sin(t/5 - z)^2*cos(pi*x)/10 - 12*pi*sin(pi*x)*sin(2*pi*x)*sin(t/5 - z)^2/5 + 4*pi*sin(pi*x)*sin(2*pi*x)*cos(t/5 - z)^2/5 - pi*sin(pi*x)*sin(2*pi*x)/5 + 2*pi*cos(pi*x)*cos(2*pi*x)/5) + mms:c145)/500
c150 = (14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*sin(t/5 - z)^2
c151 = pi^2*mms:c111*(-2*pi^2*mms:c150/25 + 2*pi^2*(14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*cos(t/5 - z)^2/25 - 32*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425)/50
c152 = (8*cos(2*pi*x) - 12)*cos(pi*x) + 3*sin(pi*x)*sin(2*pi*x)
c154 = -mms:c100*(-pi^2*mms:c46/25 + pi^2*mms:c70/25)/50 - mms:c100*(-pi^2*mms:c46/100 - pi^2*mms:c51/25)/50 - 3*mms:c130/1000 + mms:c132*mms:c60 - mms:c134 + mms:c135*(mms:c63 + pi*mms:c65/5) - mms:c136 - mms:c151 + pi^2*mms:c46*(mms:c100/50 + pi^2*mms:c104/25)/20 + pi^3*(-pi*mms:c111*mms:c152*sin(t/5 - z)^2/5 - mms:c145 + pi*mms:c152*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)^2/5)/500
c157 = -mms:c100*(mms:c63 + pi*mms:c65/5)/50 - pi^2*mms:c111*(-2*pi*(14*cos(pi*x)/17 - 14*cos(3*pi*x)/25)*sin(t/5 - z)*cos(t/5 - z)/5 + 16*pi*sin(2*t/5 - 2*z)*cos(pi*x)/85)/50 - mms:c57*(-pi^2*mms:c46/100 - pi^2*mms:c51/25) + pi^2*mms:c60*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)/100 - mms:c63*(mms:c100/50 + pi^2*mms:c104/25) + pi^3*(-mms:c111*mms:c152*sin(t/5 - z)*cos(t/5 - z) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500 + 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/200
c161 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c164 = (-3*pi*mms:c161/400 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c166 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/250 - pi*sin(2*pi*x)*cos(t/5 - y)/50
c168 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c169 = pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)
c171 = (-mms:c166 - 3*mms:c168/400 + 3*mms:c169/400)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c177 = mms:c130*(mms:c13 + 1)*sin(pi*x)^2/250 + pi*mms:c28*sin(t/5 - y)*cos(2*pi*x)/100
c178 = -3*mms:c21/40 + 3*sin(pi*x)^2*cos(t/5 + z)/25 + cos(2*pi*x)*cos(t/5 - y)/5 + 11/2
c188 = mms:c157*(3*pi*sin(pi*x)^2*sin(t/5 + z)/125 - 3*pi*sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)
c189 = mms:c124*(-3*pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/200 + 3*pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)/200 - 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/125 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c191 = sin(pi*x)^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c200 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c201 = 3*sin(pi*x)^2*sin(t/5 + z)/250 + sin(t/5 - y)*cos(2*pi*x)/50
c203 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c204 = mms:c203 - sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c208 = (2 - cos(2*pi*x))*sin(t/5 + y)*sin(t/5 - z)
c209 = (pi*mms:c208/2500 + 2*pi*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c215 = (-2*mms:c70 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c216 = mms:c215*(-3*pi*mms:c191/800 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c220 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c221 = pi*sin(pi*x)*sin(t/5 - y)*cos(pi*x)*cos(2*pi*x)*cos(t/5 - z)
c224 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)
c243 = 3*sin(pi*x)^2*sin(t/5 + z)/500 + sin(t/5 - y)*cos(2*pi*x)/100
c244 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c245 = 3*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/100
c248 = pi*sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c254 = mms:c177 + pi*mms:c191*mms:c36/200 + 3*pi*mms:c191*(1/2 - mms:c21/40)/1000
c256 = pi*mms:c191/200 + pi*sin(t/5 - y)*cos(2*pi*x)/100
c257 = -mms:c256*(mms:c245 + mms:c28*(mms:c13 + 1) + mms:c36*(1/2 - mms:c21/40))/(mms:c13 - mms:c21/40 + 3/2)^2
c266 = (-2*mms:c65/5 + (2 - cos(2*pi*x))*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c272 = 3*pi*mms:c28^2*sin(pi*x)^2*sin(t/5 + z)/500
c274 = -3*pi*mms:c161/800 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250
c282 = 3*pi*mms:c161*mms:c36^2/800 + 3*pi*mms:c161*mms:c36*(3/8 - 3*mms:c21/160)/500 + 3*pi*mms:c161*mms:c75/800 + mms:c215*mms:c274*(3/8 - 3*mms:c21/160) + 3*pi*mms:c65*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c283 = pi*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)
c286 = mms:c215*(3*mms:c13/2 + 3/2)*(-mms:c166 - 3*mms:c168/800 + 3*mms:c169/800) + mms:c28^2*mms:c97 + mms:c28*(mms:c13 + 1)*(mms:c220/125 - mms:c221/125) - 3*mms:c283*(mms:c13 + 1)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + 3*mms:c75*mms:c97/2
c287 = mms:c215*(3/8 - 3*mms:c21/160)*(-mms:c166 - 3*mms:c168/800 + 3*mms:c169/800) - 3*mms:c283*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c36^2*(3*mms:c168/800 - 3*mms:c169/800) + mms:c36*(3/8 - 3*mms:c21/160)*(3*mms:c168/500 - 3*mms:c169/500) + 3*mms:c75*(mms:c168/400 - mms:c169/400)/2
c290 = mms:c46 - mms:c70 + 3*mms:c82/(2*(-3*mms:c21/80 + mms:c29 + 11/4)) + 2*(mms:c28^2*(mms:c13 + 1) + 3*mms:c75*(mms:c13 + 1)/2)/(-3*mms:c21/80 + mms:c29 + 11/4) + cos(t/5 - y)/25 + 6/5
c293 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/306000
c294 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/306000
total_pressure = mms:c75*(1/4 - mms:c21/80) + mms:c75*(mms:c13 + 1)
pressure_i = mms:c75*(mms:c13 + 1)
pressure_j = mms:c75*(1/4 - mms:c21/80)
ion_temperature = mms:c75
potential = mms:c46
pressure_potential = -mms:c70 + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c111*(mms:c150 + 8*cos(pi*x)*cos(2*t/5 - 2*z)/17 + 10*cos(pi*x)/17 - 18*cos(3*pi*x)/25)/100 - 3*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/(80*pi)
electron_temperature = mms:c38
parallel_current = -mms:c245
parallel_current_divergence = 3*mms:c130/500

[Ve]
bndry_xin = neumann
bndry_xout = neumann

[Ni]
solution = mms:c13 + 1
source = mms:c124*mms:c171*(2*mms:c13 + 2) + 2*mms:c124*mms:c97/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c147*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c154*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c157*mms:c164*(2*mms:c13 + 2) - 3*pi*mms:c157*sin(pi*x)^2*sin(t/5 + z)/(250*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c177 + mms:c63*mms:c97 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - 3*sin(pi*x)^2*sin(t/5 + z)/500 - sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = 1/4 - mms:c21/80
source = 3*mms:c124*(mms:c168/400 - mms:c169/400)/mms:c178 + 3*mms:c147*(1/4 - mms:c21/80)/mms:c178 + 3*mms:c154*(1/4 - mms:c21/80)/mms:c178 + 3*pi*mms:c157*mms:c161/(400*mms:c178) - mms:c161/400 + pi*mms:c191*mms:c36/400 + 3*pi*mms:c191*(1/4 - mms:c21/80)/1000 + mms:c191/400 + mms:c63*(mms:c168/400 - mms:c169/400) - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000 + 3*mms:c188*(1/4 - mms:c21/80)/mms:c178^2 + 3*mms:c189*(1/4 - mms:c21/80)/mms:c178^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c28*(mms:c29 + 2)
source = 2*mms:c124*mms:c166*mms:c28/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c124*mms:c171*mms:c28*(mms:c29 + 2) + 2*mms:c124*(mms:c220/250 - mms:c221/250)*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c130*mms:c28*(mms:c29 + 2)*sin(pi*x)^2/125 + 2*mms:c147*mms:c28*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c154*mms:c28*(mms:c29 + 2)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c157*mms:c164*mms:c28*(mms:c29 + 2) - pi*mms:c157*mms:c224*(mms:c29 + 2)/(125*(-3*mms:c21/80 + mms:c29 + 11/4)) - 3*pi*mms:c157*mms:c28*sin(pi*x)^2*sin(t/5 + z)/(125*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c200*(mms:c13 + 1) - mms:c201*mms:c28 + mms:c204*(mms:c29 + 2) + mms:c209*(mms:c13 + 1) + mms:c216*(mms:c13 + 1) + pi*mms:c28^2*sin(t/5 - y)*cos(2*pi*x)/50 - mms:c57*(-pi*mms:c203*(mms:c29 + 2) - 3*pi*mms:c28*sin(pi*x)^2*sin(t/5 + z)/250) + mms:c63*(mms:c166*mms:c28 + (mms:c220/250 - mms:c221/250)*(mms:c29 + 2)) + pi*mms:c75*sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c36*(3/4 - 3*mms:c21/80)
