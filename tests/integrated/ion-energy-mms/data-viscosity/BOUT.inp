# Template; regenerate committed variants using python mms.py --all.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false
viscosity = 0.02

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[polarisation_drift]
implementation = conservative

[mms]
variant = viscosity
c9 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c17 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c22 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c23 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c26 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 3/4
c27 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c29 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c30 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c38 = pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c47 = pi^2*((1 - cos(2*pi*x))^3 + 1)^2*(cos(t/5 + y)/1000 + 1/50)^2
c49 = (1 - cos(2*pi*x))^4*sin(2*pi*x)^2*sin(t/5 - z)^2
c50 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c56 = ((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)
c58 = -2*mms:c56*sin(t/5 - z) + 2*cos(t/5 - y)/25 + 12/5
c69 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c71 = pi*mms:c22*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c69*(mms:c9 + 1)
c75 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c77 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c80 = mms:c75 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c82 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c84 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c87 = ((1 - cos(2*pi*x))^3 + 1)*sin(t/5 + y)*sin(t/5 - z)
c88 = (pi*mms:c87/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c23 - mms:c50 + 19/8)
c90 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c93 = mms:c58*(-pi*mms:c90 - pi*sin(t/5 - y)*cos(2*pi*x)/50)/(mms:c23 - mms:c50 + 19/8)^2
c95 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c96 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c100 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c101 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c105 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c112 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*cos(t/5 - z)
c113 = 6*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*cos(2*pi*x)*cos(t/5 - z)/125
c114 = (-pi*mms:c56*(12*pi^3*mms:c112/125 + pi^3*mms:c113 - 2*pi^3*mms:c56*cos(t/5 - z)/125)*cos(t/5 - z)/250 + 3*pi*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*(12*pi^3*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125 - 36*pi^3*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)*cos(2*pi*x)/125 - 12*pi^3*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^3*sin(t/5 - z)/125)*sin(2*pi*x)*sin(t/5 - z)/250)*(-sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/73440 + cos(2*pi*x)*cos(t/5 - y)/36720 + cos(t/5 + z)/61200 + 1/1224)/(-551*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/14688 + 3673*cos(2*pi*x)*cos(t/5 - y)/36720 + 3673*cos(t/5 + z)/61200 + 3367/1224)
c117 = pi^4*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c122 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c126 = (-2*mms:c56*cos(t/5 - z)/5 + ((1 - cos(2*pi*x))^3 + 1)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c23 - mms:c50 + 19/8)
total_pressure = mms:c17*mms:c58/(mms:c23 - mms:c50 + 19/8) + mms:c58*(mms:c9 + 1)/(mms:c23 - mms:c50 + 19/8)
pressure_i = mms:c58*(mms:c9 + 1)/(mms:c23 - mms:c50 + 19/8)
pressure_j = mms:c17*mms:c58/(mms:c23 - mms:c50 + 19/8)
ion_temperature = mms:c58/(mms:c23 - mms:c50 + 19/8)
potential = 0
pressure_potential = -mms:c56*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5
current_potential = 0

[Ni]
solution = mms:c9 + 1
source = mms:c71 - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c17
source = pi*mms:c17*mms:c77 + pi*mms:c27*mms:c75 + mms:c80
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c22*(mms:c23 + 2)
source = pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/50 - mms:c22*mms:c82 + pi*mms:c22*mms:c84*(mms:c23 + 2) + pi*mms:c58*sin(t/5 - y)*cos(2*pi*x)/(100*(mms:c23 - mms:c50 + 19/8)) + mms:c88*(mms:c9 + 1) + mms:c93*(mms:c9 + 1) + (mms:c23 + 2)*(-mms:c69 + sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c26*mms:c27
source = mms:c17*mms:c88 + mms:c17*mms:c93 + pi*mms:c26*mms:c27*mms:c96 + mms:c26*(mms:c77 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000) + pi*mms:c27^2*mms:c95 + mms:c27*(mms:c95 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400) + pi*mms:c58*mms:c75/(mms:c23 - mms:c50 + 19/8)
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c29*(-mms:c30 + mms:c9 + 3/2)
source = -pi*mms:c101*(mms:c22*(mms:c9 + 1) + mms:c27*(1/2 - mms:c30)) - 2*mms:c114/3 + 2*mms:c29*((-mms:c105 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c22*(mms:c9 + 1) + mms:c27*(1/2 - mms:c30))/(-mms:c30 + mms:c9 + 3/2)^2 + (mms:c105*mms:c27 + mms:c71 + pi*mms:c77*(1/2 - mms:c30))/(-mms:c30 + mms:c9 + 3/2))*(-mms:c30 + mms:c9 + 3/2)/3 + mms:c29*(-mms:c100 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + mms:c29*(mms:c105*mms:c27 + mms:c71 + pi*mms:c77*(1/2 - mms:c30)) + (mms:c101 - cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100)*(-mms:c30 + mms:c9 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -6*mms:c38*(1 - cos(2*pi*x))^2*cos(2*pi*x)/25 - 12*mms:c38*(1 - cos(2*pi*x))*sin(2*pi*x)^2/25 + 2*pi^2*((1 - cos(2*pi*x))^3 + 1)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/25
source = where(x*(1-x),-12*pi^2*mms:c112/125 - pi^2*mms:c113 - 9*mms:c117*(1 - cos(2*pi*x))^2*cos(2*pi*x)/15625 - 36*mms:c117*(1 - cos(2*pi*x))*sin(2*pi*x)^2/15625 + 18*mms:c117*(1 - cos(2*pi*x))*cos(2*pi*x)^2/15625 + 36*mms:c117*sin(2*pi*x)^2*cos(2*pi*x)/15625 + pi^4*mms:c56*sin(t/5 - z)/15625 + 2*pi^2*mms:c56*cos(t/5 - z)/125 - pi^2*mms:c87/62500 + 3*pi^2*(1 - cos(2*pi*x))^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/62500 + 3*pi^2*(1 - cos(2*pi*x))*sin(2*pi*x)^2*sin(t/5 + y)*sin(t/5 - z)/31250,0)

[Eion]
solution = 3*mms:c17*mms:c58/(2*(mms:c23 - mms:c50 + 19/8)) + mms:c22^2*(mms:c9 + 1) + mms:c27^2*(3/8 - mms:c50) + mms:c47*cos(t/5 - z)^2/25 + 9*pi^2*mms:c49*(cos(t/5 + y)/1000 + 1/50)^2/25 + 3*mms:c58*(mms:c9 + 1)/(2*(mms:c23 - mms:c50 + 19/8))
source = -mms:c100*mms:c22^2 - 3*mms:c100*mms:c58/(2*(mms:c23 - mms:c50 + 19/8)) + mms:c114 + 3*mms:c126*mms:c17/2 + mms:c126*(3*mms:c9/2 + 3/2) + 3*mms:c17*mms:c58*(mms:c122 + mms:c82 - mms:c90)/(2*(mms:c23 - mms:c50 + 19/8)^2) + mms:c22*(-mms:c84 + sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125)*(mms:c9 + 1) + mms:c22*(pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c22*mms:c84*(mms:c9 + 1) + pi*mms:c58*sin(t/5 - y)*cos(2*pi*x)/(40*(mms:c23 - mms:c50 + 19/8)) + 5*mms:c88*(mms:c9 + 1)/2 + 5*mms:c93*(mms:c9 + 1)/2) + mms:c27^2*(-mms:c122 + mms:c90) + mms:c27*(3/8 - mms:c50)*(mms:c96 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500) + mms:c27*(5*mms:c17*mms:c88/2 + 5*mms:c17*mms:c93/2 + pi*mms:c27^2*mms:c90 + pi*mms:c27*mms:c96*(3/8 - mms:c50) + pi*mms:c58*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/(160*(mms:c23 - mms:c50 + 19/8))) - 2*mms:c47*sin(t/5 - z)*cos(t/5 - z)/125 - 9*pi^2*mms:c49*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 + y)/62500 + 3*mms:c58*mms:c80/(2*(mms:c23 - mms:c50 + 19/8)) + mms:c58*(3*mms:c9/2 + 3/2)*(mms:c122 + mms:c82 - mms:c90)/(mms:c23 - mms:c50 + 19/8)^2 + pi*mms:c69*(mms:c22^2*(mms:c9 + 1) + 5*mms:c58*(mms:c9 + 1)/(2*(mms:c23 - mms:c50 + 19/8))) + pi*mms:c77*(5*mms:c17*mms:c58/(2*(mms:c23 - mms:c50 + 19/8)) + mms:c27^2*(3/8 - mms:c50)) + 18*pi^2*(1 - cos(2*pi*x))^4*(cos(t/5 + y)/1000 + 1/50)^2*sin(2*pi*x)^2*sin(t/5 - z)*cos(t/5 - z)/125 - pi^2*((1 - cos(2*pi*x))^3 + 1)^2*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 + y)*cos(t/5 - z)^2/62500
bndry_xin = dirichlet_o2(Eion:solution)
bndry_xout = dirichlet_o2(Eion:solution)
