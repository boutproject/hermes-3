# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = 0.1/(2*units:meters^2)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false
viscosity = 0.02

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = viscosity
c9 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/400 + cos(2*pi*x)/20 + 1
c10 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + cos(2*pi*x)/80 + 1/4
c16 = -sin(t/5 - y)/1000 - sin(3*t/5 - 3*y)/9000
c17 = 3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/200 + cos(2*pi*x)/10 + 2
c22 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 3*cos(2*pi*x)/80 + 3/4
c23 = mms:c22*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c31 = -pi^2*(1 - cos(2*pi*x))^2/25 + 2*pi^2*(-(cos(2*pi*x) - 1)*cos(2*pi*x) + sin(2*pi*x)^2)/25
c33 = -mms:c31*sin(t/5 - z)/pi + 2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/95 + 4
c37 = pi^2*(1 - cos(2*pi*x))*sin(t/5 - z)*cos(2*pi*x)
c40 = (cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)^2
c41 = 9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 3*cos(2*pi*x)/160 + 3/8
c45 = 57*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3200 + 19*cos(2*pi*x)/160 + 19/8
c48 = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/25 + cos(t/5 - y)/125 + 12/5
c56 = pi*cos(t/5 - y)/5000 + pi*cos(3*t/5 - 3*y)/15000
c60 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(t/5 - z)
c64 = pi^3*sin(2*pi*x)*sin(t/5 - z)*cos(2*pi*x)
c65 = pi^3*(1 - cos(2*pi*x))*sin(2*pi*x)*sin(t/5 - z)
c68 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1600 + 11*cos(2*pi*x)/80 + 11/4
c77 = (1 - cos(2*pi*x))*cos(2*pi*x)*cos(t/5 - z)
c79 = pi^3*mms:c77/78125 - pi^3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/156250 + pi^3*sin(2*pi*x)^2*cos(t/5 - z)/78125
c80 = -mms:c79 - pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/250
c86 = pi^4*(1 - cos(2*pi*x))^2*sin(t/5 - z)/781250
c89 = pi^4*(1 - cos(2*pi*x))*sin(t/5 - z)*cos(2*pi*x)
c91 = mms:c86 - mms:c89/390625 + pi^2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/1250 - pi^4*sin(2*pi*x)^2*sin(t/5 - z)/390625
c96 = 2*(-33*mms:c60/4000 + 11*pi*sin(2*pi*x)/400)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)/mms:c68^2
c98 = 33*pi*mms:c80*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(4000*mms:c68^2)
c101 = -3*pi^4*sin(t/5 - z)*cos(2*pi*x)^2/390625
c102 = mms:c101 + 2*mms:c89/390625 + pi^4*sin(2*pi*x)^2*sin(t/5 - z)/78125
c103 = -mms:c102 - pi^2*mms:c77/625 - pi^2*sin(2*pi*x)^2*cos(t/5 - z)/625
c107 = -pi*sin(t/5 + y)/5000 + pi*sin(3*t/5 + 3*y)/15000
c109 = 33*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 11*cos(2*pi*x)/40 + 11/2
c118 = 3*(-33*mms:c60/2000 + 11*pi*sin(2*pi*x)/200)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)
c119 = 99*pi*mms:c80*(1 - cos(2*pi*x))^2*sin(t/5 - z)/4000
c125 = pi*cos(t/5 - y)/2500 + pi*cos(3*t/5 - 3*y)/7500
c128 = -pi*sin(t/5 + y)/2500 + pi*sin(3*t/5 + 3*y)/7500
c132 = 1/(9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + 3*cos(2*pi*x)/40 + 3/2)
c133 = mms:c107*(3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/800 + cos(2*pi*x)/40 + 1/2) + mms:c56*mms:c9
c135 = (-pi*(1 - cos(2*pi*x))^2*(2*pi^3*mms:c77/3125 - pi^3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/3125 + 2*pi^3*sin(2*pi*x)^2*cos(t/5 - z)/3125)*cos(t/5 - z)/12500 + pi*(1 - cos(2*pi*x))*(-6*mms:c64/3125 + 4*mms:c65/3125)*sin(2*pi*x)*sin(t/5 - z)/6250)*((1 - cos(2*pi*x))^2*cos(t/5 - z)/163200 + cos(2*pi*x)/24480 + 1/1224)/(3367*(1 - cos(2*pi*x))^2*cos(t/5 - z)/163200 + 3367*cos(2*pi*x)/24480 + 3367/1224)
c138 = 9*mms:c40*(1 - cos(2*pi*x))^2*sin(t/5 - z)/16000
c139 = 3*mms:c16^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000
c140 = mms:c41*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)
c142 = pi*(1 - cos(2*pi*x))*sin(2*pi*x)*sin(t/5 - z)
c144 = -3*(1 - cos(2*pi*x))^2*cos(t/5 - z)/250 - 3*sin(t/5 - y)/1250
c145 = -(1 - cos(2*pi*x))^2*sin(t/5 - z)/50 + cos(t/5 - y)/250 + 6/5
c154 = 2*(mms:c16^2*mms:c9 + 5*mms:c48*mms:c9/(2*mms:c45))/mms:c68 + 3*(5*mms:c10*mms:c48/(2*mms:c45) + mms:c40*mms:c41)/(2*mms:c68)
c155 = pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c68^2
c157 = pi*mms:c48*(1 - cos(2*pi*x))^2*sin(t/5 - z)/mms:c45
c158 = 57*pi*(1 - cos(2*pi*x))^2*sin(t/5 - z)/6400
total_pressure = mms:c10*mms:c48/mms:c45 + mms:c48*mms:c9/mms:c45
pressure_i = mms:c48*mms:c9/mms:c45
pressure_j = mms:c10*mms:c48/mms:c45
ion_temperature = mms:c48/mms:c45
potential = 0
pressure_potential = mms:c145
current_potential = -mms:c37/31250 + pi^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/62500 + (1 - cos(2*pi*x))^2*cos(t/5 - z)/100 - pi^2*sin(2*pi*x)^2*sin(t/5 - z)/31250

[Ni]
solution = mms:c9
source = 2*mms:c103*mms:c9/mms:c68 + mms:c56*mms:c9 + mms:c9*mms:c96 - mms:c9*mms:c98 - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/2000 + 3*pi*mms:c80*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(1000*mms:c68) + 2*mms:c9*mms:c91/mms:c68 + 2*(3*mms:c60/1000 - pi*sin(2*pi*x)/100)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)/mms:c68
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c10
source = 3*mms:c10*mms:c103/mms:c109 + mms:c10*mms:c107 + 3*mms:c10*mms:c91/mms:c109 + mms:c10*mms:c118/mms:c109^2 - mms:c10*mms:c119/mms:c109^2 - 3*(1 - cos(2*pi*x))^2*sin(t/5 - z)/8000 + 9*pi*mms:c80*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(8000*mms:c109) + 3*(3*mms:c60/4000 - pi*sin(2*pi*x)/400)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)/mms:c109
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c16*mms:c17
source = 2*mms:c103*mms:c16*mms:c17/mms:c68 + mms:c125*mms:c16*mms:c17 + mms:c16*mms:c17*mms:c96 - mms:c16*mms:c17*mms:c98 + 2*mms:c16*mms:c17*mms:c91/mms:c68 - 3*mms:c16*(1 - cos(2*pi*x))^2*sin(t/5 - z)/1000 + 3*pi*mms:c16*mms:c80*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(500*mms:c68) + 2*mms:c16*(3*mms:c60/500 - pi*sin(2*pi*x)/50)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)/mms:c68 + mms:c17*(-cos(t/5 - y)/5000 - cos(3*t/5 - 3*y)/15000) + pi*mms:c9*sin(t/5 - y)/(625*mms:c45)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c23
source = pi*mms:c10*sin(t/5 - y)/(625*mms:c45) + 3*mms:c103*mms:c23/mms:c109 + mms:c128*mms:c23 + mms:c22*(-sin(t/5 + y)/5000 + sin(3*t/5 + 3*y)/15000) - 9*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*sin(t/5 - z)/8000 + 3*mms:c23*mms:c91/mms:c109 + 27*pi*mms:c80*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*sin(t/5 - z)/(8000*mms:c109) + 3*(9*mms:c60/4000 - 3*pi*sin(2*pi*x)/400)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000)*(-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)/mms:c109 + mms:c118*mms:c23/mms:c109^2 - mms:c119*mms:c23/mms:c109^2
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c33
source = mms:c132*mms:c133*mms:c33 - mms:c132*mms:c133*(2*mms:c31*sin(t/5 - z)/(3*pi) - 4*(1 - cos(2*pi*x))^2*sin(t/5 - z)/285 - 8/3) - 2*mms:c135/3 - mms:c31*cos(t/5 - z)/(5*pi) + 2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/475
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -2*mms:c37/625 + pi^2*(1 - cos(2*pi*x))^2*sin(t/5 - z)/625 - 2*pi^2*sin(2*pi*x)^2*sin(t/5 - z)/625
source = where(x*(1-x),-mms:c101 - 7*pi^2*mms:c77/3125 + mms:c86 + 7*pi^2*(1 - cos(2*pi*x))^2*cos(t/5 - z)/6250 - 3*pi^4*(1 - cos(2*pi*x))*sin(t/5 - z)*cos(2*pi*x)/390625 - 6*pi^4*sin(2*pi*x)^2*sin(t/5 - z)/390625 - 7*pi^2*sin(2*pi*x)^2*cos(t/5 - z)/3125,0)

[Eion]
solution = 3*mms:c10*mms:c48/(2*mms:c45) + mms:c16^2*mms:c9 + mms:c40*mms:c41 + pi^2*(1 - cos(2*pi*x))^4*cos(t/5 - z)^2/62500 + pi^2*(1 - cos(2*pi*x))^2*sin(2*pi*x)^2*sin(t/5 - z)^2/15625 + 3*mms:c48*mms:c9/(2*mms:c45)
source = mms:c10*mms:c144/mms:c45 + 171*mms:c10*mms:c48*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c45^2) + mms:c102*mms:c145 + mms:c103*mms:c154 + mms:c107*(5*mms:c10*mms:c48/(2*mms:c45) + mms:c40*mms:c41) + mms:c135 - mms:c138 - mms:c139 + mms:c140*(-sin(t/5 + y)/2500 + sin(3*t/5 + 3*y)/7500) - mms:c142*(-3*mms:c64/78125 + 2*mms:c65/78125)/125 + mms:c144*mms:c9/mms:c45 + mms:c145*(-mms:c86 + mms:c89/390625 + pi^4*sin(2*pi*x)^2*sin(t/5 - z)/390625) + mms:c154*mms:c91 + mms:c16*mms:c9*(-cos(t/5 - y)/2500 - cos(3*t/5 - 3*y)/7500) + mms:c16*(mms:c125*mms:c16*mms:c9 + pi*mms:c9*sin(t/5 - y)/(250*mms:c45)) + mms:c56*(mms:c16^2*mms:c9 + 5*mms:c48*mms:c9/(2*mms:c45)) + pi*mms:c79*(1 - cos(2*pi*x))^2*cos(t/5 - z)/250 + mms:c80*(-33*mms:c155*(mms:c16^2*mms:c9 + 5*mms:c48*mms:c9/(2*mms:c45))/4000 - 99*mms:c155*(5*mms:c10*mms:c48/(2*mms:c45) + mms:c40*mms:c41)/16000 + 2*(pi*mms:c139 + 3*mms:c157/800 - mms:c158*mms:c48*mms:c9/mms:c45^2 + pi*mms:c9*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c45))/mms:c68 + 3*(-mms:c10*mms:c158*mms:c48/mms:c45^2 + pi*mms:c10*(1 - cos(2*pi*x))^2*cos(t/5 - z)/(50*mms:c45) + pi*mms:c138 + 3*mms:c157/3200)/(2*mms:c68)) - pi^2*(1 - cos(2*pi*x))^4*sin(t/5 - z)*cos(t/5 - z)/156250 + 2*pi^2*(1 - cos(2*pi*x))^2*sin(2*pi*x)^2*sin(t/5 - z)*cos(t/5 - z)/78125 + (pi*mms:c10*sin(t/5 - y)/(250*mms:c45) + mms:c128*mms:c140)*(cos(t/5 + y)/1000 - cos(3*t/5 + 3*y)/9000) + (-mms:c60/125 + 3*mms:c64/78125 - 2*mms:c65/78125)*(3*(-mms:c10*mms:c142/(25*mms:c45) + mms:c10*mms:c48*(-57*mms:c60/3200 + 19*pi*sin(2*pi*x)/320)/mms:c45^2 + mms:c40*(9*mms:c60/8000 - 3*pi*sin(2*pi*x)/800) + 5*mms:c48*(3*mms:c60/4000 - pi*sin(2*pi*x)/400)/(2*mms:c45))/(2*mms:c68) + 2*(-mms:c142*mms:c9/(25*mms:c45) + mms:c16^2*(3*mms:c60/1000 - pi*sin(2*pi*x)/100) + 5*mms:c48*(3*mms:c60/1000 - pi*sin(2*pi*x)/100)/(2*mms:c45) + mms:c48*mms:c9*(-57*mms:c60/3200 + 19*pi*sin(2*pi*x)/320)/mms:c45^2)/mms:c68 + 2*(-33*mms:c60/4000 + 11*pi*sin(2*pi*x)/400)*(mms:c16^2*mms:c9 + 5*mms:c48*mms:c9/(2*mms:c45))/mms:c68^2 + 3*(-33*mms:c60/4000 + 11*pi*sin(2*pi*x)/400)*(5*mms:c10*mms:c48/(2*mms:c45) + mms:c40*mms:c41)/(2*mms:c68^2)) - 9*mms:c48*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(3200*mms:c45) + 171*mms:c48*mms:c9*(1 - cos(2*pi*x))^2*sin(t/5 - z)/(32000*mms:c45^2)
bndry_xin = dirichlet_o2(Eion:solution)
bndry_xout = dirichlet_o2(Eion:solution)
