# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, zero_current
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = false

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = false
viscosity = 0.02

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
# Electrons have zero-current closure, with no independent electron momentum.
# Use the collective acoustic speed for numerical Lax fluxes.
electron_dynamics = false
alfven_wave = false

[mms]
variant = viscosity
c9 = cos(2*pi*x)*cos(t/5 - y)/20 + 3*cos(t/5 + z)/100
c17 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80 + 1/4
c22 = -sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c23 = cos(2*pi*x)*cos(t/5 - y)/10 + 3*cos(t/5 + z)/50
c26 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/80
c28 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c30 = -sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c31 = sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40
c39 = pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c50 = pi^2*(1 - cos(2*pi*x))^6*(cos(t/5 + y)/1000 + 1/50)^2
c52 = (1 - cos(2*pi*x))^4*sin(2*pi*x)^2*sin(t/5 - z)^2
c53 = 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/160
c59 = (1 - cos(2*pi*x))^3*(cos(t/5 + y)/1000 + 1/50)
c61 = -2*mms:c59*sin(t/5 - z) + 2*cos(t/5 - y)/25 + 12/5
c71 = pi^4*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)
c74 = 3*mms:c71*(1 - cos(2*pi*x))^2*cos(2*pi*x)/15625 + 6*mms:c71*(1 - cos(2*pi*x))*sin(2*pi*x)^2/15625 - pi^4*(1 - cos(2*pi*x))^3*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/15625
c80 = 6*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/3125
c82 = 6*mms:c71*(1 - cos(2*pi*x))^2*cos(2*pi*x)/15625 + pi^4*mms:c80*(1 - cos(2*pi*x))*sin(2*pi*x)^2 - 18*pi^4*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)*cos(2*pi*x)^2/15625 - 36*pi^4*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*sin(t/5 - z)*cos(2*pi*x)/15625
c87 = pi^3*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)
c90 = 3*mms:c87*(1 - cos(2*pi*x))^2*cos(2*pi*x)/3125 + 6*mms:c87*(1 - cos(2*pi*x))*sin(2*pi*x)^2/3125 - pi^3*(1 - cos(2*pi*x))^3*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)/3125
c96 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c98 = (-pi*mms:c96 + 3*pi*sin(t/5 + z)/250)/(mms:c23 - mms:c26 + 11/4)^2
c102 = pi^3*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)*cos(2*pi*x)
c103 = 18*mms:c102/3125 - pi^3*mms:c80*(1 - cos(2*pi*x))^2*sin(2*pi*x) + pi^3*mms:c80*sin(2*pi*x)^3
c107 = pi*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c109 = (-3*mms:c107/400 + pi*sin(2*pi*x)*cos(t/5 - y)/50)/(mms:c23 - mms:c26 + 11/4)^2
c116 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c117 = pi*mms:c116*(mms:c9 + 1) + pi*mms:c22*sin(t/5 - y)*cos(2*pi*x)/100
c118 = -3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/40 + cos(2*pi*x)*cos(t/5 - y)/5 + 3*cos(t/5 + z)/25 + 11/2
c126 = pi*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c128 = mms:c103*(-3*mms:c107/200 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c132 = sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c134 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/1000
c138 = mms:c132 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/400
c140 = sin(t/5 - y)*cos(2*pi*x)/50 + 3*sin(t/5 + z)/250
c142 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/125
c145 = (1 - cos(2*pi*x))^3*sin(t/5 + y)*sin(t/5 - z)
c146 = (pi*mms:c145/2500 + 2*pi*sin(t/5 - y)/125)/(mms:c23 - mms:c53 + 19/8)
c148 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/800
c152 = mms:c61*(-pi*mms:c148 - pi*sin(t/5 - y)*cos(2*pi*x)/50)/(mms:c23 - mms:c53 + 19/8)^2
c155 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c159 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/400
c160 = 3*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/500
c171 = sin(t/5 - y)*cos(2*pi*x)/100 + 3*sin(t/5 + z)/500
c172 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c176 = pi*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200
c180 = (-pi*mms:c59*(-2*pi^3*mms:c59*cos(t/5 - z)/125 + 6*mms:c87*(1 - cos(2*pi*x))^2*cos(2*pi*x)/125 + 12*mms:c87*(1 - cos(2*pi*x))*sin(2*pi*x)^2/125)*cos(t/5 - z)/250 + 3*pi*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*(-36*mms:c102/125 + 12*pi^3*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125 - 12*pi^3*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^3*sin(t/5 - z)/125)*sin(2*pi*x)*sin(t/5 - z)/250)*(-sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/73440 + cos(2*pi*x)*cos(t/5 - y)/36720 + cos(t/5 + z)/61200 + 1/1224)/(-551*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/14688 + 3673*cos(2*pi*x)*cos(t/5 - y)/36720 + 3673*cos(t/5 + z)/61200 + 3367/1224)
c183 = pi^2*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)
c187 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/800
c188 = 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/500
c192 = (-2*mms:c59*cos(t/5 - z)/5 + (1 - cos(2*pi*x))^3*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(mms:c23 - mms:c53 + 19/8)
c194 = pi*(1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)
c197 = 5*mms:c17*mms:c61/(2*(mms:c23 - mms:c53 + 19/8)) + mms:c28^2*(3/8 - mms:c53)
c198 = mms:c22^2*(mms:c9 + 1) + 5*mms:c61*(mms:c9 + 1)/(2*(mms:c23 - mms:c53 + 19/8))
c202 = 3*mms:c197/(2*(mms:c23 - mms:c26 + 11/4)) + 2*mms:c198/(mms:c23 - mms:c26 + 11/4)
c210 = -3*mms:c107/800 + pi*sin(2*pi*x)*cos(t/5 - y)/50
total_pressure = mms:c17*mms:c61/(mms:c23 - mms:c53 + 19/8) + mms:c61*(mms:c9 + 1)/(mms:c23 - mms:c53 + 19/8)
pressure_i = mms:c61*(mms:c9 + 1)/(mms:c23 - mms:c53 + 19/8)
pressure_j = mms:c17*mms:c61/(mms:c23 - mms:c53 + 19/8)
ion_temperature = mms:c61/(mms:c23 - mms:c53 + 19/8)
potential = 0
pressure_potential = -mms:c59*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5
current_potential = -3*mms:c39*(1 - cos(2*pi*x))^2*cos(2*pi*x)/1250 - 3*mms:c39*(1 - cos(2*pi*x))*sin(2*pi*x)^2/625 + pi^2*(1 - cos(2*pi*x))^3*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/1250

[Ni]
solution = mms:c9 + 1
source = mms:c103*mms:c109*(2*mms:c9 + 2) - pi*mms:c103*sin(2*pi*x)*cos(t/5 - y)/(50*(mms:c23 - mms:c26 + 11/4)) + mms:c117 - 2*mms:c74*(mms:c9 + 1)/(mms:c23 - mms:c26 + 11/4) - 2*mms:c82*(mms:c9 + 1)/(mms:c23 - mms:c26 + 11/4) - mms:c90*mms:c98*(2*mms:c9 + 2) + 3*pi*mms:c90*sin(t/5 + z)/(250*(mms:c23 - mms:c26 + 11/4)) - sin(t/5 - y)*cos(2*pi*x)/100 - 3*sin(t/5 + z)/500
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = mms:c17
source = 3*mms:c103*mms:c107/(400*mms:c118) + pi*mms:c132*mms:c28 + pi*mms:c134*mms:c17 + mms:c138 - 3*mms:c17*mms:c74/mms:c118 - 3*mms:c17*mms:c82/mms:c118 - pi*mms:c90*mms:c96/mms:c118 + 3*mms:c128*mms:c17/mms:c118^2 - 3*mms:c17*mms:c90*(-3*mms:c126/200 + 3*pi*sin(t/5 + z)/125)/mms:c118^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c22*(mms:c23 + 2)
source = 2*mms:c103*mms:c109*mms:c22*(mms:c23 + 2) - pi*mms:c103*mms:c22*sin(2*pi*x)*cos(t/5 - y)/(25*(mms:c23 - mms:c26 + 11/4)) + pi*mms:c103*(mms:c23 + 2)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/(125*(mms:c23 - mms:c26 + 11/4)) - mms:c140*mms:c22 + pi*mms:c142*mms:c22*(mms:c23 + 2) + mms:c146*(mms:c9 + 1) + mms:c152*(mms:c9 + 1) + pi*mms:c155*mms:c90*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) + pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/50 - 2*mms:c22*mms:c74*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) - 2*mms:c22*mms:c82*(mms:c23 + 2)/(mms:c23 - mms:c26 + 11/4) - 2*mms:c22*mms:c90*mms:c98*(mms:c23 + 2) + 3*pi*mms:c22*mms:c90*sin(t/5 + z)/(125*(mms:c23 - mms:c26 + 11/4)) + pi*mms:c61*sin(t/5 - y)*cos(2*pi*x)/(100*(mms:c23 - mms:c53 + 19/8)) + (-mms:c116 + sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250)*(mms:c23 + 2)
bndry_xin = neumann
bndry_xout = neumann

[NVj]
solution = mms:c28*(3/4 - mms:c26)
source = 9*mms:c103*mms:c107*mms:c28/(400*mms:c118) + mms:c103*mms:c107*(27/4000 - 9*mms:c26/1000)/mms:c118 + pi*mms:c132*mms:c61/(mms:c23 - mms:c53 + 19/8) + mms:c146*mms:c17 + mms:c152*mms:c17 + pi*mms:c159*mms:c28^2 + pi*mms:c160*mms:c28*(3/4 - mms:c26) + mms:c28*(mms:c159 - mms:c96) + (3/4 - mms:c26)*(mms:c134 - 3*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/1000) - 9*mms:c126*mms:c28*mms:c90/(400*mms:c118) - mms:c126*mms:c90*(27/4000 - 9*mms:c26/1000)/mms:c118 - 3*mms:c28*mms:c74*(3/4 - mms:c26)/mms:c118 - 3*mms:c28*mms:c82*(3/4 - mms:c26)/mms:c118 + 3*mms:c128*mms:c28*(3/4 - mms:c26)/mms:c118^2 - 3*mms:c28*mms:c90*(3/4 - mms:c26)*(-3*mms:c126/200 + 3*pi*sin(t/5 + z)/125)/mms:c118^2
bndry_xin = neumann
bndry_xout = neumann

[Pe]
solution = mms:c30*(-mms:c31 + mms:c9 + 3/2)
source = -pi*mms:c172*(mms:c22*(mms:c9 + 1) + mms:c28*(1/2 - mms:c31)) - 2*mms:c180/3 + 2*mms:c30*((-mms:c176 - pi*sin(t/5 - y)*cos(2*pi*x)/100)*(mms:c22*(mms:c9 + 1) + mms:c28*(1/2 - mms:c31))/(-mms:c31 + mms:c9 + 3/2)^2 + (mms:c117 + pi*mms:c134*(1/2 - mms:c31) + mms:c176*mms:c28)/(-mms:c31 + mms:c9 + 3/2))*(-mms:c31 + mms:c9 + 3/2)/3 + mms:c30*(mms:c117 + pi*mms:c134*(1/2 - mms:c31) + mms:c176*mms:c28) + mms:c30*(-mms:c171 + sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/200 - cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200) + (mms:c172 - cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/100)*(-mms:c31 + mms:c9 + 3/2)
bndry_xin = neumann
bndry_xout = neumann

[Vort]
solution = -6*mms:c39*(1 - cos(2*pi*x))^2*cos(2*pi*x)/25 - 12*mms:c39*(1 - cos(2*pi*x))*sin(2*pi*x)^2/25 + 2*pi^2*(1 - cos(2*pi*x))^3*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)/25
source = where(x*(1-x),-pi^2*mms:c145/62500 - 6*mms:c183*(1 - cos(2*pi*x))^2*cos(2*pi*x)/125 - 12*mms:c183*(1 - cos(2*pi*x))*sin(2*pi*x)^2/125 + pi^4*mms:c59*sin(t/5 - z)/15625 + 2*pi^2*mms:c59*cos(t/5 - z)/125 - 9*mms:c71*(1 - cos(2*pi*x))^2*cos(2*pi*x)/15625 - 36*mms:c71*(1 - cos(2*pi*x))*sin(2*pi*x)^2/15625 + 18*mms:c71*(1 - cos(2*pi*x))*cos(2*pi*x)^2/15625 + 36*mms:c71*sin(2*pi*x)^2*cos(2*pi*x)/15625 + 3*pi^2*(1 - cos(2*pi*x))^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/62500 + 3*pi^2*(1 - cos(2*pi*x))*sin(2*pi*x)^2*sin(t/5 + y)*sin(t/5 - z)/31250,0)

[Eion]
solution = 3*mms:c17*mms:c61/(2*(mms:c23 - mms:c53 + 19/8)) + mms:c22^2*(mms:c9 + 1) + mms:c28^2*(3/8 - mms:c53) + mms:c50*cos(t/5 - z)^2/25 + 9*pi^2*mms:c52*(cos(t/5 + y)/1000 + 1/50)^2/25 + 3*mms:c61*(mms:c9 + 1)/(2*(mms:c23 - mms:c53 + 19/8))
source = 3*mms:c103*mms:c194/5 + mms:c103*(3*mms:c109*mms:c197/2 + 2*mms:c109*mms:c198 + 3*(3*mms:c107*mms:c28^2/800 + 3*mms:c107*mms:c28*(3/8 - mms:c53)/500 + mms:c107*mms:c61/(160*(mms:c23 - mms:c53 + 19/8)) - 3*mms:c17*mms:c194/(mms:c23 - mms:c53 + 19/8) + 5*mms:c17*mms:c210*mms:c61/(2*(mms:c23 - mms:c53 + 19/8)^2))/(2*(mms:c23 - mms:c26 + 11/4)) + 2*(-3*mms:c194*(mms:c9 + 1)/(mms:c23 - mms:c53 + 19/8) + 5*mms:c210*mms:c61*(mms:c9 + 1)/(2*(mms:c23 - mms:c53 + 19/8)^2) - pi*mms:c22^2*sin(2*pi*x)*cos(t/5 - y)/100 + pi*mms:c22*(mms:c9 + 1)*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/125 - pi*mms:c61*sin(2*pi*x)*cos(t/5 - y)/(40*(mms:c23 - mms:c53 + 19/8)))/(mms:c23 - mms:c26 + 11/4)) + pi*mms:c116*mms:c198 + pi*mms:c134*mms:c197 + 3*mms:c138*mms:c61/(2*(mms:c23 - mms:c53 + 19/8)) + 3*mms:c17*mms:c192/2 + 3*mms:c17*mms:c61*(mms:c140 - mms:c148 + mms:c187)/(2*(mms:c23 - mms:c53 + 19/8)^2) - mms:c171*mms:c22^2 - 3*mms:c171*mms:c61/(2*(mms:c23 - mms:c53 + 19/8)) + mms:c180 + mms:c192*(3*mms:c9/2 + 3/2) - mms:c202*mms:c74 - mms:c202*mms:c82 + mms:c22*(-mms:c142 + mms:c155)*(mms:c9 + 1) + mms:c22*(pi*mms:c142*mms:c22*(mms:c9 + 1) + 5*mms:c146*(mms:c9 + 1)/2 + 5*mms:c152*(mms:c9 + 1)/2 + pi*mms:c22^2*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c61*sin(t/5 - y)*cos(2*pi*x)/(40*(mms:c23 - mms:c53 + 19/8))) + mms:c28^2*(mms:c148 - mms:c187) + mms:c28*(3/8 - mms:c53)*(mms:c160 - mms:c188) + mms:c28*(5*mms:c146*mms:c17/2 + pi*mms:c148*mms:c28^2 + 5*mms:c152*mms:c17/2 + pi*mms:c160*mms:c28*(3/8 - mms:c53) + pi*mms:c61*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)/(160*(mms:c23 - mms:c53 + 19/8))) - 2*mms:c50*sin(t/5 - z)*cos(t/5 - z)/125 - 9*pi^2*mms:c52*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 + y)/62500 + pi*mms:c59*mms:c90*cos(t/5 - z)/5 + mms:c61*(3*mms:c9/2 + 3/2)*(mms:c140 - mms:c148 + mms:c187)/(mms:c23 - mms:c53 + 19/8)^2 + mms:c74*(-mms:c59*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5) + mms:c82*(-mms:c59*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5) - mms:c90*(3*mms:c197*mms:c98/2 + 2*mms:c198*mms:c98 + 3*(mms