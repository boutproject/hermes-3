# Template; regenerate committed variants using python mms.py --all.
periodicX = false
NXPE = 1
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
adams_moulton = true
func_iter = true
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true
use_div_par_fvv = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true
phi_dissipation = true

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
implementation = conservative
diagnose = true

[mms]
variant = parallel_current
c13 = 3*sin(pi*x)^2*cos(t/5 + z)/100 + cos(2*pi*x)*cos(t/5 - y)/20
c21 = sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)
c28 = -sin(pi*x)^2*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c29 = 3*sin(pi*x)^2*cos(t/5 + z)/50 + cos(2*pi*x)*cos(t/5 - y)/10
c36 = -3*sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c38 = -sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c50 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c56 = pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*sin(t/5 - z)
c58 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*cos(2*pi*x)
c63 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c64 = (1 - cos(2*pi*x))^2*(cos(t/5 + y)/1000 + 1/50)
c72 = pi*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)
c74 = -2*mms:c72/5 + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c78 = -2*mms:c64*sin(t/5 - z) + 2*cos(t/5 - y)/25 + 12/5
c84 = mms:c28^2*(mms:c13 + 1) + 3*mms:c78*(mms:c13 + 1)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c89 = mms:c36^2*(3/8 - 3*mms:c21/160) + 3*mms:c78*(1/4 - mms:c21/80)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c95 = mms:c28*(mms:c13 + 1)/1836 + mms:c36*(1/2 - mms:c21/40)/1836 + sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/61200
c104 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/500 - pi*sin(2*pi*x)*cos(t/5 - y)/100
c111 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c118 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c121 = pi^2*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*cos(t/5 - z)
c125 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c132 = -4*(1 - cos(2*pi*x))^2 - 16*(cos(2*pi*x) - 1)*cos(2*pi*x) + 16*sin(2*pi*x)^2
c136 = -pi^2*mms:c111*((-18*pi*sin(pi*x)/85 + 117*pi*sin(3*pi*x)/125 - 21*pi*sin(5*pi*x)/41)*sin(t/5 - z)^2 - 8*pi*sin(pi*x)/85 + 54*pi*sin(3*pi*x)/125 - 10*pi*sin(5*pi*x)/41)/50 + mms:c118*mms:c74/50 + mms:c125*(mms:c118/50 + 2*mms:c121/25) - pi^2*mms:c50*(mms:c63 + pi*mms:c64*cos(t/5 - z)/5)/25 + mms:c63*(-pi^2*mms:c50/25 + pi^2*mms:c64*sin(t/5 - z)/25) + pi^3*(mms:c111*(mms:c132*sin(pi*x)*sin(t/5 - z)^2 + 4*(1 - cos(2*pi*x))^2*sin(pi*x)*cos(t/5 - z)^2 + 4*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(pi*x)) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500 - 3*sin(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/200
c142 = pi*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c144 = pi^3*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/250
c146 = pi^3*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/500
c148 = mms:c118*(-pi^2*mms:c50/25 + pi^2*mms:c64*sin(t/5 - z)/25)/50
c150 = mms:c63*(-mms:c144 + 2*pi^3*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125)
c155 = pi^2*mms:c111*((-9*pi^2*cos(pi*x)/425 + 351*pi^2*cos(3*pi*x)/1250 - 21*pi^2*cos(5*pi*x)/82)*sin(t/5 - z)^2 - 4*pi^2*cos(pi*x)/425 + 81*pi^2*cos(3*pi*x)/625 - 5*pi^2*cos(5*pi*x)/41)/50
c156 = (cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*cos(t/5 - z)
c158 = mms:c125*(-mms:c146 + 2*pi^3*mms:c156/125 + 2*pi^3*mms:c58*cos(t/5 - z)/125)
c160 = -pi^2*mms:c50/100 - 2*mms:c56/25 - 2*pi^2*mms:c58*sin(t/5 - z)/25
c163 = 2*pi*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(t/5 - z)
c165 = pi*(1 - cos(2*pi*x))*sin(pi*x)*sin(2*pi*x)
c167 = mms:c118*mms:c160/50 - 3*mms:c142/1000 - mms:c144*(mms:c63 + pi*mms:c64*cos(t/5 - z)/5) - mms:c146*mms:c74 + mms:c148 + mms:c150 - mms:c155 + mms:c158 - pi^2*mms:c50*(mms:c118/50 + 2*mms:c121/25)/20 + pi^3*(mms:c111*(pi*mms:c132*sin(t/5 - z)^2*cos(pi*x)/10 + 8*mms:c165*cos(t/5 - z)^2/5 - 2*mms:c165/5 + 2*pi*(1 - cos(2*pi*x))^2*cos(pi*x)*cos(t/5 - z)^2/5 + 4*pi*(1 - cos(2*pi*x))*cos(pi*x)*cos(2*pi*x)/5 + (-8*pi*(1 - cos(2*pi*x))*sin(2*pi*x)/5 + 16*pi*(cos(2*pi*x) - 1)*sin(2*pi*x)/5 + 48*pi*sin(2*pi*x)*cos(2*pi*x)/5)*sin(pi*x)*sin(t/5 - z)^2 + 4*pi*sin(2*pi*x)^2*cos(pi*x)/5) + mms:c163)/500
c169 = 6*(1 - cos(2*pi*x))*sin(pi*x)*sin(2*pi*x) + (-6*(1 - cos(2*pi*x))^2 - 4*(cos(2*pi*x) - 1)*cos(2*pi*x) + 4*sin(2*pi*x)^2)*cos(pi*x)
c172 = 36*cos(pi*x)/17 - 78*cos(3*pi*x)/25 + 42*cos(5*pi*x)/41
c174 = pi^4*mms:c111*mms:c172*cos(t/5 - z)^2/625 - pi^4*mms:c172*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*sin(t/5 - z)^2/625
c175 = -mms:c118*mms:c160/50 - 3*mms:c142/1000 + mms:c144*(mms:c63 + pi*mms:c64*cos(t/5 - z)/5) + mms:c146*mms:c74 - mms:c148 - mms:c150 - mms:c158 - mms:c174 + pi^2*mms:c50*(mms:c118/50 + 2*mms:c121/25)/20 + pi^3*(-pi*mms:c111*mms:c169*sin(t/5 - z)^2/5 - mms:c163 + pi*mms:c169*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)^2/5)/500
c178 = pi^3*mms:c111*mms:c172*sin(t/5 - z)*cos(t/5 - z)/125 - mms:c118*(mms:c63 + pi*mms:c64*cos(t/5 - z)/5)/50 - mms:c125*mms:c160 + pi^2*mms:c50*mms:c74/100 - mms:c63*(mms:c118/50 + 2*mms:c121/25) + pi^3*(-mms:c111*mms:c169*sin(t/5 - z)*cos(t/5 - z) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500 + 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/200
c182 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c185 = (-3*pi*mms:c182/400 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c187 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/250 - pi*sin(2*pi*x)*cos(t/5 - y)/50
c189 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c190 = pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)
c192 = (-mms:c187 - 3*mms:c189/400 + 3*mms:c190/400)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c198 = mms:c142*(mms:c13 + 1)*sin(pi*x)^2/250 + pi*mms:c28*sin(t/5 - y)*cos(2*pi*x)/100
c199 = -3*mms:c21/40 + 3*sin(pi*x)^2*cos(t/5 + z)/25 + cos(2*pi*x)*cos(t/5 - y)/5 + 11/2
c209 = mms:c178*(3*pi*sin(pi*x)^2*sin(t/5 + z)/125 - 3*pi*sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)
c210 = mms:c136*(-3*pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/200 + 3*pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)/200 - 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/125 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c212 = sin(pi*x)^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c221 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c222 = 3*sin(pi*x)^2*sin(t/5 + z)/250 + sin(t/5 - y)*cos(2*pi*x)/50
c224 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c225 = mms:c224 - sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c229 = (1 - cos(2*pi*x))^2*sin(t/5 + y)*sin(t/5 - z)
c230 = (pi*mms:c229/2500 + 2*pi*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c237 = mms:c78*(-3*pi*mms:c212/800 - pi*sin(t/5 - y)*cos(2*pi*x)/50)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c241 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c242 = pi*sin(pi*x)*sin(t/5 - y)*cos(pi*x)*cos(2*pi*x)*cos(t/5 - z)
c245 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)
c264 = 3*sin(pi*x)^2*sin(t/5 + z)/500 + sin(t/5 - y)*cos(2*pi*x)/100
c265 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c266 = 3*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/100
c269 = pi*sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c275 = mms:c198 + pi*mms:c212*mms:c36/200 + 3*pi*mms:c212*(1/2 - mms:c21/40)/1000
c277 = pi*mms:c212/200 + pi*sin(t/5 - y)*cos(2*pi*x)/100
c278 = -mms:c277*(mms:c266 + mms:c28*(mms:c13 + 1) + mms:c36*(1/2 - mms:c21/40))/(mms:c13 - mms:c21/40 + 3/2)^2
c288 = (-2*mms:c64*cos(t/5 - z)/5 + (1 - cos(2*pi*x))^2*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c290 = mms:c78*(3*mms:c182/800 - 3*mms:c212/800 + mms:c222)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c294 = 3*pi*mms:c28^2*sin(pi*x)^2*sin(t/5 + z)/500
c296 = -3*pi*mms:c182/800 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250
c298 = 9*pi*mms:c78*sin(pi*x)^2*sin(t/5 + z)/(1000*(-3*mms:c21/160 + mms:c29 + 19/8))
c300 = 3*mms:c64*cos(t/5 - z)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c302 = 3*pi*mms:c182*mms:c36^2/800 + 3*pi*mms:c182*mms:c36*(3/8 - 3*mms:c21/160)/500 + 3*pi*mms:c182*mms:c78/(800*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c296*mms:c78*(3/8 - 3*mms:c21/160)/(-3*mms:c21/160 + mms:c29 + 19/8)^2 + pi*mms:c300*(1/4 - mms:c21/80)
c305 = mms:c78*(-mms:c187 - 3*mms:c189/800 + 3*mms:c190/800)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c306 = mms:c104*mms:c28^2 + 3*mms:c104*mms:c78/(2*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c28*(mms:c13 + 1)*(mms:c241/125 - mms:c242/125) + mms:c305*(3*mms:c13/2 + 3/2) - 6*mms:c72*(mms:c13 + 1)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c307 = mms:c305*(3/8 - 3*mms:c21/160) + mms:c36^2*(3*mms:c189/800 - 3*mms:c190/800) + mms:c36*(3/8 - 3*mms:c21/160)*(3*mms:c189/500 - 3*mms:c190/500) - 6*mms:c72*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + 3*mms:c78*(mms:c189/400 - mms:c190/400)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c310 = mms:c50 - mms:c64*sin(t/5 - z) + 2*mms:c84/(-3*mms:c21/80 + mms:c29 + 11/4) + 3*mms:c89/(2*(-3*mms:c21/80 + mms:c29 + 11/4)) + cos(t/5 - y)/25 + 6/5
c313 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/306000
c314 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/306000
total_pressure = mms:c78*(1/4 - mms:c21/80)/(-3*mms:c21/160 + mms:c29 + 19/8) + mms:c78*(mms:c13 + 1)/(-3*mms:c21/160 + mms:c29 + 19/8)
pressure_i = mms:c78*(mms:c13 + 1)/(-3*mms:c21/160 + mms:c29 + 19/8)
pressure_j = mms:c78*(1/4 - mms:c21/80)/(-3*mms:c21/160 + mms:c29 + 19/8)
ion_temperature = mms:c78/(-3*mms:c21/160 + mms:c29 + 19/8)
potential = mms:c50
pressure_potential = -mms:c64*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c111*(mms:c172*sin(t/5 - z)^2 + 16*cos(pi*x)/17 - 36*cos(3*pi*x)/25 + 20*cos(5*pi*x)/41)/100 - 3*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/(80*pi)
electron_temperature = mms:c38
parallel_current = -mms:c266
parallel_current_divergence = 3*mms:c142/500

[Ve]
bndry_xin = neumann
bndry_xout = neumann

[Ni]
solution = mms:c13 + 1
source = 2*mms:c104*mms:c136/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c104*mms:c63 + mms:c136*mms:c192*(2*mms:c13 + 2) + 2*mms:c167*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c175*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c178*mms:c185*(2*mms:c13 + 2) - 3*pi*mms:c178*sin(pi*x)^2*sin(t/5 + z)/(250*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c198 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - 3*sin(pi*x)^2*sin(t/5 + z)/500 - sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = 1/4 - mms:c21/80
source = 3*mms:c136*(mms:c189/400 - mms:c190/400)/mms:c199 + 3*mms:c167*(1/4 - mms:c21/80)/mms:c199 + 3*mms:c175*(1/4 - mms:c21/80)/mms:c199 + 3*pi*mms:c178*mms:c182/(400*mms:c199) - mms:c182/400 + pi*mms:c212*mms:c36/400 + 3*pi*mms:c212*(1/4 - mms:c21/80)/1000 + mms:c212/400 + mms:c63*(mms:c189/400 - mms:c190/400) - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000 + 3*mms:c209*(1/4 - mms:c21/80)/mms:c199^2 + 3*mms:c210*(1/4 - mms:c21/80)/mms:c199^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c28*(mms:c29 + 2)
