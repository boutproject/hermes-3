# Template; regenerate committed variants using python mms.py --all.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 20
ny = 16
nz = 16
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 1
g12 = 0
g13 = 0
g23 = 0
g_11 = 1
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = 0
g_23 = 0
bxcvx = 0
bxcvy = 0
# Baseline, skew and viscosity retain their original zero curvature.
# The curvature variant uses a finite total-pressure mode and an analytic chi
# inverse (see README).
bxcvz = 0

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 5
output_step = 1
atol = 1e-12
rtol = 1e-10
max_timestep = 0.05
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true
use_div_par_fvv = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true
phi_dissipation = true

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
implementation = conservative
diagnose = true

[mms]
variant = parallel_current
c13 = 3*sin(pi*x)^2*cos(t/5 + z)/100 + cos(2*pi*x)*cos(t/5 - y)/20
c21 = sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)
c28 = -sin(pi*x)^2*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c29 = 3*sin(pi*x)^2*cos(t/5 + z)/50 + cos(2*pi*x)*cos(t/5 - y)/10
c36 = -3*sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)/200 + 7/100
c38 = -sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/20 + 1
c51 = (sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)
c58 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*cos(2*pi*x)
c59 = 4*pi^2*mms:c58*sin(t/5 - z)/25 + 4*pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*sin(t/5 - z)/25
c62 = pi*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/5
c63 = ((1 - cos(2*pi*x))^2 + 1)*(cos(t/5 + y)/1000 + 1/50)
c71 = pi*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)
c73 = -2*mms:c71/5 + pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c77 = -2*mms:c63*sin(t/5 - z) + 2*cos(t/5 - y)/25 + 12/5
c83 = mms:c28^2*(mms:c13 + 1) + 3*mms:c77*(mms:c13 + 1)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c88 = mms:c36^2*(3/8 - 3*mms:c21/160) + 3*mms:c77*(1/4 - mms:c21/80)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c94 = mms:c28*(mms:c13 + 1)/1836 + mms:c36*(1/2 - mms:c21/40)/1836 + sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/61200
c103 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/500 - pi*sin(2*pi*x)*cos(t/5 - y)/100
c107 = pi^2*(sin(t/5 + y)/50 + 1/5)*sin(t/5 - z)*cos(pi*x)
c112 = (1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*cos(t/5 - z)
c116 = pi*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/10
c124 = (sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)
c131 = (4*(1 - cos(2*pi*x))^2 + 4)*cos(t/5 - z)^2
c133 = -4*(1 - cos(2*pi*x))^2 - 16*(cos(2*pi*x) - 1)*cos(2*pi*x) + 16*sin(2*pi*x)^2 - 4
c137 = mms:c107*mms:c73/50 + mms:c116*(mms:c107/50 + 2*pi^2*mms:c112/25) - pi^2*mms:c124*((-18*pi*sin(pi*x)/85 + 117*pi*sin(3*pi*x)/125 - 21*pi*sin(5*pi*x)/41)*sin(t/5 - z)^2 - 4*pi*sin(pi*x)*cos(2*t/5 - 2*z)/85 - 8*pi*sin(pi*x)/85 + 54*pi*sin(3*pi*x)/125 - 10*pi*sin(5*pi*x)/41)/50 - pi^2*mms:c51*(mms:c62 + pi*mms:c63*cos(t/5 - z)/5)/25 + mms:c62*(-pi^2*mms:c51/25 + pi^2*mms:c63*sin(t/5 - z)/25) + pi^3*(mms:c124*(mms:c131*sin(pi*x) + mms:c133*sin(pi*x)*sin(t/5 - z)^2 + 4*(1 - cos(2*pi*x))*sin(2*pi*x)*cos(pi*x)) + 10*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)^2*sin(t/5 - z)*cos(t/5 - z))/500 - 3*sin(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/200
c143 = pi*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c145 = pi^3*(sin(t/5 + y)/50 + 1/5)*cos(pi*x)*cos(t/5 - z)/250
c147 = pi^3*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*sin(t/5 - z)/500
c150 = mms:c62*(-mms:c145 + 2*pi^3*(1 - cos(2*pi*x))*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)*sin(t/5 - z)/125)
c151 = mms:c107*(-pi^2*mms:c51/25 + pi^2*mms:c63*sin(t/5 - z)/25)/50
c157 = pi^2*mms:c124*((-9*pi^2*cos(pi*x)/425 + 351*pi^2*cos(3*pi*x)/1250 - 21*pi^2*cos(5*pi*x)/82)*sin(t/5 - z)^2 - 2*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425 - 4*pi^2*cos(pi*x)/425 + 81*pi^2*cos(3*pi*x)/625 - 5*pi^2*cos(5*pi*x)/41)/50
c158 = (cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*cos(t/5 - z)
c160 = mms:c116*(-mms:c147 + 2*pi^3*mms:c158/125 + 2*pi^3*mms:c58*cos(t/5 - z)/125)
c162 = -pi^2*mms:c51/100 - 2*pi^2*mms:c58*sin(t/5 - z)/25 - 2*pi^2*(cos(t/5 + y)/1000 + 1/50)*sin(2*pi*x)^2*sin(t/5 - z)/25
c165 = 2*pi*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(t/5 - z)
c167 = pi*(1 - cos(2*pi*x))*sin(pi*x)*sin(2*pi*x)
c169 = mms:c107*mms:c162/50 - 3*mms:c143/1000 - mms:c145*(mms:c62 + pi*mms:c63*cos(t/5 - z)/5) - mms:c147*mms:c73 + mms:c150 + mms:c151 - mms:c157 + mms:c160 - pi^2*mms:c51*(mms:c107/50 + 2*pi^2*mms:c112/25)/20 + pi^3*(mms:c124*(pi*mms:c131*cos(pi*x)/10 + pi*mms:c133*sin(t/5 - z)^2*cos(pi*x)/10 + 8*mms:c167*cos(t/5 - z)^2/5 - 2*mms:c167/5 + 4*pi*(1 - cos(2*pi*x))*cos(pi*x)*cos(2*pi*x)/5 + (-8*pi*(1 - cos(2*pi*x))*sin(2*pi*x)/5 + 16*pi*(cos(2*pi*x) - 1)*sin(2*pi*x)/5 + 48*pi*sin(2*pi*x)*cos(2*pi*x)/5)*sin(pi*x)*sin(t/5 - z)^2 + 4*pi*sin(2*pi*x)^2*cos(pi*x)/5) + mms:c165)/500
c171 = 36*cos(pi*x)/17 - 78*cos(3*pi*x)/25 + 42*cos(5*pi*x)/41
c173 = pi^2*mms:c124*(-2*pi^2*mms:c171*sin(t/5 - z)^2/25 + 2*pi^2*mms:c171*cos(t/5 - z)^2/25 - 32*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/425)/50
c174 = 6*(1 - cos(2*pi*x))*sin(pi*x)*sin(2*pi*x) + (-6*(1 - cos(2*pi*x))^2 - 4*(cos(2*pi*x) - 1)*cos(2*pi*x) + 4*sin(2*pi*x)^2 - 6)*cos(pi*x)
c176 = -mms:c107*mms:c162/50 - 3*mms:c143/1000 + mms:c145*(mms:c62 + pi*mms:c63*cos(t/5 - z)/5) + mms:c147*mms:c73 - mms:c150 - mms:c151 - mms:c160 - mms:c173 + pi^2*mms:c51*(mms:c107/50 + 2*pi^2*mms:c112/25)/20 + pi^3*(-pi*mms:c124*mms:c174*sin(t/5 - z)^2/5 - mms:c165 + pi*mms:c174*(sin(t/5 + y)/50 + 1/5)*(cos(t/5 + y)/1000 + 1/50)*cos(t/5 - z)^2/5)/500
c179 = -mms:c107*(mms:c62 + pi*mms:c63*cos(t/5 - z)/5)/50 - mms:c116*mms:c162 - pi^2*mms:c124*(-2*pi*mms:c171*sin(t/5 - z)*cos(t/5 - z)/5 + 16*pi*sin(2*t/5 - 2*z)*cos(pi*x)/85)/50 - mms:c62*(mms:c107/50 + 2*pi^2*mms:c112/25) + pi^2*mms:c73*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)*cos(t/5 - z)/100 + pi^3*(-mms:c124*mms:c174*sin(t/5 - z)*cos(t/5 - z) - 5*(sin(t/5 + y)/50 + 1/5)^2*sin(pi*x)*cos(pi*x)*cos(t/5 - z)^2)/500 + 3*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/200
c183 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c186 = (-3*pi*mms:c183/400 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c188 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/250 - pi*sin(2*pi*x)*cos(t/5 - y)/50
c190 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)
c191 = pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)
c193 = (-mms:c188 - 3*mms:c190/400 + 3*mms:c191/400)/(-3*mms:c21/80 + mms:c29 + 11/4)^2
c199 = mms:c143*(mms:c13 + 1)*sin(pi*x)^2/250 + pi*mms:c28*sin(t/5 - y)*cos(2*pi*x)/100
c200 = -3*mms:c21/40 + 3*sin(pi*x)^2*cos(t/5 + z)/25 + cos(2*pi*x)*cos(t/5 - y)/5 + 11/2
c210 = mms:c179*(3*pi*sin(pi*x)^2*sin(t/5 + z)/125 - 3*pi*sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)/200)
c211 = mms:c137*(-3*pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 + y)/200 + 3*pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)/200 - 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/125 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c213 = sin(pi*x)^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c222 = pi*sin(pi*x)*cos(t/5 + y)*cos(t/5 - z)/250
c223 = 3*sin(pi*x)^2*sin(t/5 + z)/250 + sin(t/5 - y)*cos(2*pi*x)/50
c225 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c226 = mms:c225 - sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c231 = ((1 - cos(2*pi*x))^2 + 1)*sin(t/5 + y)*sin(t/5 - z)
c232 = (pi*mms:c231/2500 + 2*pi*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c238 = mms:c77*(-3*pi*mms:c213/800 - pi*sin(t/5 - y)*cos(2*pi*x)/50)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c242 = pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)
c243 = pi*sin(pi*x)*sin(t/5 - y)*cos(pi*x)*cos(2*pi*x)*cos(t/5 - z)
c246 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)
c265 = 3*sin(pi*x)^2*sin(t/5 + z)/500 + sin(t/5 - y)*cos(2*pi*x)/100
c266 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c267 = 3*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/100
c270 = pi*sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/100
c276 = mms:c199 + pi*mms:c213*mms:c36/200 + 3*pi*mms:c213*(1/2 - mms:c21/40)/1000
c278 = pi*mms:c213/200 + pi*sin(t/5 - y)*cos(2*pi*x)/100
c279 = -mms:c278*(mms:c267 + mms:c28*(mms:c13 + 1) + mms:c36*(1/2 - mms:c21/40))/(mms:c13 - mms:c21/40 + 3/2)^2
c289 = (-2*mms:c63*cos(t/5 - z)/5 + ((1 - cos(2*pi*x))^2 + 1)*sin(t/5 + y)*sin(t/5 - z)/2500 - 2*sin(t/5 - y)/125)/(-3*mms:c21/160 + mms:c29 + 19/8)
c291 = mms:c77*(3*mms:c183/800 - 3*mms:c213/800 + mms:c223)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c295 = 3*pi*mms:c28^2*sin(pi*x)^2*sin(t/5 + z)/500
c297 = -3*pi*mms:c183/800 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250
c299 = 9*pi*mms:c77*sin(pi*x)^2*sin(t/5 + z)/(1000*(-3*mms:c21/160 + mms:c29 + 19/8))
c301 = 3*mms:c63*cos(t/5 - z)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c303 = 3*pi*mms:c183*mms:c36^2/800 + 3*pi*mms:c183*mms:c36*(3/8 - 3*mms:c21/160)/500 + 3*pi*mms:c183*mms:c77/(800*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c297*mms:c77*(3/8 - 3*mms:c21/160)/(-3*mms:c21/160 + mms:c29 + 19/8)^2 + pi*mms:c301*(1/4 - mms:c21/80)
c306 = mms:c77*(-mms:c188 - 3*mms:c190/800 + 3*mms:c191/800)/(-3*mms:c21/160 + mms:c29 + 19/8)^2
c307 = mms:c103*mms:c28^2 + 3*mms:c103*mms:c77/(2*(-3*mms:c21/160 + mms:c29 + 19/8)) + mms:c28*(mms:c13 + 1)*(mms:c242/125 - mms:c243/125) + mms:c306*(3*mms:c13/2 + 3/2) - 6*mms:c71*(mms:c13 + 1)/(5*(-3*mms:c21/160 + mms:c29 + 19/8))
c308 = mms:c306*(3/8 - 3*mms:c21/160) + mms:c36^2*(3*mms:c190/800 - 3*mms:c191/800) + mms:c36*(3/8 - 3*mms:c21/160)*(3*mms:c190/500 - 3*mms:c191/500) - 6*mms:c71*(1/4 - mms:c21/80)/(5*(-3*mms:c21/160 + mms:c29 + 19/8)) + 3*mms:c77*(mms:c190/400 - mms:c191/400)/(2*(-3*mms:c21/160 + mms:c29 + 19/8))
c311 = mms:c51 - mms:c63*sin(t/5 - z) + 2*mms:c83/(-3*mms:c21/80 + mms:c29 + 11/4) + 3*mms:c88/(2*(-3*mms:c21/80 + mms:c29 + 11/4)) + cos(t/5 - y)/25 + 6/5
c314 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/306000
c315 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/306000
total_pressure = mms:c77*(1/4 - mms:c21/80)/(-3*mms:c21/160 + mms:c29 + 19/8) + mms:c77*(mms:c13 + 1)/(-3*mms:c21/160 + mms:c29 + 19/8)
pressure_i = mms:c77*(mms:c13 + 1)/(-3*mms:c21/160 + mms:c29 + 19/8)
pressure_j = mms:c77*(1/4 - mms:c21/80)/(-3*mms:c21/160 + mms:c29 + 19/8)
ion_temperature = mms:c77/(-3*mms:c21/160 + mms:c29 + 19/8)
potential = mms:c51
pressure_potential = -mms:c63*sin(t/5 - z) + cos(t/5 - y)/25 + 6/5
current_potential = pi^2*mms:c124*(mms:c171*sin(t/5 - z)^2 + 8*cos(pi*x)*cos(2*t/5 - 2*z)/17 + 16*cos(pi*x)/17 - 36*cos(3*pi*x)/25 + 20*cos(5*pi*x)/41)/100 - 3*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/(80*pi)
electron_temperature = mms:c38
parallel_current = -mms:c267
parallel_current_divergence = 3*mms:c143/500

[Ve]
bndry_xin = neumann
bndry_xout = neumann

[Ni]
solution = mms:c13 + 1
source = 2*mms:c103*mms:c137/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c103*mms:c62 + mms:c137*mms:c193*(2*mms:c13 + 2) + 2*mms:c169*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + 2*mms:c176*(mms:c13 + 1)/(-3*mms:c21/80 + mms:c29 + 11/4) + mms:c179*mms:c186*(2*mms:c13 + 2) - 3*pi*mms:c179*sin(pi*x)^2*sin(t/5 + z)/(250*(-3*mms:c21/80 + mms:c29 + 11/4)) + mms:c199 + 3*pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*sin(t/5 + z)*cos(pi*x)*cos(t/5 - z)/5000 - 3*sin(pi*x)^2*sin(t/5 + z)/500 - sin(t/5 - y)*cos(2*pi*x)/100
bndry_xin = neumann
bndry_xout = neumann

[Nj]
solution = 1/4 - mms:c21/80
source = 3*mms:c137*(mms:c190/400 - mms:c191/400)/mms:c200 + 3*mms:c169*(1/4 - mms:c21/80)/mms:c200 + 3*mms:c176*(1/4 - mms:c21/80)/mms:c200 + 3*pi*mms:c179*mms:c183/(400*mms:c200) - mms:c183/400 + pi*mms:c213*mms:c36/400 + 3*pi*mms:c213*(1/4 - mms:c21/80)/1000 + mms:c213/400 + mms:c62*(mms:c190/400 - mms:c191/400) - pi^2*(sin(t/5 + y)/50 + 1/5)*sin(pi*x)^2*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)^2/4000 + 3*mms:c210*(1/4 - mms:c21/80)/mms:c200^2 + 3*mms:c211*(1/4 - mms:c21/80)/mms:c200^2
bndry_xin = neumann
bndry_xout = neumann

[NVi]
solution = mms:c28*(mms:c29 + 2)
