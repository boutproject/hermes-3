# Template for the single 3D slab; regenerate with python mms.py.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 12
ny = 16
nz = 8
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 17/16
g12 = 0
g13 = 1/4
g23 = 0
g_11 = 17/16
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = -1/4
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = (1/10)*1.602176634e-19/(2*1.672621898e-27)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 4
output_step = 0.005
atol = 1e-12
rtol = 1e-10
max_timestep = 0.002
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e+18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = false

[e]
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true
use_div_par_fvv = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true
phi_dissipation = true
viscosity = 0.02

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
implementation = conservative
polarisation_corrections = 32
diagnose = true

[mms]
variant = parallel_current_wall
c12 = 3*sin(pi*x)^2*cos(t/5 + z)/100 + cos(2*pi*x)*cos(t/5 - y)/20
c20 = sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 + y)
c27 = -sin(pi*x)^2*sin(t/5 - y)*cos(2*pi*x)*cos(t/5 - z)/50 + 1/10
c28 = 3*sin(pi*x)^2*cos(t/5 + z)/50 + cos(2*pi*x)*cos(t/5 - y)/10
c39 = (1/50 - cos(2*pi*x)/50)*cos(t/5 + pi*x/2 - z)
c44 = (2*mms:c39 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c20/160 + mms:c28 + 19/8)
c48 = -mms:c44*(1/4 - mms:c20/80) - mms:c44*(mms:c12 + 1) - sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)/50 + 4
c54 = (sin(pi*x)/5 - sin(3*pi*x)/39)*cos(t/5 + y)*cos(t/5 + pi*x/2 - z)
c58 = -pi^2*sin(pi*x)/500 + 3*pi^2*sin(3*pi*x)/1300
c64 = (pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*cos(t/5 + y)*cos(t/5 + pi*x/2 - z)
c67 = (sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)
c79 = 3*mms:c44*(1/4 - mms:c20/80)/2 + (7/100 - 3*mms:c20/200)^2*(3/8 - 3*mms:c20/160)
c91 = pi^2*(pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)
c93 = -mms:c91*(-sin(pi*x)/500 + 3*sin(3*pi*x)/1300) + pi^3*(sin(pi*x)/5 - sin(3*pi*x)/39)*(-13*cos(pi*x) + 45*cos(3*pi*x))/65000
c95 = mms:c93*sin(2*t/5 + 2*y)*sin(2*t/5 + pi*x - 2*z)
c109 = 9*pi^2*cos(pi*x)*cos(2*t/5 - 2*z)/5000
c119 = (1/50 - cos(2*pi*x)/50)*sin(t/5 + pi*x/2 - z)
c121 = pi*mms:c119/20 - pi*sin(2*pi*x)*cos(t/5 + pi*x/2 - z)/250
c128 = pi*(pi*cos(pi*x)/1000 - pi*cos(3*pi*x)/2600)*sin(t/5 + pi*x/2 - z)*cos(t/5)
c130 = pi^2*sin(2*pi*x)*sin(t/5 + pi*x/2 - z)
c135 = mms:c130/2500 + pi^2*mms:c39/400 - pi^2*cos(2*pi*x)*cos(t/5 + pi*x/2 - z)/1250
c138 = pi^3*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5 + pi*x/2 - z)*cos(t/5)
c140 = -mms:c138/125 - mms:c91*cos(t/5)*cos(t/5 + pi*x/2 - z)/100
c144 = mms:c128 - pi^2*(sin(pi*x)/5 - sin(3*pi*x)/39)*cos(t/5)*cos(t/5 + pi*x/2 - z)/25
c147 = 3*pi*cos(pi*x)/800 - 3*pi*cos(3*pi*x)/2080
c150 = pi*mms:c147*sin(t/5 + pi*x/2 - z)*cos(t/5) + mms:c58*cos(t/5)*cos(t/5 + pi*x/2 - z)/4 + pi^2*(sin(pi*x)/5 - sin(3*pi*x)/39)*cos(t/5)*cos(t/5 + pi*x/2 - z)/100
c153 = mms:c138/500 + pi*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5)/20 - 3*mms:c91*cos(t/5)*cos(t/5 + pi*x/2 - z)/80
c156 = -pi^3*cos(pi*x)/5000 + 9*pi^3*cos(3*pi*x)/13000
c158 = mms:c156*cos(t/5)*cos(t/5 + pi*x/2 - z) - pi*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5)/10 - mms:c91*cos(t/5)*cos(t/5 + pi*x/2 - z)/400
c159 = -mms:c109*sin(t/5) - 2*pi*mms:c119*mms:c153/5 - 2*pi*mms:c119*mms:c158/5 - 2*mms:c121*mms:c140 - 2*pi*mms:c121*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5)/5 - mms:c121*mms:c91*cos(t/5)*cos(t/5 + pi*x/2 - z)/50 - mms:c130*(-mms:c128 + mms:c58*cos(t/5)*cos(t/5 + pi*x/2 - z))/625 - 2*pi*mms:c135*(pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*sin(t/5 + pi*x/2 - z)*cos(t/5)/5 - mms:c144*(-mms:c130/625 - pi^2*mms:c39/50) + 2*pi^2*mms:c150*(1/50 - cos(2*pi*x)/50)*cos(t/5 + pi*x/2 - z)/25 - pi^2*mms:c39*(-mms:c128 + mms:c58*cos(t/5)*cos(t/5 + pi*x/2 - z))/50 - pi^2*sin(t/5)*sin(pi*x)*sin(2*t/5 - 2*z)/5000 - pi^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5)/2500 - 33*pi^2*cos(t/5)*cos(2*pi*x)*cos(t/5 - z)/20000 - pi*cos(t/5)*cos(2*pi*x)*cos(t/5 - z)/2500
c164 = pi*(pi*cos(pi*x)/1000 - pi*cos(3*pi*x)/2600)*sin(t/5)*sin(t/5 + pi*x/2 - z)
c168 = pi^3*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5)*sin(t/5 + pi*x/2 - z)
c171 = mms:c168/125 + mms:c91*sin(t/5)*cos(t/5 + pi*x/2 - z)/100
c172 = -mms:c164 + pi^2*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5)*cos(t/5 + pi*x/2 - z)/25
c173 = -pi*mms:c147*sin(t/5)*sin(t/5 + pi*x/2 - z) - mms:c58*sin(t/5)*cos(t/5 + pi*x/2 - z)/4 - pi^2*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5)*cos(t/5 + pi*x/2 - z)/100
c174 = -mms:c168/500 - pi*mms:c58*sin(t/5)*sin(t/5 + pi*x/2 - z)/20 + 3*pi^2*(pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*sin(t/5)*cos(t/5 + pi*x/2 - z)/80
c176 = -mms:c156*sin(t/5)*cos(t/5 + pi*x/2 - z) + pi*mms:c58*sin(t/5)*sin(t/5 + pi*x/2 - z)/10 + mms:c91*sin(t/5)*cos(t/5 + pi*x/2 - z)/400
c177 = -mms:c109*cos(t/5) - 2*pi*mms:c119*mms:c174/5 - 2*pi*mms:c119*mms:c176/5 - 2*mms:c121*mms:c171 + 2*pi*mms:c121*mms:c58*sin(t/5)*sin(t/5 + pi*x/2 - z)/5 + pi^2*mms:c121*(pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*sin(t/5)*cos(t/5 + pi*x/2 - z)/50 - mms:c130*(mms:c164 - mms:c58*sin(t/5)*cos(t/5 + pi*x/2 - z))/625 + 2*pi*mms:c135*(pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*sin(t/5)*sin(t/5 + pi*x/2 - z)/5 - mms:c172*(-mms:c130/625 - pi^2*mms:c39/50) + 2*pi^2*mms:c173*(1/50 - cos(2*pi*x)/50)*cos(t/5 + pi*x/2 - z)/25 - pi^2*mms:c39*(mms:c164 - mms:c58*sin(t/5)*cos(t/5 + pi*x/2 - z))/50 - pi^2*sin(t/5)*sin(2*pi*x)*sin(t/5 - z)/2500 - 33*pi^2*sin(t/5)*cos(2*pi*x)*cos(t/5 - z)/20000 - pi*sin(t/5)*cos(2*pi*x)*cos(t/5 - z)/2500 - pi^2*sin(pi*x)*sin(2*t/5 - 2*z)*cos(t/5)/5000
c179 = mms:c27*(mms:c12 + 1)/1836 - mms:c95/7344 + (7/100 - 3*mms:c20/200)*(1/2 - mms:c20/40)/1836 - 5*(mms:c159*sin(y) - mms:c177*cos(y))/(1836*pi)
c183 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/500 - pi*sin(2*pi*x)*cos(t/5 - y)/100
c184 = -pi*mms:c119/5 + pi*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)/5
c195 = pi*sin(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c197 = pi*sin(t/5 - z)*cos(2*pi*x)*cos(t/5 - y)
c199 = 2*pi*cos(2*pi*x)/195 - pi*cos(4*pi*x)/156
c201 = (pi*cos(pi*x)/50 - pi*cos(3*pi*x)/130)*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)
c207 = exp(2*pi*(10*x - 5)/5) + exp(-2*pi*(10*x - 5)/5)
c210 = sin(2*t/5 + pi*x - 2*z)/(exp(-2*pi) + exp(2*pi))
c212 = exp(2*pi*(10*x - 5)/5) - exp(-2*pi*(10*x - 5)/5)
c214 = cos(2*t/5 + pi*x - 2*z)/(exp(-2*pi) + exp(2*pi))
c218 = (pi*cos(pi*x)/1000 - pi*cos(3*pi*x)/2600)*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)
c220 = -mms:c58*cos(t/5 + y)*cos(t/5 + pi*x/2 - z)
c227 = 2*pi*exp(2*pi*(10*x - 5)/5)/5 + 2*pi*exp(-2*pi*(10*x - 5)/5)/5
c228 = 2*pi*exp(2*pi*(10*x - 5)/5)/5 - 2*pi*exp(-2*pi*(10*x - 5)/5)/5
c229 = -pi*mms:c207*mms:c210/40 - mms:c210*mms:c227 - pi*mms:c212*mms:c214/10 + mms:c228*cos(2*t/5 + pi*x - 2*z)/(4*(exp(-2*pi) + exp(2*pi)))
c231 = 2*pi*mms:c119*(-pi*mms:c218 - mms:c220)/5 + 2*pi*mms:c121*mms:c201/5 + mms:c195/250 - mms:c197/1000 + pi^2*mms:c199*sin(2*t/5 + pi*x - 2*z)/1250 - 2*pi*mms:c201*(-mms:c64 + pi*mms:c67/20)/5 + pi^2*mms:c229/138125 - 2*pi*mms:c67*(-pi*mms:c218 - mms:c220)/5 + pi^2*(pi*mms:c207*mms:c210/10 + 2*pi*mms:c212*mms:c214/5)/552500 + pi*sin(pi*x)*sin(t/5 + y)*cos(2*t/5 - 2*z)/1000 - pi*sin(t/5 + y)*sin(2*t/5 - 2*z)*cos(pi*x)/1000
c236 = pi^3*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)
c248 = pi*mms:c147*sin(t/5 + pi*x/2 - z)*cos(t/5 + y) + pi^2*mms:c54/100 + mms:c58*cos(t/5 + y)*cos(t/5 + pi*x/2 - z)/4
c250 = mms:c236/500 + pi*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)/20 - 3*pi^2*mms:c64/80
c260 = (2*sin(2*pi*x)/39 - 5*sin(4*pi*x)/312)*sin(2*t/5 + pi*x - 2*z)
c261 = -2*pi^4*mms:c260/15625 + pi^2*(-pi^2*mms:c207*mms:c214/25 + 4*pi^2*mms:c210*mms:c212/25)/130000
c264 = pi^2*mms:c207*mms:c214/100 - pi^2*mms:c210*mms:c212/25 + pi*mms:c210*mms:c228/10 + 2*pi*mms:c214*mms:c227/5
c267 = pi^2*mms:c264/552500 + pi^2*sin(pi*x)*sin(t/5 + y)*sin(2*t/5 - 2*z)/10000 + pi^2*sin(2*pi*x)*sin(t/5 - z)*cos(t/5 - y)/5000
c268 = 2*pi*mms:c119*mms:c250/5 + 2*mms:c121*(-mms:c236/125 - pi^2*mms:c64/100) - pi^3*mms:c199*cos(2*t/5 + pi*x - 2*z)/12500 - 2*pi^2*mms:c248*mms:c39/25 + 2*pi^2*mms:c248*mms:c54/25 - 2*pi*mms:c250*mms:c67/5 + mms:c261 + mms:c267 + (-mms:c130/625 - pi^2*mms:c39/50)*(pi*mms:c218 - pi^2*mms:c54/25) - (-mms:c236/125 - pi^2*mms:c64/100)*(-2*mms:c64 + pi*mms:c67/10) + 2*(pi*mms:c201/5 + pi^2*mms:c54/100)*(pi*mms:c218 - pi^2*mms:c54/25) + 17*pi^2*sin(t/5 + y)*cos(pi*x)*cos(2*t/5 - 2*z)/10000 + 17*pi^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/20000
c270 = pi*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)/10
c271 = mms:c156*cos(t/5 + y)*cos(t/5 + pi*x/2 - z) - mms:c270 - pi^2*mms:c64/400
c273 = 2*pi*mms:c58*sin(t/5 + pi*x/2 - z)*cos(t/5 + y)/5
c276 = pi^2*(-2*pi^2*sin(2*pi*x)/975 + pi^2*sin(4*pi*x)/390)*sin(2*t/5 + pi*x - 2*z)/1250 + pi^2*(-pi^2*mms:c207*mms:c214/400 - pi*mms:c210*mms:c228/20 - mms:c210*(4*pi^2*exp(2*pi*(10*x - 5)/5)/25 - 4*pi^2*exp(-2*pi*(10*x - 5)/5)/25) + pi^2*mms:c212*sin(2*t/5 + pi*x - 2*z)/(100*(exp(-2*pi) + exp(2*pi))) - pi*mms:c214*mms:c227/5 + (4*pi^2*exp(2*pi*(10*x - 5)/5)/25 + 4*pi^2*exp(-2*pi*(10*x - 5)/5)/25)*cos(2*t/5 + pi*x - 2*z)/(4*(exp(-2*pi) + exp(2*pi))))/138125
c277 = 2*pi*mms:c119*mms:c271/5 + mms:c121*mms:c273 + pi^2*mms:c121*mms:c64/50 + mms:c130*(-pi*mms:c218 - mms:c220)/625 + 2*pi*mms:c135*mms:c201/5 + pi^3*mms:c199*cos(2*t/5 + pi*x - 2*z)/12500 - 2*pi*mms:c201*(-pi*mms:c218 - mms:c220)/5 - 2*pi*mms:c201*(pi*mms:c201/10 + mms:c220 + pi^2*mms:c54/400)/5 + mms:c267 - 2*pi*mms:c271*mms:c67/5 - mms:c273*(-mms:c64 + pi*mms:c67/20) + mms:c276 + pi^2*mms:c39*(-pi*mms:c218 - mms:c220)/50 - pi^2*mms:c54*(-pi*mms:c218 - mms:c220)/50 - pi^2*mms:c64*(-mms:c64 + pi*mms:c67/20)/50 + pi^2*sin(t/5 + y)*cos(pi*x)*cos(2*t/5 - 2*z)/10000 + pi^2*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/1250
c279 = 2*pi*mms:c119*mms:c248/5 + 2*mms:c121*(pi*mms:c218 - pi^2*mms:c54/25) + mms:c195/1000 - 17*mms:c197/4000 + pi^2*mms:c199*sin(2*t/5 + pi*x - 2*z)/5000 + pi^2*mms:c229/552500 - 2*pi*mms:c248*mms:c67/5 - (-2*mms:c64 + pi*mms:c67/10)*(pi*mms:c218 - pi^2*mms:c54/25) + pi^2*(pi*mms:c207*mms:c210/10 + 2*pi*mms:c212*mms:c214/5)/130000 - pi^3*(2*sin(2*pi*x)/39 - 5*sin(4*pi*x)/312)*cos(2*t/5 + pi*x - 2*z)/3125 + pi*sin(pi*x)*sin(t/5 + y)*cos(2*t/5 - 2*z)/4000 - 17*pi*sin(t/5 + y)*sin(2*t/5 - 2*z)*cos(pi*x)/4000
c284 = pi*sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c286 = (-3*mms:c284/400 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/250)/(-3*mms:c20/80 + mms:c28 + 11/4)^2
c288 = 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/250 - pi*sin(2*pi*x)*cos(t/5 - y)/50
c290 = pi*sin(pi*x)^2*sin(2*pi*x)*cos(t/5 + y)
c291 = pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)
c293 = (-mms:c288 - 3*mms:c290*sin(t/5 - z)/400 + 3*mms:c291/400)/(-3*mms:c20/80 + mms:c28 + 11/4)^2
c299 = cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)/250
c302 = pi*mms:c27*sin(t/5 - y)*cos(2*pi*x)/100 + pi*mms:c299*(mms:c12 + 1)*sin(pi*x)^2
c305 = -3*mms:c20/40 + 3*sin(pi*x)^2*cos(t/5 + z)/25 + cos(2*pi*x)*cos(t/5 - y)/5 + 11/2
c314 = mms:c279*(-3*mms:c284/200 + 3*pi*sin(pi*x)^2*sin(t/5 + z)/125)
c315 = mms:c231*(-3*mms:c290*sin(t/5 - z)/200 + 3*pi*sin(pi*x)*sin(t/5 - z)*cos(pi*x)*cos(2*pi*x)*cos(t/5 + y)/200 - 3*pi*sin(pi*x)*cos(pi*x)*cos(t/5 + z)/125 + pi*sin(2*pi*x)*cos(t/5 - y)/25)
c316 = pi*sin(pi*x)^2*sin(t/5 - z)*cos(2*pi*x)
c323 = sin(pi*x)^2*sin(t/5 + y)*sin(t/5 - z)*cos(2*pi*x)
c324 = sin(pi*x)^2*cos(2*pi*x)*cos(t/5 + y)*cos(t/5 - z)
c326 = 3*sin(pi*x)^2*sin(t/5 + z)/250 + sin(t/5 - y)*cos(2*pi*x)/50
c329 = pi*sin(pi*x)*sin(t/5 - y)*cos(pi*x)*cos(2*pi*x)*cos(t/5 - z)
c330 = -mms:c329/250 + pi*sin(pi*x)^2*sin(2*pi*x)*sin(t/5 - y)*cos(t/5 - z)/250
c333 = sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/250
c341 = pi*(sin(pi*x)/5 - sin(3*pi*x)/39)*sin(t/5 + y)*cos(t/5 + pi*x/2 - z)/5
c342 = pi*cos(2*pi*x)*cos(t/5 - y)*cos(t/5 - z)
c345 = sin(pi*x)^2*sin(t/5 - y)*sin(t/5 - z)*cos(2*pi*x)/125
c348 = (2*mms:c39 + 2*cos(t/5 - y)/25 + 12/5)/(-3*mms:c20/160 + mms:c28 + 19/8)^2
c349 = mms:c348*(-3*mms:c316*sin(t/5 + y)/800 - pi*sin(t/5 - y)*cos(2*pi*x)/50)
c353 = 2*pi*sin(t/5 - y)/(125*(-3*mms:c20/160 + mms:c28 + 19/8))
c354 = mms:c349*(mms:c12 + 1) + mms:c353*(mms:c12 + 1) + pi*mms:c44*sin(t/5 - y)*cos(2*pi*x)/100
c357 = (3/4 - 3*mms:c20/80)*(3*mms:c290*sin(t/5 - z)/1000 - 3*mms:c291/1000)
