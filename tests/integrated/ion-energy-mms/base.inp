# Continuum 3D slab; mms.py adds analytic fields and forcing.
periodicX = false
MXG = 2
MYG = 2
ZMIN = 0
ZMAX = 10/(2*pi)
TwistShift = false

[input]
# Recovered-field analytic references are intentionally read by Python only.
error_on_unused_options = false

[mesh]
nx = 12
ny = 16
nz = 8
symmetricGlobalX = true
symmetricGlobalY = true
ixseps1 = nx
ixseps2 = nx
jyseps1_1 = -1
jyseps2_1 = ny/2-1
jyseps1_2 = ny/2-1
jyseps2_2 = ny-1
ny_inner = ny/2
dx = 10/(nx-4)
dy = 10/ny
dz = 10/nz
J = 1
Bxy = 1
g11 = 1
g22 = 1
g33 = 17/16
g12 = 0
g13 = 1/4
g23 = 0
g_11 = 17/16
g_22 = 1
g_33 = 1
g_12 = 0
g_13 = -1/4
g_23 = 0
bxcvx = 0
bxcvy = 0
bxcvz = (1/10)*1.602176634e-19/(2*1.672621898e-27)

[mesh:ddz]
first = FFT
fft_filter = 0

[mesh:paralleltransform]
type = identity

[solver]
type = cvode
mms = true
mms_initialise = true
nout = 4
output_step = 0.005
atol = 1e-12
rtol = 1e-10
max_timestep = 0.002
mxstep = 10000

[hermes]
components = i, j, e, evolve_vorticity_ion_energy, polarisation_drift, sound_speed
recalculate_metric = false
normalise_metric = false
Nnorm = 1e18
Tnorm = 1
Bnorm = 1

[i]
type = evolve_density, evolve_momentum
AA = 2
charge = 1
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = true

[j]
type = evolve_density, evolve_momentum
AA = 3
charge = 2
bndry_flux = false
poloidal_flows = false
use_div_par_fvv = true
density_floor = 1e-10
diagnose = true

[e]
use_div_par_fvv = true
type = quasineutral, evolve_pressure, evolve_momentum
AA = 1/1836
charge = -1
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
p_div_v = true
density_floor = 1e-10
diagnose = true

[Vi]
bndry_xin = neumann
bndry_xout = neumann

[Vj]
bndry_xin = neumann
bndry_xout = neumann

[Ve]
bndry_xin = dirichlet_o2(mms:electron_velocity)
bndry_xout = dirichlet_o2(mms:electron_velocity)

[evolve_vorticity_ion_energy]
viscosity = 0.02
phi_dissipation = true
average_atomic_mass = 2
poloidal_flows = false
radial_boundary = fixed
density_floor = 1e-10
# phi_atol is a denominator scale: effective absolute update tolerance is
# phi_atol*phi_rtol. Avoid requesting sub-roundoff updates where phi crosses 0.
phi_atol = 1
phi_rtol = 1e-13
vort_atol = 1e-12
phi_max_iterations = 400
diagnose = true

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[sound_speed]
electron_dynamics = true
alfven_wave = false

[polarisation_drift]
diagnose = true
implementation = conservative
polarisation_corrections = 32
