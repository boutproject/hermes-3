# Orthogonal curvature slab. runtest installs matched FV time-zero restarts.
NXPE = 1
MYG = 0
MXG = 2
periodicX = false
ZMAX = mesh:Lpol / (2*pi*mesh:Rxy)
restart = true
append = false
dump_on_restart = true

[mesh]
nx = 20
ny = 1
nz = 16
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
Bxy = Bpxy
bxcvx = 0
bxcvy = 0
bxcvz = 1/Rxy^2
# Explicit SI metric pairs avoid assumptions about B normalisation during
# metric recalculation; both formulations normalise these identically.
g11 = (Rxy*Bpxy)^2
g22 = 1/hthe^2
g33 = Bxy^2/g11
g12 = 0
g13 = 0
g23 = 0
g_11 = 1/g11
g_22 = (Bxy*hthe/Bpxy)^2
g_33 = Rxy^2
g_12 = 0
g_13 = 0
g_23 = 0
J = hthe/Bpxy

[mesh:paralleltransform]
type = identity

[mesh:ddz]
first = FFT
fft_filter = 0

[solver]
type = cvode
nout = 10
output_step = 1
atol = 1e-11
rtol = 1e-09
max_timestep = 1
mxstep = 1e6

[hermes]
components = e, h+, evolve_vorticity_ion_energy
recalculate_metric = false
normalise_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
density_floor = 1e-7
low_p_diffuse_perp = false
low_T_diffuse_perp = false
damp_p_nt = false
p_div_v = false
numerical_viscous_heating = false
hyper_z = -1
evolve_log = false
diagnose = true

[h+]
type = evolve_density
charge = 1
AA = 1
bndry_flux = false
poloidal_flows = false
density_floor = 1e-7
low_n_diffuse = false
low_n_diffuse_perp = false
hyper_z = -1
evolve_log = false
diagnose = true


[Nh+]
function = 1
source = 0
bndry_all = neumann

[Pe]
function = 1 + 0.1*cos(z)
source = 0
bndry_all = neumann

[Vort]
function = 0
bndry_all = neumann

[Eion]
function = 1.5*Pe:function
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1
poloidal_flows = false
viscosity = 0
radial_boundary = fixed
diagnose = true
phi_rtol = 1e-10
phi_atol = 1e-3
vort_atol = 1e-12
phi_max_iterations = 200

[evolve_vorticity_ion_energy:laplacian]
type = cyclic
