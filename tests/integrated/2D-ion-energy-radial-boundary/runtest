#!/usr/bin/env python3
"""Audit Plan C wall budgets, restart storage and rigid-rotation decay."""

import argparse
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
import xarray as xr
from boutdata.data import BoutOptionsFile
from scipy.integrate import cumulative_simpson
from scipy.optimize import curve_fit
from scipy.sparse import diags
from scipy.sparse.linalg import spsolve

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT / "tools"))
from energy_analysis import energy_densities, open_run
from energy_analysis.fluxes import fill_wall_guards, reconstruct_fluxes
from energy_analysis.operators import perpendicular_operator

spec = importlib.util.spec_from_file_location(
    "scan", HERE.parent / "2D-energy/publication_scan.py"
)
scan = importlib.util.module_from_spec(spec)
spec.loader.exec_module(scan)


def initial_state(run, rigid=False):
    ds = run.data
    nx = ds.sizes["x"] - 4
    u = xr.DataArray((np.arange(nx + 4) - 1.5) / nx, dims="x", coords={"x": ds.x})
    phase = xr.DataArray(
        2 * np.pi * np.arange(ds.sizes["z"]) / ds.sizes["z"],
        dims="z",
        coords={"z": ds.z},
    )
    pressure = xr.ones_like(ds.phi) * (
        1e-6 if rigid else 2 + 0.02 * np.sin(np.pi * u) * np.cos(phase)
    )
    pressure = fill_wall_guards(pressure, run, "pressure")
    c = run.scalar_option("average_atomic_mass") / ds.Bxy**2
    if rigid:
        ax = float((c * ds.g11 / ds.dx**2).values.flat[0])
        diagonal = np.full(nx, -2.0)
        diagonal[[0, -1]] = -3.0
        rhs = 1e-4 * (np.arange(nx) + 0.5 - nx / 2) / nx * ax / nx**2
        solution = spsolve(
            diags(
                [np.ones(nx - 1), diagonal, np.ones(nx - 1)], [-1, 0, 1], format="csc"
            ),
            rhs / ax,
        )
        phi = xr.zeros_like(pressure)
        phi[{"x": slice(2, -2)}] = solution[:, None, None]
    else:
        phi = (
            xr.ones_like(pressure)
            * 1e-4
            * (u * (1 - u) + np.sin(np.pi * u) * np.cos(phase))
        )
    phi = fill_wall_guards(phi, run, "zero")
    operator = perpendicular_operator(c, phi + pressure, ds)
    return {
        "Pe": pressure,
        "Nh+": xr.ones_like(pressure),
        "phi": phi,
        "Vort": operator.divergence,
        "Eion": 1.5 * pressure + operator.kperp,
    }


def audit_rigid_rotation(run, tau, nx):
    mid = [
        (run.data.phi.isel(x=x) + run.data.phi.isel(x=g)).mean(("y", "z")) / 2
        for x, g in ((2, 1), (-3, -2))
    ]
    difference = np.asarray(mid[1] - mid[0])
    fitted, _ = curve_fit(
        lambda t, amplitude, decay: amplitude * (1 - np.exp(-t / decay)),
        np.asarray(run.data.t),
        difference,
        p0=(difference[-1], tau),
    )
    error = abs(fitted[1] / tau - 1)
    assert error < 0.01, (nx, error)
    interior = run.interior(run.data.phi).values
    derivative = (interior[2:] - interior[:-2]) / (
        np.asarray(run.data.t)[2:] - np.asarray(run.data.t)[:-2]
    )[:, None, None, None]
    chi = run.interior(run.data.ion_chi).values[1:-1]
    chi_error = float(np.max(abs(chi - derivative)) / np.max(abs(chi)))
    assert chi_error < 0.005, (nx, chi_error)
    return {
        "nx": nx,
        "chi_relative_error": chi_error,
        "tau": tau,
        "fitted_tau": float(fitted[1]),
        "tau_relative_error": float(error),
        "asymptotic_wall_difference": float(fitted[0]),
    }


def run_case(exe, folder, mode, ac, timeout, nx=16, rigid=False):
    folder.mkdir()
    opts = BoutOptionsFile(str(HERE / "data/BOUT.inp"))
    opts["mesh:nx"] = nx + 4
    opts["mesh:nz"] = 4 if rigid else 16
    opts["mesh:bxcvz"] = 0
    opts["evolve_vorticity_ion_energy:radial_boundary"] = mode
    opts["evolve_vorticity_ion_energy:polarisation_ac_boundary"] = ac
    opts["evolve_vorticity_ion_energy:viscosity"] = (
        100 if mode == "free_slip" and not rigid else 0
    )
    if mode == "no_slip":
        opts["evolve_vorticity_ion_energy:phi_boundary_velocity"] = 1000
    outputs = 40 if rigid else 80
    end = 2.0
    if rigid:
        opts.write(str(folder / "BOUT.inp"), overwrite=True)
        # Native normalisations determine the physical width and analytic tau.
        startup = folder / "normalisation"
        startup.mkdir()
        shutil.copyfile(folder / "BOUT.inp", startup / "BOUT.inp")
        scan.execute(
            exe, startup, {"nproc": 1, "outputs": 0, "end_time": 0}, timeout, seed=True
        )
        run = open_run(startup)
        length = (
            float((nx * run.data.dx / np.sqrt(run.data.g11)).values.flat[0])
            * run.length_scale
        )
        tau = length / 2000 * run.frequency
        end = 4 * tau
        run.data.close()
    opts["solver:nout"] = outputs
    opts["solver:output_step"] = end / outputs
    opts["solver:max_timestep"] = end / (2 * outputs)
    opts["solver:atol"] = 1e-13
    opts["solver:rtol"] = 1e-10
    opts.write(str(folder / "BOUT.inp"), overwrite=True)
    config = {"nproc": 1, "outputs": outputs, "end_time": end}
    scan.initial_state = lambda run: initial_state(run, rigid)
    scan.build_startup(exe, folder, config, timeout)
    scan.execute(exe, folder, config, timeout)
    run = open_run(folder)
    run.data = run.data.load()
    if rigid:
        return audit_rigid_rotation(run, tau, nx)
    ds = run.data
    flux = reconstruct_fluxes(run).compute()
    losses = run.integrate(ds["particle_pol_wall_loss_h+"])
    particles = run.integrate(ds["Nh+"])
    time = np.asarray(ds.t)
    cumulative = lambda rate: cumulative_simpson(np.asarray(rate), x=time, initial=0)
    particle_error = float(
        np.max(abs(np.asarray(particles - particles.isel(t=0)) + cumulative(losses)))
    )
    assert particle_error / float(particles.isel(t=0)) < 1e-7
    if ac == "neumann":
        assert float(abs(losses).max()) == 0
    energy = run.integrate(ds.Eion + 1.5 * ds.Pe)
    densities = energy_densities(run)
    energy_error = float(abs(run.interior(densities.ion_reconstructed - ds.Eion)).max())
    assert energy_error < 1e-9
    # Electron curvature is zero, so its integral is held; ion energy leaves via
    # the explicitly open chi and viscous wall faces.
    outward = run.integrate(ds.DivEpol + ds.DivEviscous)
    energy_balance = float(
        np.max(abs(np.asarray(energy - energy.isel(t=0)) + cumulative(outward)))
    )
    assert energy_balance / float(energy.isel(t=0)) < 1e-7
    vort = run.integrate(ds.Vort)
    viscous = run.integrate(ds.DivJviscous)
    vort_error = float(
        np.max(abs(np.asarray(vort - vort.isel(t=0)) - cumulative(viscous)))
    )
    # CVODE controls local vorticity errors; compare the integrated residual
    # per domain volume with its absolute state tolerance.
    volume = float(run.integrate(xr.ones_like(ds.Vort)).isel(t=0))
    assert vort_error / volume < 1e-13
    for name in ("DivEExB", "DivEReynolds", "DivJReynolds"):
        assert float(abs(run.integrate(ds[name])).max()) < 1e-10, name
    for x, guard in ((2, 1), (-3, -2)):
        midpoint = (ds.phi.isel(x=x) + ds.phi.isel(x=guard)) / 2
        if mode != "no_slip":
            assert float(abs(midpoint - midpoint.isel(t=0)).max()) < 1e-14
        vorticity = (
            ds.Vort.isel(x=x) + ds.Vort.isel(x=guard)
            if mode == "free_slip"
            else ds.Vort.isel(x=x) - ds.Vort.isel(x=guard)
        )
        assert float(abs(vorticity).max()) == 0
    # Compare the independently reconstructed wall flux with its diagnostic.
    wall_rate = -run.integrate(flux["particle_pol_h+"])
    assert float(abs(wall_rate + losses).max()) < 1e-10
    resumed = folder / "roundtrip"
    resumed.mkdir()
    shutil.copyfile(folder / "BOUT.inp", resumed / "BOUT.inp")
    for file in folder.glob("BOUT.restart.*.nc"):
        shutil.copyfile(file, resumed / file.name)
    with (resumed / "run.log").open("w") as log:
        subprocess.run(
            [str(exe), "-d", str(resumed), "solver:nout=1"],
            stdout=log,
            stderr=subprocess.STDOUT,
            env={**os.environ, "FI_SOCKETS_IFACE": "en0"},
            timeout=timeout,
            check=True,
        )
    restart = open_run(resumed)
    for name in ("phi", "Vort", "Eion", "Nh+", "Pe"):
        np.testing.assert_allclose(
            restart.data[name].isel(t=0), ds[name].isel(t=-1), rtol=1e-10, atol=1e-11
        )
    restart.data.close()
    return {
        "mode": mode,
        "ac": ac,
        "particle_error": particle_error,
        "energy_error": energy_balance,
        "vorticity_error": vort_error,
        "restart": "passed",
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--exe", type=Path, default=ROOT / "build/hermes-3")
    parser.add_argument("--output-root", type=Path)
    parser.add_argument("--timeout", type=float, default=120)
    args = parser.parse_args()
    if args.output_root is not None:
        args.output_root.mkdir(parents=True, exist_ok=True)
    output = Path(tempfile.mkdtemp(prefix="radial-boundary-", dir=args.output_root))
    print(f"Results: {output}", flush=True)
    results = []
    for mode in ("fixed", "free_slip", "no_slip"):
        for ac in ("neumann", "dirichlet"):
            result = run_case(
                args.exe.resolve(), output / f"{mode}-{ac}", mode, ac, args.timeout
            )
            results.append(result)
            print(f"PASS {mode}/{ac}", flush=True)
    rigid = [
        run_case(
            args.exe.resolve(),
            output / f"rigid-{nx}",
            "no_slip",
            "neumann",
            args.timeout,
            nx,
            True,
        )
        for nx in (16, 32, 64)
    ]
    ratios = [r["fitted_tau"] / r["tau"] for r in rigid]
    assert np.ptp(ratios) < 0.005
    amplitude_errors = [abs(r["asymptotic_wall_difference"] + 1e-4 / 12) for r in rigid]
    amplitude_orders = np.log2(
        np.asarray(amplitude_errors[:-1]) / np.asarray(amplitude_errors[1:])
    )
    assert np.all(amplitude_orders > 1.8)
    (output / "result.json").write_text(
        json.dumps(
            {
                "passed": True,
                "wall_budgets": results,
                "rigid_rotation": rigid,
                "asymptotic_amplitude_orders": amplitude_orders.tolist(),
            },
            indent=2,
        )
        + "\n"
    )
    print(
        "PASS all wall budgets, restarts and three rigid-rotation resolutions",
        flush=True,
    )


if __name__ == "__main__":
    main()
