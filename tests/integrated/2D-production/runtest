    if len(failures) > 0:
        t_final = time()
        print(f"2D-production test: Failed in {t_final - t0:.2f} seconds")
        print("2D-production test failures:")
        for f in failures:
            print(f"\n{f['region']} [{f['variable']}]:")
            print(f["error_msg"])

        sys.exit(1)

    else:
        if verbose:
            t_final = time()
            print(f"2D-production test: Passed in {t_final - t0:.2f} seconds")
        sys.exit(0)
