#!/usr/bin/env python3
import os
import sys
from pathlib import Path
from time import time

import numpy as np
import xhermes
from boututils.run_wrapper import launch_safe, shell
from expected_data import expected

t0 = time()

gen_data = False
verbose = True
rtol = 1e-9
atol = 1e-11

## Setup
this_dir = Path(__file__).parent
data_dir = this_dir / "data"
hermes_exec = this_dir.parent.parent.parent / "hermes-3"
output_path = data_dir / "BOUT.dmp.*.nc"

sys.path.append(str(this_dir.parent))
from runtest_utils import DataDownloader2DProduction

dd = DataDownloader2DProduction("2D-Production", this_dir)

if not dd.checkHash(False):
    dd.download_data()
    t_download = time()
    if verbose:
        print(f"2D-Production test: download took {t_download - t0:.2f} seconds")
    dd.checkHash()
else:
    t_download = time()

dd.extractZip()

t_extract = time()
if verbose:
    print(
        f"2D-Production test: zip extraction took {t_extract - t_download:.2f} seconds"
    )

## Run test
if not Path("hermes-3").is_file():
    shell("ln -s ../../../hermes-3 hermes-3")

# Allow oversubscription for OpenMPI via env var (silently ignored by MPICH,
# which does not enforce slot limits and does not support --oversubscribe)
os.environ["OMPI_MCA_rmaps_base_oversubscribe"] = "yes"
# OpenMPI 5
os.environ["PRTE_MCA_rmaps_default_mapping_policy"] = ":oversubscribe"

s, out = launch_safe("./hermes-3 -d data restart", nproc=10, pipe=True)

if s != 0:
    print(" => 2D-Production test failed: ")
    print(out)
    sys.exit(1)

t_run = time()
if verbose:
    print(f"2D-Production test: simulation took {t_run - t_extract:.2f} seconds")

# Load case
ds = xhermes.open_hermesdataset(
    datapath=output_path,
    gridfilepath=this_dir / "grid_test2_allpump.nc",
    keep_yboundaries=True,
    keep_xboundaries=True,
    geometry="toroidal",
).isel(t=-1)

t_load = time()
if verbose:
    print(f"2D-Production test: loading results took {t_load - t_run:.2f} seconds")


# Testing at specific locations around the domain
m = ds.metadata

regions = {}
regions["inner_lower_target"] = ds.hermes.select_region("domain", "inner_lower_target")
regions["inner_upper_target"] = ds.hermes.select_region("domain", "inner_upper_target")
regions["outer_upper_target"] = ds.hermes.select_region("domain", "outer_upper_target")
regions["outer_lower_target"] = ds.hermes.select_region("domain", "outer_lower_target")
regions["outer_midplane_a"] = ds.hermes.select_region("domain", "outer_upper_midplane")
regions["sol_boundary"] = ds.hermes.select_region("boundary_xup", "sol")
regions["sol_ring"] = ds.hermes.select_region(
    custom_selection=(m["ixseps1g"], xhermes.selector_poloidal(ds, "sol"))
)

# Generate test data or run test
if gen_data:
    # Generate test data, print to console and fail test
    with open("expected_data.py", "w") as f:
        f.write("""# The below line disables Ruff formatting for the data to keep it compact
# fmt: off

expected = {}
""")
        for region_name, ds in regions.items():
            f.write(f'\nexpected["{region_name}"] = {{}}\n')
            f.writelines(
                f'expected["{region_name}"]["{var}"] = {ds[var].values.tolist()}\n'
                for var in ("Pe", "NVd+", "Pd")
            )
    sys.exit(2)

else:
    # Perform test
    failures = []
    for region_name, ds in regions.items():
        for variable in ["Pe", "NVd+", "Pd"]:
            actual = ds[variable]
            reference = expected[region_name][variable]

            try:
                np.testing.assert_allclose(actual, reference, rtol=rtol, atol=atol)
            except AssertionError as e:
                failures.append(
                    {"region": region_name, "variable": variable, "error_msg": str(e)}
                )

    if len(failures) > 0:
        t_final = time()
        print(f"2D-production test: Failed in {t_final - t0:.2f} seconds")
        print("2D-production test failures:")
        for f in failures:
            print(f"\n{f['region']} [{f['variable']}]:")
            print(f["error_msg"])

        sys.exit(1)

    else:
        if verbose:
            t_final = time()
            print(f"2D-production test: Passed in {t_final - t0:.2f} seconds")
        sys.exit(0)
