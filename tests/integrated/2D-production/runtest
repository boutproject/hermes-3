#!/usr/bin/env python3
import os
import sys
from time import time
from runtest_utils import DataDownloader

import numpy as np
import xhermes
from boututils.run_wrapper import launch_safe, shell

t0 = time()

gen_data = False
verbose = True
rtol = 1e-5
atol = 1e-8

## Setup
this_dir = Path(__file__).parent
data_dir = this_dir / "data"
hermes_exec = this_dir.parent.parent.parent / "hermes-3"
output_path = data_dir / "BOUT.dmp.*.nc"

dd = DataDownloader()

t_download = time()
if not dd.checkHash(False):
    dd.download_data()
    if verbose:
        print(f"2D-Production test: download took {t_download - t0:.2f} seconds")
    dd.checkHash()

dd.extractZip()

t_extract = time()
if verbose:
    print(
        f"2D-Production test: zip extraction took {t_extract - t_download:.2f} seconds"
    )

## Run test
if not Path("hermes-3").is_file():
    shell("ln -s ../../../hermes-3 hermes-3")

# Allow oversubscription for OpenMPI via env var (silently ignored by MPICH,
# which does not enforce slot limits and does not support --oversubscribe)
os.environ["OMPI_MCA_rmaps_base_oversubscribe"] = "yes"

s, out = launch_safe("./hermes-3 -d data restart", nproc=10, pipe=True)

if s != 0:
    print(" => 2D-Production test failed: ")
    print(out)
    sys.exit(1)

t_run = time()
if verbose:
    print(f"2D-Production test: simulation took {t_run - t_extract:.2f} seconds")

# Load case
ds = xhermes.open_hermesdataset(
    datapath=output_path,
    gridfilepath=this_dir / "grid_test2_allpump.nc",
    keep_yboundaries=True,
    keep_xboundaries=True,
    geometry="toroidal",
).isel(t=-1)

t_load = time()
if verbose:
    print(f"2D-Production test: loading results took {t_load - t_run:.2f} seconds")


# Testing at specific locations around the domain
