nout = 1
timestep = 1


[mesh:paralleltransform]
type = fci

[mesh]

file = "../../../grids/slab_with_BC/MMS_straight_slab_8_256_4_True.fci.grid.nc"

[solver]
mxstep = 10000
type = cvode
rtol = 1e-5
atol = 1e-8

[hermes]
# Note: collisions are needed to be able to calculate parallel conduction
components = (h+, e, sheath_boundary_fci, braginskii_collisions, braginskii_conduction, sound_speed)

Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 50   # Reference temperature [eV]

################################################################
# Ions

[h+]
type = evolve_density, evolve_momentum, evolve_pressure

AA = 1
charge = 1
thermal_conduction = true

[Nh+]
function = 1.0
bndry_all = neumann

flux = 1e22
source = flux * gauss(y - pi, 0.25)

[NVh+]
function = 0.0
bndry_all = neumann

[Ph+]
function = 1.0
bndry_all = neumann

heating = 1e5
T_source = heating / (`Nh+`:flux * 1.602e-19 * 1.5)
source =  `Nh+`:source * T_source * 1.602176634e-19


[e]
type = quasineutral, zero_current, evolve_pressure

AA = 1.0 / 1836.0
charge = -1
thermal_conduction = true


[Pe]
function = 1.0
bndry_all = neumann

source = `Ph+`:source
