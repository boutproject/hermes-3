#!/usr/bin/env python3
"""Closed two-ion energy/particle conservation and diagnostic independence."""

import sys
from pathlib import Path

import numpy as np
import xhermes

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from ion_energy_test import launch, parser

HERE = Path(__file__).resolve().parent
cli = parser(__doc__)
cli.add_argument("--resolution", type=int, default=8)
args = cli.parse_args()
states = []
for diagnose in (True, False):
    path = launch(
        args,
        f"diagnostics-{diagnose}",
        HERE / "data/BOUT.inp",
        [
            f"mesh:nx={args.resolution + 4}",
            f"mesh:nz={args.resolution}",
            "solver:nout=20",
            "solver:output_step=1",
            f"evolve_vorticity_ion_energy:diagnose={str(diagnose).lower()}",
        ],
    )
    with xhermes.open(path, keep_xboundaries=False, keep_yboundaries=False) as ds:
        ds = ds.load(scheduler="synchronous")
        content = ds.hermes.inventory().compute()
        # zero_current has no electron kinetic equation in this Y-invariant slab.
        energy = content.ion_energy + content.electron_thermal
        for name, value in {
            "energy": energy,
            **{
                key: value
                for key, value in content.items()
                if key.startswith("particles_")
            },
        }.items():
            drift = float(abs(value / value.isel(t=0) - 1).max())
            print(f"{name}, diagnose={diagnose}: relative drift {drift:.3g}")
            assert np.isfinite(drift) and drift < 1e-10, name
        if diagnose:
            pressure = (ds["Nd+"] + ds.Nimpurity) * ds.Tion * 1.602176634e-19
            recovered = 1.5 * pressure + ds.ion_KE_perp + ds.ion_KE_parallel
            assert float(abs((recovered - ds.Eion) / ds.Eion).max()) < 1e-10
            for name, minimum in (("ion_KE_perp", 1e-4), ("ion_KE_parallel", 5e-5)):
                field = ds[name]
                scale = float(abs(ds.Eion.isel(t=0)).max())
                assert float(abs(field - field.isel(t=0)).max()) / scale > minimum
            assert (
                float(
                    abs(
                        content.electron_thermal / content.electron_thermal.isel(t=0)
                        - 1
                    ).max()
                )
                > 1e-4
            )
    with xhermes.open(
        path, unnormalise=False, keep_xboundaries=False, keep_yboundaries=False
    ) as ds:
        ds = ds.load(scheduler="synchronous")
        states.append(
            ds[
                ["Eion", "Pe", "Nd+", "Nimpurity", "NVd+", "NVimpurity", "Vort", "phi"]
            ].load()
        )
for name in states[0]:
    np.testing.assert_allclose(states[0][name], states[1][name], rtol=0, atol=1e-10)
print("Closed conservation, energy exchange and diagnostic independence passed")
