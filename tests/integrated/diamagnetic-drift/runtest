#!/usr/bin/env python3
"""Production diamagnetic conservation, core averaging and real MPI consistency."""

import sys
from pathlib import Path

import numpy as np
from boutdata.collect import collect

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from ion_energy_test import launch, parser

HERE = Path(__file__).resolve().parent
cli = parser(__doc__)
cli.set_defaults(exe=HERE.parents[2] / "diamagnetic_drift_smoke")
cli.add_argument(
    "--grid",
    type=Path,
    default=HERE.parents[2] / "examples/tokamak-2D/compass-36x48.grd.nc",
)
args = cli.parse_args()


def read(name, directory):
    return np.asarray(
        collect(name, path=str(directory), xguards=False, yguards=False, info=False)
    )


def run(nproc, nxpe, mz):
    directory = launch(
        args,
        f"np{nproc}-nxpe{nxpe}-mz{mz}",
        HERE / "data/BOUT.inp",
        [f"mesh:file={args.grid.resolve()}", f"NXPE={nxpe}", f"MZ={mz}"],
        nproc=nproc,
    )
    volume = read("volume", directory)
    if volume.ndim == 2:
        volume = volume[..., None]
    core = read("core_mask", directory).astype(bool)
    assert core.sum() > 1
    fields = {}
    for name, source in (("N", "Sn"), ("P", "Sp"), ("M", "Sm")):
        values, rates = read(name, directory), read(source, directory)
        assert np.isfinite(values).all() and np.isfinite(rates).all()
        total = (values * volume).sum(axis=(1, 2, 3))
        np.testing.assert_allclose(total, total[0], rtol=1e-12, atol=0)
        scale = (abs(rates) * volume).sum(axis=(1, 2, 3)).max()
        assert abs((rates * volume).sum(axis=(1, 2, 3))).max() < 1e-12 * scale
        assert abs(values[-1] - values[0]).max() > 1e-7
        assert np.ptp(values[:, core], axis=1).max() < 1e-10
        assert np.ptp(rates[:, core], axis=1).max() < 1e-10
        # Compare two production boundary policies through the ring integral.
        closed = read(source + "_closed", directory)
        weighted = np.broadcast_to(volume, core.shape)
        np.testing.assert_allclose(
            (rates[:, core] * weighted[core]).sum(axis=1),
            (closed[:, core] * weighted[core]).sum(axis=1),
            rtol=1e-10,
            atol=1e-12,
        )
        np.testing.assert_allclose(
            rates[:, ~core], closed[:, ~core], rtol=0, atol=1e-12
        )
        fields[name], fields[source] = values, rates
    assert abs(read("radial_guard_flux", directory)).max() < 1e-14
    assert read("open_radial_flux", directory).min() > 1e-10
    return fields


# The eight-cell divertor legs require at least six Y processors.
for mz in (1, 4):
    reference = run(6, 1, mz)
    for nproc, nxpe in ((12, 1), (12, 2)):
        other = run(nproc, nxpe, mz)
        for name, field in reference.items():
            error = abs(field - other[name]).max() / max(abs(field).max(), 1e-30)
            assert error < 1e-10, (name, mz, nproc, nxpe, error)
    print(f"Diamagnetic conservation and MPI consistency passed for MZ={mz}")
