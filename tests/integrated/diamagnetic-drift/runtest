#!/usr/bin/env python3
"""Check diamagnetic conservation, every physical boundary, and MPI consistency."""

import argparse
import os
import shlex
import shutil
import signal
import subprocess
from pathlib import Path

import numpy as np
from boutdata.collect import collect

HERE = Path(__file__).resolve().parent
CONSERVATION_TOLERANCE = 1e-12
MPI_TOLERANCE = 1e-10
REFERENCE_TOLERANCE = 1e-12


def read(name, directory):
    return np.asarray(collect(
        name, path=str(directory), xguards=False, yguards=False, info=False
    ))


def run_case(executable, grid, run_root, nproc, nxpe, timeout):
    directory = run_root / f"np{nproc}-nxpe{nxpe}"
    directory.mkdir(parents=True, exist_ok=True)
    # Replace only this test's known outputs; leave other run directories alone.
    for filename in directory.glob("BOUT.*"):
        if filename.is_file():
            filename.unlink()
    shutil.copyfile(HERE / "data/BOUT.inp", directory / "BOUT.inp")
    launcher = shlex.split(os.environ.get("MPIRUN", "mpiexec -np"))
    command = [
        *launcher, str(nproc), str(executable), "-d", str(directory),
        f"mesh:file={grid}", f"NXPE={nxpe}",
    ]
    print(f"Running {nproc} ranks: NXPE={nxpe}, NYPE={nproc // nxpe}", flush=True)
    with subprocess.Popen(
        command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, start_new_session=True,
    ) as process:
        try:
            output, _ = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            output, _ = process.communicate()
            (directory / "run.log").write_text(output)
            raise RuntimeError(f"MPI run timed out after {timeout}s: {directory}")
    (directory / "run.log").write_text(output)
    if process.returncode:
        raise RuntimeError(f"MPI run failed: {directory}/run.log")

    volume = read("volume", directory)
    if volume.ndim == 2:
        volume = volume[..., np.newaxis]
    assert np.isfinite(volume).all() and np.min(volume) > 0
    fields = {}
    for name, source in [("N", "Sn"), ("P", "Sp"), ("M", "Sm")]:
        values = read(name, directory)
        rates = read(source, directory)
        assert values.shape[-1] == 1, "Run must be axisymmetric"
        assert np.isfinite(values).all() and np.isfinite(rates).all()
        total = np.sum(values * volume, axis=(1, 2, 3))
        error = np.max(np.abs(total - total[0])) / abs(total[0])
        rate_error = np.max(np.abs(np.sum(rates * volume, axis=(1, 2, 3)))) / max(
            np.max(np.sum(np.abs(rates) * volume, axis=(1, 2, 3))), 1e-30
        )
        assert error < CONSERVATION_TOLERANCE, (name, "conservation", error)
        assert rate_error < CONSERVATION_TOLERANCE, (name, "source integral", rate_error)
        assert np.max(np.abs(values[-1] - values[0])) > 1e-7, (name, "inactive evolution")
        core = read("core_mask", directory).astype(bool)
        assert core.sum() > 1, "Grid must contain an MPI core ring"
        assert np.max(np.ptp(values[:, core], axis=1)) < MPI_TOLERANCE, (name, "core field")
        assert np.max(np.ptp(rates[:, core], axis=1)) < MPI_TOLERANCE, (name, "core source")
        fields[name] = values
        fields[source] = rates
        print(f"  {name}: relative content drift={error:.3e}, "
              f"rate integral={rate_error:.3e}")

    error = read("reference_error", directory)
    assert np.max(error) < REFERENCE_TOLERANCE, ("zero-face reference", np.max(error))
    for mask in ["core_mask", "lower_mask", "upper_mask"]:
        boundary = read(mask, directory).astype(bool)
        assert boundary.any(), (mask, "boundary not exercised")
        assert np.max(error[:, boundary]) < REFERENCE_TOLERANCE
    assert np.max(np.abs(read("radial_guard_flux", directory))) < 1e-14
    # Positive controls: each physical boundary would carry flux if left open.
    for name in [
        "open_core_flux", "open_pf_flux", "open_outer_flux",
        "unclosed_lower_flux", "unclosed_upper_flux",
    ]:
        flux = read(name, directory)
        assert np.isfinite(flux).all() and np.min(flux) > 1e-10, (name, flux)
    print(f"  Boundary reference error={np.max(error):.3e}; "
          "all closed-face checks passed")
    return fields


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--executable", type=Path, default=HERE.parents[2] / "diamagnetic_drift_smoke"
    )
    copied_grid = HERE / "data/compass-36x48.grd.nc"
    parser.add_argument(
        "--grid", type=Path, default=copied_grid if copied_grid.exists()
        else HERE.parents[2] / "examples/tokamak-2D/compass-36x48.grd.nc"
    )
    parser.add_argument("--run-root", type=Path, default=HERE / "runs")
    parser.add_argument("--timeout", type=float, default=60)
    args = parser.parse_args()
    results = []
    # The 8-cell divertor legs require NYPE >= 6; a serial run is invalid.
    for nproc, nxpe in [(6, 1), (12, 1), (12, 2)]:
        results.append(run_case(
            args.executable.resolve(), args.grid.resolve(), args.run_root.resolve(),
            nproc, nxpe, args.timeout,
        ))
    for parallel in results[1:]:
        for name, reference in results[0].items():
            error = np.max(np.abs(parallel[name] - reference)) / max(
                np.max(np.abs(reference)), 1e-30
            )
            assert error < MPI_TOLERANCE, (name, "MPI comparison", error)
            print(f"  MPI {name}: relative max difference={error:.3e}")
    print("=> Diamagnetic parallel test passed")


if __name__ == "__main__":
    main()
