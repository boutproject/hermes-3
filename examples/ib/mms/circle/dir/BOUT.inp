# Stellarator diffusion

nout = 20
timestep = 1.5e5

[mesh]

file = "../gridfiles/cl64.fci.nc"

[mesh:paralleltransform]
type = fci
z_periodic = 0

[solver]
rtol = 1e-12
atol = 1e-14

[hermes]
components = h+

Nnorm = 2e18  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 5   # Reference temperature [eV]

recalculate_metric = false # Assume a tokomak?

imm_bndry = true

[h+]
type = evolve_density, anomalous_diffusion

diagnose = 1
AA = 1
charge = 1
anomalous_D = 0.4    # Density diffusion [m^2/s]
#anomalous_chi = .4
#anomalous_nu = 0

[Nh+]

function = 1 + j(0,2.404825557693792*sqrt((x-0.5)*(x-0.5) + (zn-0.5)*(zn-0.5))/(1.0/3.0))
bndry_wall = dirichlet(1.0)
