

nout = 100
timestep = 5000.0

[mesh]

file = "hsx_260_10_768.fci.grid.nc"

[input]

error_on_unused_options = false

[mesh:paralleltransform]
type = fci

[solver]
mxstep = 10000
type = cvode
atol = 1e-9
rtol = 1e-5
cvode_max_order = 3
max_timestep = 75.0
maxl = 6
[hermes]

components = h+ , e, sound_speed, braginskii_collisions, braginskii_friction, braginskii_heat_exchange, sheath_boundary_fci, braginskii_ion_viscosity, braginskii_conduction

Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 2.5   # Reference magnetic field [T]
Tnorm = 100   # Reference temperature [eV]

[collisions]
electron_ion = true
neutral_neutral = false
ion_neutral = false
electron_neutral = false

[sheath_boundary_fci]

gamma_e = 6.5
gamma_i = 4.5

[sound_speed]
electron_dynamics = false

[h+]
type = evolve_density, evolve_momentum, evolve_pressure, anomalous_diffusion, selflimiting_source

AA = 1
charge = 1
anomalous_D = 1.0
anomalous_nu = 1.0
anomalous_chi = 1.0
diagnose = false

p_div_v = true

[h+:selflimiting_source]
density_setpoint = 1e19
density_overshoot = 1e18
flux = 2.5 * 5e21
density_form = flux * gauss(x, 0.08)


temperature_setpoint = 120
temperature_overshoot = 5.0
heating = 5.0e5
T_source = heating / (flux * 1.602e-19 * 1.5)
pressure_form = density_form * T_source * 1.602176634e-19

[Nh+]
Ninner = 1e19
Nouter = 1e18
function = (Ninner - (Ninner-Nouter)* x) / hermes:Nnorm
source = 0.0

bndry_all = neumann   # All other boundaries low density
bndry_par_all = parallel_neumann_o1
bndry_xout = neumann
bndry_xin = neumann

[Ph+]
Tinner = 120
Touter = 20
Tprofile = (Tinner - (Tinner - Touter) * x) / hermes:Tnorm

function = Tprofile * `Nh+`:function
source = 0.0

bndry_all = neumann   # All other boundaries low density
bndry_par_all = parallel_neumann_o1
bndry_xout = neumann
bndry_xin = neumann


[NVh+]
bndry_all = neumann
bndry_xin = dirichlet
bndry_xout = neumann
bndry_par_all = parallel_neumann_o1

[Vh+]
bndry_all = neumann
bndry_xin = dirichlet
bndry_xout = neumann
bndry_par_all = parallel_neumann_o1



[e]
type = quasineutral, zero_current, evolve_pressure, anomalous_diffusion, selflimiting_source

AA = 1 / 1836
charge = -1
anomalous_D = 1.0
anomalous_chi = 1.0

[e:selflimiting_source]

flux = 2.5 * 5e21
heating = 5.0e5
T_source = heating / (flux * 1.602e-19 * 1.5)

temperature_setpoint = 120
temperature_overshoot = 5.0
pressure_form = flux * gauss(x, 0.08) * T_source * 1.602176634e-19




[Pe]

function = `Ph+:function`  # Same as ion pressure initially


source = 0.0

bndry_all = neumann   # All other boundaries low density
bndry_par_all = parallel_neumann_o1
bndry_xout = neumann
bndry_xin = neumann
