
nout = 100
timestep = 10000

[mesh]

file = "dommaschk_68_8_512.fci.grid.nc"

[mesh:paralleltransform]
type = fci

[solver]
mxstep = 10000
type = cvode
rtol = 1e-5
atol = 1e-10

[hermes]
# Note: collisions are needed to be able to calculate parallel conduction
components = (h+, e, braginskii_collisions, braginskii_conduction)

Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 150   # Reference temperature [eV]

################################################################
# Ions

[h+]
type = fixed_density, evolve_pressure, anomalous_diffusion

AA = 1
charge = 1
anomalous_chi = 0.1
thermal_conduction = true
density = hermes:Nnorm

[Ph+]
function = 1.0 - 0.9 * x
bndry_xin = dirichlet(1.0)  # Core boundary high density
bndry_xout = dirichlet(0.1)   # All other boundaries low density


[e]
type = fixed_density, evolve_pressure, anomalous_diffusion

AA = 1.0 / 1836.0
charge = -1
anomalous_chi = 0.1
thermal_conduction = true
density = hermes:Nnorm

[Pe]
function = 1.0 - 0.9 * x
bndry_xin = dirichlet(1.0)  # Core boundary high density
bndry_xout = dirichlet(0.1)   # All other boundaries low density
