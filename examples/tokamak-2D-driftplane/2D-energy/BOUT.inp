# Interchange relaxation with ion total-energy evolution.
NXPE = 1
MYG = 0
MXG = 2
periodicX = false
ZMAX = mesh:Lpol / (2*pi*mesh:Rxy)
restart = false
append = false
dump_on_restart = false

[mesh]
nx = 36
ny = 1
nz = 32
Lrad = 0.05
Lpol = 0.05
Bpxy = 0.35
Rxy = 1.5
dx = Lrad * Rxy * Bpxy / (nx - 4)
dz = Lpol / Rxy / nz
hthe = 1
Bxy = Bpxy
bxcvx = 0
bxcvy = 0
bxcvz = 1/Rxy^2
# Explicit SI metric pairs for normalise_metric=true.
g11 = (Rxy*Bpxy)^2
g22 = 1/hthe^2
g33 = Bxy^2/g11
g12 = 0
g13 = 0
g23 = 0
g_11 = 1/g11
g_22 = (Bxy*hthe/Bpxy)^2
g_33 = Rxy^2
g_12 = 0
g_13 = 0
g_23 = 0
J = hthe/Bpxy

[mesh:paralleltransform]
type = identity

[mesh:ddz]
first = FFT
fft_filter = 0

[solver]
type = cvode
nout = 200
output_step = 100
atol = 1e-10
rtol = 1e-5
max_timestep = 50
mxstep = 1e6

[hermes]
components = e, h+, evolve_vorticity_ion_energy, polarisation_drift, classical_diffusion
recalculate_metric = false
normalise_metric = true
Nnorm = 2e18
Bnorm = mesh:Bxy
Tnorm = 5

[classical_diffusion]
custom_D = 0.1 * hermes:Tnorm / hermes:Bnorm  # [m^2/s], 0.1 in normalised units
diagnose = false

[e]
type = quasineutral, evolve_pressure
charge = -1
AA = 1/1836
bndry_flux = false
poloidal_flows = false
thermal_conduction = false
density_floor = 1e-7
low_p_diffuse_perp = false
low_T_diffuse_perp = false
damp_p_nt = false
p_div_v = false
hyper_z = -1
evolve_log = false
diagnose = false

[h+]
type = evolve_density
charge = 1
AA = 1
bndry_flux = false
poloidal_flows = false
density_floor = 1e-7
low_n_diffuse = false
low_n_diffuse_perp = false
hyper_z = -1
evolve_log = false
diagnose = false

[Nh+]
function = 1
source = 0
bndry_all = neumann

[initial_profile]
# Fractions of Lrad, fixed across resolutions. The quintic taper has zero
# first and second derivatives at each end; both wall buffers are constant.
wall_buffer = 0.1
taper_width = 0.1
ramp = clamp((0.5-abs(x-0.5)-wall_buffer)/taper_width, 0, 1)
envelope = ramp^3*(10-15*ramp+6*ramp^2)

[Pe]
function = 1 + 0.1*initial_profile:envelope*sin(2*pi*x)*sin(2*pi*x-z)
source = 0
bndry_all = neumann

[Vort]
function = 0
bndry_all = neumann

[Eion]
function = 1.5*Pe:function
bndry_all = neumann

[evolve_vorticity_ion_energy]
average_atomic_mass = 1
poloidal_flows = false
viscosity = 1
radial_boundary = fixed
diagnose = false
density_floor = 1e-7
phi_atol = 1e-3
phi_rtol = 1e-5
vort_atol = 1e-10
phi_max_iterations = 400

[evolve_vorticity_ion_energy:laplacian]
type = cyclic

[polarisation_drift]
implementation = conservative
