# Turbulence simulation with ion and electron pressures

nout = 100
timestep = 1.0e1
wall_limit  = 24

MZ = 81

zperiod = 5

twistshift = true

[mesh]

file = "tokamak.nc"

extrapolate_y = false  # Can result in negative Jacobians in guard cells

[mesh:paralleltransform]
type = shifted

[solver]
cvode_precon_method = user
mxstep = 1e9
cvode_max_order = 3
diagnose = false
atol = 1e-10                        # 1e-8 maybe too big
rtol = 1e-5                         # don't touch
maxl = 50

[hermes]
components = (e, d+, sound_speed, vorticity,
              sheath_boundary, 
              braginskii_collisions, 
              braginskii_friction,
              braginskii_heat_exchange, 
              braginskii_thermal_force, 
              diamagnetic_drift, 
              classical_diffusion,
              braginskii_ion_viscosity, 
              braginskii_electron_viscosity, 
              polarisation_drift, 
              braginskii_conduction
              )

Nnorm = 1e19  # Reference density [m^-3]
Bnorm = 1   # Reference magnetic field [T]
Tnorm = 75   # Reference temperature [eV]

qe = 1.60218e-19
Mp = 1.67262e-27
Cs0 = sqrt(qe * Tnorm / Mp)
Omega_ci = qe * Bnorm / Mp
rho_s0 = Cs0 / Omega_ci
ly = 0.1

# normalise_metric = true

[polarisation_drift]
advection = false
diamagnetic_polarisation = true
average_atomic_mass = vorticity:average_atomic_mass

[braginskii_ion_viscosity]
perpendicular = false
diagnose = false
precondition = true

[braginskii_electron_viscosity]
precondition = true

[diamagnetic_drift]
diamag_form = x * (1 - x)  # 0 = gradient; 1 = divergence

[vorticity]

exb_advection_simplified = false
diamagnetic = true   # Include diamagnetic current?
diamagnetic_polarisation = true # Include diamagnetic drift in polarisation current?
average_atomic_mass = `d+`:AA   # Weighted average atomic mass, for polarisaion current
poloidal_flows = true  # Include poloidal ExB flow
split_n0 = false  # Split phi into n=0 and n!=0 components

vort_dissipation = false
phi_dissipation = true
phi_sheath_dissipation = true
damp_core_vorticity = true

phi_boundary_relax = true
phi_boundary_timescale = 1e-6

precondition_n0 = true

[sheath_boundary]

bohm_smoothing = 0.01

################################################################
# Electrons

[e]
# Evolve the electron density, parallel momentum, and fix Te
type = evolve_density, evolve_pressure, evolve_momentum, anomalous_diffusion

# These diffusivities can be ramped down/turned off as turbulence saturates
anomalous_D = 0.5
anomalous_chi = 2.5
anomalous_nu = 0.1

AA = 1 / 1836
charge = -1

poloidal_flows = true

diagnose = false
thermal_conduction = true
density_floor = 1.0e-4
low_n_diffuse_perp = true
precondition = true

[Ne]
bndry_all = neumann
bndry_sol = decaylength(hermes:ly / hermes:rho_s0)
bndry_pf = decaylength(hermes:ly / hermes:rho_s0)
neumann_boundary_average_z = true # Neumann average Z boundaries in X


function = 3.0 - 2.7*x + 1e-3*mixmode(x - z)

flux = 1.5e22 # /s

# sum( Se_src[x,y] * J*dx*dy*2pi )
# Note: Depends on source shape and mesh
shape_factor = 1.6717219823451932

source = flux * shape_factor * exp(-((x - 0.05)/0.05)^2)
source_only_in_core = true

[Pe]
bndry_all = neumann
neumann_boundary_average_z = true # Neumnn average Z boundaries in X
bndry_sol = decaylength(hermes:ly / hermes:rho_s0)
bndry_pf = decaylength(hermes:ly / hermes:rho_s0)

function = 3*(1.0 - 0.9*x)^2

heating = 300e3 # Power input per species [W]

Tsource = heating / (Ne:flux * 1.602e-19 * 1.5)

# sum( Pe_src[x,y] * J*dx*dy*2pi )
source = Ne:source * Tsource * 1.602e-19
source_only_in_core = true

# Post-process source:
# float((bd['Pe_src'][-1,:,:,0] * bd['J'] * bd['dx'] * bd['dy'] * 2 * 3.14159).sum())

################################################################
# Ions
[d+]
# Set ion density from quasineutrality, evolve parallel flow
type = quasineutral, evolve_pressure, evolve_momentum, anomalous_diffusion

AA = 2       # Atomic mass
charge = 1

poloidal_flows = true
thermal_conduction = true
precondition = true
low_n_diffuse_perp = true
density_floor = 1.0e-4

# These diffusivities can be ramped down/turned off as turbulence saturates
anomalous_D = 0.5
anomalous_chi = 2.5
anomalous_nu = 0.1

[Pd+]
bndry_all = neumann
neumann_boundary_average_z = true # Neumann average boundaries in X
bndry_sol = decaylength(hermes:ly / hermes:rho_s0)
bndry_pf = decaylength(hermes:ly / hermes:rho_s0)

function = 3*(1.0 - 0.9*x)^2

source = Pe:source
source_only_in_core = true

